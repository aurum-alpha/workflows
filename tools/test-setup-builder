#!/usr/bin/env bash
# Tests .github/actions/setup-builder/setup-builder, the builder decision every
# image job runs. The catalog's own CI never runs those jobs' build legs on the
# farm's environment, so this is where the script's decisions are held, each
# with a bound on how long it took. Needs bash, curl, openssl and python3; no
# Docker, because every case decides before a builder would be created. The
# farm itself is exercised by ci.yml's setup-builder-farm job.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
script="${root}/.github/actions/setup-builder/setup-builder"
work="$(mktemp -d)"
pids=()
cleanup() { for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done; rm -rf "$work"; }
trap cleanup EXIT

fails=0
pass() { echo "  ok  $1"; }
fail() { echo "FAIL  $1"; fails=$((fails + 1)); }

# run [VAR=value ...]: run the script for one simulated job with its own
# RUNNER_TEMP, GITHUB_OUTPUT and GITHUB_STEP_SUMMARY. Prints the job dir;
# the elapsed whole seconds are in <job>/seconds.
run() {
  local job; job="$(mktemp -d "${work}/job-XXXX")"
  mkdir -p "${job}/temp"
  : > "${job}/out"; : > "${job}/summary"
  local start; start=$(date +%s)
  env -i PATH="$PATH" HOME="$job" \
    RUNNER_TEMP="${job}/temp" GITHUB_OUTPUT="${job}/out" GITHUB_STEP_SUMMARY="${job}/summary" \
    SSL_CERT_FILE="${ca_file:-}" CURL_CA_BUNDLE="${ca_file:-}" \
    "$@" "$script" > "${job}/log" 2>&1
  echo $(( $(date +%s) - start )) > "${job}/seconds"
  echo "$job"
}

out() { sed -n "s/^$2=//p" "$1/out"; }
config_written() { [ -n "$(out "$1" buildkitd_config)" ] && [ -s "$(out "$1" buildkitd_config)" ]; }

# Dummy key material: the cases that reach the network fail before anything
# reads it.
certs="${work}/certs"
mkdir -p "$certs"
: > "${certs}/ca.pem"; : > "${certs}/client.pem"; : > "${certs}/client-key.pem"

# A closed local port: something that refuses at once.
closed_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')

# 1. A runner never given a farm: local, and nothing to warn about.
j="$(run)"
if [ "$(out "$j" mode)" = local ] && ! grep -q '::warning' "${j}/log" && [ "$(cat "${j}/seconds")" -le 1 ]; then
  pass "no GHR_BUILDKIT_ENDPOINT: local, no warning"; else fail "no endpoint"; cat "${j}/log" "${j}/out"; fi

# 2. A fork never reaches the farm, and is local by policy, so no warning.
j="$(run FORK=true GHR_BUILDKIT_ENDPOINT="tcp://127.0.0.1:${closed_port}" GHR_BUILDKIT_CERTS="$certs")"
if [ "$(out "$j" mode)" = local ] && grep -q 'fork' "${j}/out" && ! grep -q '::warning' "${j}/log"; then
  pass "fork: local, no warning"; else fail "fork"; cat "${j}/log" "${j}/out"; fi

# 3. Given a farm but no certificate to present within the wait: local, with
#    a warning, after the wait and not before.
j="$(run CERTS_WAIT=1 GHR_BUILDKIT_ENDPOINT="tcp://127.0.0.1:${closed_port}" GHR_BUILDKIT_CERTS="${work}/no-such-dir")"
if [ "$(out "$j" mode)" = local ] && grep -q '::warning' "${j}/log" && grep -q 'client certificate' "${j}/out" \
   && [ "$(cat "${j}/seconds")" -ge 1 ] && [ "$(cat "${j}/seconds")" -le 3 ]; then
  pass "certs missing: local, warning, after the wait"; else fail "certs missing"; cat "${j}/log" "${j}/out"; fi

# 3b. The controller withheld the key (a public repository's job): local at
#     once, with a notice naming why and no warning.
denied="${work}/denied"; mkdir -p "$denied"; echo "public repository" > "${denied}/denied"
j="$(run GHR_BUILDKIT_ENDPOINT="tcp://127.0.0.1:${closed_port}" GHR_BUILDKIT_CERTS="$denied")"
if [ "$(out "$j" mode)" = local ] && grep -q 'withheld: public repository' "${j}/out" \
   && grep -q '::notice' "${j}/log" && ! grep -q '::warning' "${j}/log" && [ "$(cat "${j}/seconds")" -le 1 ]; then
  pass "key withheld: local, notice, no wait"; else fail "key withheld"; cat "${j}/log" "${j}/out"; fi

# 3c. The key lands after the step has started: the step waits for it and
#     goes on to the farm, here a closed port, which is a connection reason
#     and not a missing certificate.
late="${work}/late"; mkdir -p "$late"
( sleep 1; : > "${late}/ca.pem"; : > "${late}/client.pem"; : > "${late}/client-key.pem" ) &
j="$(run CERTS_WAIT=5 GHR_BUILDKIT_ENDPOINT="tcp://127.0.0.1:${closed_port}" GHR_BUILDKIT_CERTS="$late")"
wait
if [ "$(out "$j" mode)" = local ] && grep -q 'did not accept a connection' "${j}/out" && ! grep -q 'client certificate' "${j}/out"; then
  pass "key arrives late: waited for it"; else fail "key arrives late"; cat "${j}/log" "${j}/out"; fi

# 4. A black-holed farm (TEST-NET-1 never routes): local within the 3s TCP
#    gate, never the remote driver's own long dial.
j="$(run GHR_BUILDKIT_ENDPOINT="tcp://192.0.2.1:1234" GHR_BUILDKIT_CERTS="$certs")"
if [ "$(out "$j" mode)" = local ] && grep -q '::warning' "${j}/log" && [ "$(cat "${j}/seconds")" -lt 5 ]; then
  pass "black-holed farm: local in $(cat "${j}/seconds")s, warning"; else fail "black-holed farm ($(cat "${j}/seconds")s)"; cat "${j}/log" "${j}/out"; fi

# 4b. A runner image carrying buildx's default config can never create a
#     remote builder, so it is local with the file named, before any dial.
mkdir -p "${work}/buildx-with-default"; : > "${work}/buildx-with-default/buildkitd.default.toml"
j="$(run GHR_BUILDKIT_ENDPOINT="tcp://192.0.2.1:1234" GHR_BUILDKIT_CERTS="$certs" BUILDX_CONFIG="${work}/buildx-with-default")"
if [ "$(out "$j" mode)" = local ] && grep -q 'buildkitd.default.toml' "${j}/out" && grep -q '::warning' "${j}/log" \
   && [ "$(cat "${j}/seconds")" -le 1 ]; then
  pass "buildkitd.default.toml present: local, file named"; else fail "default config"; cat "${j}/log" "${j}/out"; fi

# 5. A cache that refuses: no mirrors.
j="$(run GHR_REGISTRY_CACHE="https://127.0.0.1:${closed_port}")"
if [ "$(out "$j" mirrors)" = false ] && ! config_written "$j" && [ "$(cat "${j}/seconds")" -le 3 ]; then
  pass "cache refusing: no mirrors"; else fail "cache refusing"; cat "${j}/log" "${j}/out"; fi

# A cache that answers /healthz, over https and over plain http.
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=127.0.0.1 \
  -addext "subjectAltName=IP:127.0.0.1" \
  -keyout "${work}/cache-key.pem" -out "${work}/cache.pem" >/dev/null 2>&1
cat > "${work}/cache.py" <<'EOF'
import http.server, ssl, sys
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200 if self.path == "/healthz" else 404); self.end_headers()
    def log_message(self, *a): pass
srv = http.server.HTTPServer(("127.0.0.1", 0), H)
if sys.argv[1] == "https":
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.load_cert_chain(sys.argv[2], sys.argv[3])
    srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
print(srv.server_address[1], flush=True)
srv.serve_forever()
EOF
# Started in this shell rather than in a $(...) subshell, so the trap knows
# their pids; each server's stderr goes to a file so it holds no pipe of the
# caller's open.
start_cache() {
  python3 "${work}/cache.py" "$1" "${work}/cache.pem" "${work}/cache-key.pem" \
    > "${work}/$1.port" 2> "${work}/$1.err" < /dev/null &
  pids+=("$!")
  for _ in $(seq 50); do [ -s "${work}/$1.port" ] && break; sleep 0.1; done
}
start_cache https; https_port="$(cat "${work}/https.port")"
start_cache http; http_port="$(cat "${work}/http.port")"

# 6. A healthy https cache: exactly the four mirrors, on the cache's layout.
ca_file="${work}/cache.pem"
j="$(run GHR_REGISTRY_CACHE="https://127.0.0.1:${https_port}")"
cfg="$(out "$j" buildkitd_config)"
expect="$(printf '%s\n' \
  '[registry."docker.io"]' "  mirrors = [\"127.0.0.1:${https_port}\"]" \
  '[registry."ghcr.io"]' "  mirrors = [\"127.0.0.1:${https_port}/ghcr\"]" \
  '[registry."quay.io"]' "  mirrors = [\"127.0.0.1:${https_port}/quay\"]" \
  '[registry."mcr.microsoft.com"]' "  mirrors = [\"127.0.0.1:${https_port}/mcr\"]")"
if [ "$(out "$j" mirrors)" = true ] && config_written "$j" && [ "$(grep -v '^#' "$cfg")" = "$expect" ]; then
  pass "healthy cache: the four mirrors"; else fail "healthy cache"; cat "${j}/log" "${j}/out" "$cfg" 2>/dev/null; fi

# 7. A trailing slash is the same cache.
j="$(run GHR_REGISTRY_CACHE="https://127.0.0.1:${https_port}/")"
if [ "$(out "$j" mirrors)" = true ] && grep -qF "\"127.0.0.1:${https_port}/ghcr\"" "$(out "$j" buildkitd_config)"; then
  pass "trailing slash: same mirrors"; else fail "trailing slash"; cat "${j}/log" "${j}/out"; fi
unset ca_file

# 8. Anything but https://<host> means no mirrors, even with a cache answering
#    on that address: plain http, a bare host, and a URL with a path.
for v in "http://127.0.0.1:${http_port}" "127.0.0.1:${http_port}" "https://127.0.0.1:${https_port}/zot"; do
  j="$(run GHR_REGISTRY_CACHE="$v")"
  if [ "$(out "$j" mirrors)" = false ] && ! config_written "$j"; then
    pass "'${v}': no mirrors"; else fail "'${v}' turned mirrors on"; cat "${j}/log" "${j}/out"; fi
done

# 9. An input overrides the environment.
j="$(run GHR_REGISTRY_CACHE="https://127.0.0.1:${closed_port}" REGISTRY_CACHE="")"
k="$(run GHR_BUILDKIT_ENDPOINT="tcp://192.0.2.1:1234" ENDPOINT="" FORK=true)"
if [ "$(out "$j" mirrors)" = false ] && [ "$(out "$k" endpoint)" = "tcp://192.0.2.1:1234" ]; then
  pass "empty inputs fall back to the environment"; else fail "fallback"; fi

# 10. The script never fails the job.
if bash -c "env -i PATH=\"$PATH\" GITHUB_OUTPUT=/dev/null GITHUB_STEP_SUMMARY=/dev/null GHR_BUILDKIT_ENDPOINT=tcp://192.0.2.1:1 GHR_BUILDKIT_CERTS=$certs \"$script\" >/dev/null 2>&1"; then
  pass "exit 0 when the farm is unusable"; else fail "non-zero exit"; fi

# 11. Asking the controller for the key (gha-runner-controller#657, #668). A
#     fake Actions runtime mints an ID token for the job's bearer, and a fake
#     controller answers each request key its own way. Both record what they
#     were sent.
cat > "${work}/controller.py" <<'EOF2'
import http.server, json, sys, time
PEM = "-----BEGIN %s-----\nAAAA\n-----END %s-----\n"
TOKEN = "aaaa.bbbb.cccc"
class H(http.server.BaseHTTPRequestHandler):
    def record(self, body=b""):
        with open(sys.argv[1], "a") as f:
            f.write(self.command + " " + self.path + " " + self.headers.get("Authorization", "")
                    + " " + body.decode() + "\n")
    def answer(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data)
    # The Actions runtime's ID token endpoint.
    def do_GET(self):
        self.record()
        if self.headers.get("Authorization") != "Bearer runtime-token":
            return self.answer(401, {"message": "bad runtime token"})
        self.answer(200, {"count": 1, "value": TOKEN})
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        self.record(body)
        key = self.headers.get("Authorization", "").removeprefix("Bearer ")
        if key == "slow":
            time.sleep(4)
        if json.loads(body or b"{}").get("token") != TOKEN:
            return self.answer(400, {"error": 'the body must be {"token":"<GitHub Actions ID token>"}'})
        code, obj = {
            "given": (200, {"ca_pem": PEM % ("CERTIFICATE", "CERTIFICATE"),
                            "client_cert_pem": PEM % ("CERTIFICATE", "CERTIFICATE"),
                            "client_key_pem": PEM % ("PRIVATE KEY", "PRIVATE KEY")}),
            "refused": (403, {"error": "o/site is a public repository"}),
            "down": (503, {"error": "GitHub's signing keys are out of reach"}),
        }.get(key, (401, {"error": "no runner holds this request key"}))
        self.answer(code, obj)
    def log_message(self, *a): pass
srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
print(srv.server_address[1], flush=True)
srv.serve_forever()
EOF2
python3 "${work}/controller.py" "${work}/controller.log" > "${work}/controller.port" 2> "${work}/controller.err" < /dev/null &
pids+=("$!")
for _ in $(seq 50); do [ -s "${work}/controller.port" ] && break; sleep 0.1; done
ctl="http://127.0.0.1:$(cat "${work}/controller.port")"
token="aaaa.bbbb.cccc"
audience="gha-runner-controller/buildkit-client-key"
ask() { run CERTS_WAIT=2 GHR_BUILDKIT_ENDPOINT="tcp://127.0.0.1:${closed_port}" \
  GHR_BUILDKIT_CERTS="${work}/never-filled" GHR_BUILDKIT_REQUEST_URL="$ctl" \
  GHR_BUILDKIT_TOKEN_AUDIENCE="$audience" \
  ACTIONS_ID_TOKEN_REQUEST_URL="${ctl}/token?api-version=2.0" ACTIONS_ID_TOKEN_REQUEST_TOKEN=runtime-token "$@"; }
mode_of() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
posted() { grep -c '^POST ' "${work}/controller.log" || true; }

# 11a. Given: the job mints its ID token for the runner's audience and posts
#      it with the request key as the bearer. The key is written to this
#      job's own directory, which the step hands on, and the step goes on to
#      the farm at once. The token is masked, and no secret is left on disk.
: > "${work}/controller.log"
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given)"
d="$(out "$j" certs)"
if grep -q 'did not accept a connection' "${j}/out" && [ "$d" = "${j}/temp/setup-builder-certs" ] \
   && grep -q 'BEGIN PRIVATE KEY' "${d}/client-key.pem" && grep -q 'BEGIN CERTIFICATE' "${d}/ca.pem" \
   && [ "$(mode_of "${d}/client-key.pem")" = 600 ] && grep -q 'given by the controller' "${j}/summary" \
   && [ "$(cat "${j}/seconds")" -le 1 ] \
   && grep -qxF "GET /token?api-version=2.0&audience=gha-runner-controller%2Fbuildkit-client-key Bearer runtime-token " "${work}/controller.log" \
   && grep -qxF "POST /api/v1/buildkit/client-key Bearer given {\"token\":\"${token}\"}" "${work}/controller.log" \
   && grep -qxF "::add-mask::${token}" "${j}/log" && [ "$(grep -c "$token" "${j}/log")" = 1 ] \
   && ! grep -q "$token" "${j}/summary" "${j}/out" \
   && [ "$(ls "${j}/temp")" = setup-builder-certs ]; then
  pass "asked with an ID token and given: key in the job's own dir, no wait"; else fail "asked and given"; cat "${j}/log" "${j}/out" "${j}/summary" "${work}/controller.log"; ls "${j}/temp"; fi

# 11b. Refused: the controller's reason goes in the summary, and the step
#      waits for the files it pushes on job-started, here `denied`.
pushed="${work}/pushed-denied"; mkdir -p "$pushed"
( sleep 1; echo "o/site is a public repository" > "${pushed}/denied" ) &
pusher=$!
j="$(ask GHR_BUILDKIT_REQUEST_KEY=refused GHR_BUILDKIT_CERTS="$pushed")"
wait "$pusher"
if [ "$(out "$j" mode)" = local ] && grep -q 'withheld: o/site is a public repository' "${j}/out" \
   && grep -q 'client key: the controller answered 403: o/site is a public repository; then the controller pushed its answer' "${j}/summary" \
   && grep -q '::notice' "${j}/log" && ! grep -q '::warning' "${j}/log" && [ "$(cat "${j}/seconds")" -le 2 ]; then
  pass "asked and refused: waits for the push, reason in the summary"; else fail "asked and refused"; cat "${j}/log" "${j}/out" "${j}/summary"; fi

# 11c. An unknown key, or a farm that is down: the controller's word is in the
#      summary, and the step still waits for the files, within the one wait.
for k in stale:'answered 401: no runner holds this request key' down:"answered 503: GitHub's signing keys are out of reach"; do
  j="$(ask GHR_BUILDKIT_REQUEST_KEY="${k%%:*}")"
  if [ "$(out "$j" mode)" = local ] && grep -q 'client certificate' "${j}/out" \
     && grep -qF "${k#*:}" "${j}/summary" && [ "$(cat "${j}/seconds")" -le 3 ]; then
    pass "asked, ${k%%:*}: falls back to waiting"; else fail "asked, ${k%%:*}"; cat "${j}/log" "${j}/out" "${j}/summary"; fi
done

# 11d. Nobody answers where the runner was told to ask: the same fallback.
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given GHR_BUILDKIT_REQUEST_URL="http://127.0.0.1:${closed_port}")"
if [ "$(out "$j" mode)" = local ] && grep -q 'did not answer' "${j}/summary" && grep -q 'client certificate' "${j}/out"; then
  pass "controller unreachable: falls back to waiting"; else fail "controller unreachable"; cat "${j}/log" "${j}/out" "${j}/summary"; fi

# 11e. A controller that does not answer in time is given up on after
#      KEY_REQUEST_TIMEOUT, and the pushed key is still used when it lands.
late2="${work}/late2"; mkdir -p "$late2"
( sleep 2; : > "${late2}/ca.pem"; : > "${late2}/client.pem"; : > "${late2}/client-key.pem" ) &
pusher=$!
j="$(ask GHR_BUILDKIT_REQUEST_KEY=slow KEY_REQUEST_TIMEOUT=1 CERTS_WAIT=5 GHR_BUILDKIT_CERTS="$late2")"
wait "$pusher"
if grep -q 'did not answer (1s allowed); then the controller pushed its answer' "${j}/summary" \
   && grep -q 'did not accept a connection' "${j}/out" && [ "$(out "$j" certs)" = "$late2" ] \
   && [ "$(cat "${j}/seconds")" -le 3 ]; then
  pass "controller slow: gives up at the timeout, uses the push"; else fail "controller slow"; cat "${j}/log" "${j}/out" "${j}/summary"; fi

# 11f. The files the controller pushed win: nothing is asked or minted.
: > "${work}/controller.log"
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given GHR_BUILDKIT_CERTS="$certs")"
if [ ! -s "${work}/controller.log" ] && [ "$(out "$j" certs)" = "$certs" ]; then
  pass "files already there: nothing asked"; else fail "asked anyway"; cat "${work}/controller.log"; fi

# 11g. A job that cannot mint an ID token (no id-token: write) asks nothing,
#      says why, and waits for the files.
: > "${work}/controller.log"
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given ACTIONS_ID_TOKEN_REQUEST_URL= ACTIONS_ID_TOKEN_REQUEST_TOKEN=)"
if [ ! -s "${work}/controller.log" ] && grep -q 'client key: not asked: .*id-token: write' "${j}/summary" \
   && grep -q 'client certificate' "${j}/out"; then
  pass "no ID token to mint: nothing asked, waits"; else fail "no ID token"; cat "${j}/summary" "${work}/controller.log"; fi

# 11h. GitHub's token service refuses: nothing is posted, the answer is in
#      the summary, and the step waits.
: > "${work}/controller.log"
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given ACTIONS_ID_TOKEN_REQUEST_TOKEN=wrong)"
if [ "$(posted)" = 0 ] && grep -q 'not asked: GitHub.s ID token service answered 401' "${j}/summary" \
   && grep -q 'client certificate' "${j}/out"; then
  pass "token service refuses: nothing posted, waits"; else fail "token service refuses"; cat "${j}/summary" "${work}/controller.log"; fi

# 11i. A runner given no audience (a controller from before #668) is never
#      asked: its endpoint takes no token.
: > "${work}/controller.log"
j="$(ask GHR_BUILDKIT_REQUEST_KEY=given GHR_BUILDKIT_TOKEN_AUDIENCE=)"
if [ ! -s "${work}/controller.log" ] && grep -q 'not asked: .*GHR_BUILDKIT_TOKEN_AUDIENCE' "${j}/summary"; then
  pass "no audience: nothing asked"; else fail "no audience"; cat "${j}/summary" "${work}/controller.log"; fi

if [ "$fails" -gt 0 ]; then
  echo "${fails} case(s) failed"
  exit 1
fi
echo "all cases passed"
