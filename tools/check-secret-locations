#!/usr/bin/env python3
"""Assert no secret value sits where 032-secrets.md forbids one, by name and by place.

A secret scanner has two halves, and this is the one that needs no opinion
about what a secret looks like. gitleaks decides by shape and by entropy:
known credential formats, long strings that look like nothing, in every
commit of the history. It passes `SMTP_PASSWORD=hunter2` in a committed
`.env.example`, because `hunter2` looks like nothing. 032 SE4 says the line is
a finding anyway: the variable is a secret by its NAME (SE3's closed kind
suffix) and the value is not a placeholder. That is a grammar, and a grammar is
checked by reading the name and the place rather than by guessing at the value.
`contracts/secrets/corpus.json` records that line as a verified detector.

What it judges, over the files git tracks:

  env-file-tracked        `.env` and `.env.*` are ignored by name, `.env.example`
                          excepted. A tracked one is a leak by construction,
                          whatever it holds (SE4).
  env-example-value       In `.env.example`, a variable whose name carries a
                          secret kind holds a placeholder: empty, `<a
                          description>`, or a URL whose password component is
                          one. A `_URL`/`_DSN` with no credential in it carries
                          no secret. A `*_FILE` kind carries a path (SE4, SE9).
  dockerfile-env-secret   `ENV` naming a secret kind with a literal value puts
                          the value in a layer: leaked (SE5).
  dockerfile-arg-secret   `ARG` naming a secret kind, or `ENV` passing one
                          through, records it in the image history: fix, the
                          secret reaches the process at start (SE1, SE5).
  compose-credential      In a compose file, a `_URL`/`_DSN` whose password is
                          set names a host. A host the compose project starts
                          (a service here or in an `include:`d file, or the
                          developer's own machine) is SE9's development
                          credential. Any other host is a shared backing service
                          with its credential committed (SE9). A bare literal in
                          a compose file is the form SE9 admits, and gitleaks
                          still judges it by shape.
  allow-list-not-admitted A `.gitleaks.toml`, a `.gitleaksignore` or an
                          inline allow marker (`allow` after `gitleaks:`) in
                          a file that is not documentation. SE4 admits
                          one allow-list reason, SE9's, and the catalog's own
                          config carries it; a repository-side exemption is a
                          gate silenced where nobody reviews it.

Two modes prove the tool itself. `--corpus FILE` materialises every case of the
corpus's `forbidden_locations` part into a throwaway git repository, judges it
with these checks AND with gitleaks (the `source` and `history` cases are
gitleaks's to catch), and compares the verdict with the case's own. A case that
cannot be judged is a failure, never a silent pass. `--self-test` covers the
grammar decisions the corpus does not reach: a URL without a credential, a
`*_FILE` kind, compose interpolation, a compose tag PyYAML does not know, and
the three repository-side exemptions.

Nothing here prints a value. A finding names a path, a line and a variable.

Usage:
  tools/check-secret-locations --repo-root DIR [--changed-only BASE]
  tools/check-secret-locations --corpus contracts/secrets/corpus.json [--gitleaks PATH] [--gitleaks-config FILE]
  tools/check-secret-locations --self-test
Exit: 0 clean, 1 findings (or a failed proof), 2 could not ask
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from urllib.parse import urlsplit

import yaml

KINDS = (
    "PASSWORD", "SECRET", "TOKEN", "TOKEN_FILE", "API_KEY", "URL", "DSN",
    "SIGNING_KEY", "ENCRYPTION_KEY", "PRIVATE_KEY_FILE",
)
# SE3's grammar, kind suffix only. The environment-prefix refusal in the
# schema's secretName pattern is a naming finding, not a reason to stop
# treating PROD_DATABASE_URL as a secret.
SECRET_NAME = re.compile(r"^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*_(" + "|".join(KINDS) + r")$")
URL_KINDS = {"URL", "DSN"}
FILE_KINDS = {"TOKEN_FILE", "PRIVATE_KEY_FILE"}
PLACEHOLDER = re.compile(r"^<[^<>]+>$")
INTERPOLATION = re.compile(r"\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*")
LOCAL_HOSTS = {"localhost", "127.0.0.1", "::1", "host.docker.internal"}
ENV_EXAMPLE = ".env.example"
DOCKERFILE = re.compile(r"^(Dockerfile(\..+)?|.+\.[Dd]ockerfile)$")
COMPOSE = re.compile(r"^((docker-)?compose(\.[^/]+)?|[^/]+\.compose)\.ya?ml$")
ALLOWLIST_FILES = (".gitleaks.toml", ".gitleaksignore")
# Joined at import so this file does not carry the marker it reports.
ALLOW_MARKER = b"gitleaks:" + b"allow"
DOCUMENTATION = (".md",)
TEXT_PROBE = 8192
MARKER_SIZE_CAP = 2 * 1024 * 1024
LEAKED, FIX = "leaked", "fix"
GITLEAKS_LEAKS_FOUND = 1


@dataclass
class Finding:
    path: str
    line: int | None
    check: str
    message: str
    response: str

    def render(self) -> str:
        where = f"{self.path}:{self.line}" if self.line else self.path
        return f"fail  {where}  {self.check}: {self.message} [{self.response}]"


# --- the tolerant YAML loader ---------------------------------------------

class ComposeLoader(yaml.SafeLoader):
    """SafeLoader that keeps a compose file's local tags (`!override`, `!reset`).

    PyYAML refuses a tag it has no constructor for. Compose's merge tags are
    data to this checker, so each resolves to the node under it.
    """


def _any_local_tag(loader, _suffix, node):
    if isinstance(node, yaml.ScalarNode):
        return loader.construct_scalar(node)
    if isinstance(node, yaml.SequenceNode):
        return loader.construct_sequence(node)
    return loader.construct_mapping(node)


ComposeLoader.add_multi_constructor("!", _any_local_tag)


# --- the grammar ------------------------------------------------------------

def kind_of(name: str) -> str | None:
    m = SECRET_NAME.match(name)
    return m.group(1) if m else None


def unquote(value: str) -> str:
    v = value.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def is_interpolation(value: str) -> bool:
    return bool(INTERPOLATION.search(value))


def credential_host(value: str) -> tuple[str | None, str | None] | None:
    """(host, password) for a URL value, None for a value that is not a URL."""
    try:
        u = urlsplit(value)
    except ValueError:
        return None
    if not u.scheme or not u.netloc:
        return None
    try:
        return u.hostname, u.password
    except ValueError:
        return None


def judge_value(kind: str, value: str) -> str | None:
    """None where the value carries no secret, else the response SE4 calls for."""
    v = unquote(value)
    if v == "" or PLACEHOLDER.match(v) or is_interpolation(v):
        return None
    if kind in FILE_KINDS:
        return None
    if kind in URL_KINDS:
        parsed = credential_host(v)
        if parsed is not None:
            _host, password = parsed
            if not password or PLACEHOLDER.match(password):
                return None
        return LEAKED
    return LEAKED


# --- the repository ---------------------------------------------------------

def tracked_files(root: pathlib.Path) -> list[str]:
    r = subprocess.run(["git", "-C", str(root), "ls-files", "-z"],
                       capture_output=True, check=False)
    if r.returncode != 0:
        raise RuntimeError(f"git ls-files failed under {root}: {r.stderr.decode().strip()}")
    return [p for p in r.stdout.decode().split("\0") if p]


def changed_files(root: pathlib.Path, base: str) -> set[str]:
    r = subprocess.run(["git", "-C", str(root), "diff", "--name-only",
                        "--diff-filter=ACMR", f"{base}...HEAD"],
                       capture_output=True, text=True, check=False)
    if r.returncode != 0:
        raise RuntimeError(f"git diff {base}...HEAD failed: {r.stderr.strip()}")
    return {p for p in r.stdout.split("\n") if p}


def read_lines(path: pathlib.Path) -> list[str]:
    return path.read_text(encoding="utf-8", errors="replace").splitlines()


def check_tracked_env(paths: list[str]) -> list[Finding]:
    out = []
    for p in paths:
        base = os.path.basename(p)
        if base == ".env" or (base.startswith(".env.") and base != ENV_EXAMPLE):
            out.append(Finding(p, None, "env-file-tracked",
                               f"{base} is ignored by name, and a tracked one is a leak "
                               "by construction whatever it holds (032 SE4)", LEAKED))
    return out


ENV_LINE = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")


def check_env_example(root: pathlib.Path, paths: list[str]) -> list[Finding]:
    out = []
    for p in paths:
        if os.path.basename(p) != ENV_EXAMPLE:
            continue
        for n, raw in enumerate(read_lines(root / p), start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            m = ENV_LINE.match(line)
            if not m:
                continue
            name, value = m.group(1), m.group(2)
            kind = kind_of(name)
            if not kind:
                continue
            if not (value.strip().startswith(("'", '"'))) and " #" in value:
                value = value.split(" #", 1)[0]
            verdict = judge_value(kind, value)
            if verdict:
                out.append(Finding(p, n, "env-example-value",
                                   f"{name} holds a value; .env.example carries names and "
                                   "placeholders only (032 SE4)", verdict))
    return out


def dockerfile_instructions(lines: list[str]):
    """(line number, instruction, argument text) with continuations joined."""
    buf, start = [], 0
    for n, raw in enumerate(lines, start=1):
        s = raw.rstrip()
        if not buf:
            if not s.strip() or s.lstrip().startswith("#"):
                continue
            start = n
        if s.endswith("\\"):
            buf.append(s[:-1])
            continue
        buf.append(s)
        text = " ".join(part.strip() for part in buf)
        buf = []
        parts = text.split(None, 1)
        if len(parts) == 2:
            yield start, parts[0].upper(), parts[1]
        elif parts:
            yield start, parts[0].upper(), ""


def env_pairs(argument: str) -> list[tuple[str, str]]:
    """Both ENV forms: `K=V K2=V2` and the legacy `K V`."""
    try:
        tokens = shlex.split(argument, posix=True)
    except ValueError:
        tokens = argument.split()
    if not tokens:
        return []
    if "=" in tokens[0]:
        pairs = []
        for t in tokens:
            if "=" in t:
                k, v = t.split("=", 1)
                pairs.append((k, v))
        return pairs
    return [(tokens[0], " ".join(tokens[1:]))]


def check_dockerfiles(root: pathlib.Path, paths: list[str]) -> list[Finding]:
    out = []
    for p in paths:
        if not DOCKERFILE.match(os.path.basename(p)):
            continue
        for n, instr, arg in dockerfile_instructions(read_lines(root / p)):
            if instr == "ARG":
                name = arg.split("=", 1)[0].strip()
                if kind_of(name):
                    out.append(Finding(p, n, "dockerfile-arg-secret",
                                       f"ARG {name} is recorded in the image history; a "
                                       "secret reaches the process at start, never at "
                                       "build (032 SE1, SE5)", FIX))
            elif instr == "ENV":
                for name, value in env_pairs(arg):
                    kind = kind_of(name)
                    if not kind:
                        continue
                    if is_interpolation(value):
                        out.append(Finding(p, n, "dockerfile-arg-secret",
                                           f"ENV {name} passes a build-time value into a "
                                           "layer (032 SE5)", FIX))
                        continue
                    verdict = judge_value(kind, value)
                    if verdict:
                        out.append(Finding(p, n, "dockerfile-env-secret",
                                           f"ENV {name} puts a value in a layer, in every "
                                           "registry and host that holds the image "
                                           "(032 SE5)", verdict))
    return out


def load_compose(path: pathlib.Path):
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        return yaml.load(fh, Loader=ComposeLoader)


def compose_hosts(root: pathlib.Path, rel: str, seen: set[str] | None = None) -> set[str]:
    """Every name the compose project answers to: services, container names,
    network aliases, across `include:`."""
    seen = seen if seen is not None else set()
    if rel in seen:
        return set()
    seen.add(rel)
    try:
        doc = load_compose(root / rel)
    except (OSError, yaml.YAMLError):
        return set()
    hosts: set[str] = set()
    services = (doc or {}).get("services") or {}
    if isinstance(services, dict):
        for name, svc in services.items():
            hosts.add(str(name))
            if isinstance(svc, dict):
                cn = svc.get("container_name")
                if isinstance(cn, str):
                    hosts.add(cn)
                nets = svc.get("networks")
                if isinstance(nets, dict):
                    for net in nets.values():
                        if isinstance(net, dict):
                            for alias in net.get("aliases") or []:
                                hosts.add(str(alias))
    for entry in (doc or {}).get("include") or []:
        targets = entry if isinstance(entry, str) else (entry or {}).get("path") if isinstance(entry, dict) else None
        if isinstance(targets, str):
            targets = [targets]
        for t in targets or []:
            inc = os.path.normpath(os.path.join(os.path.dirname(rel), str(t)))
            hosts |= compose_hosts(root, inc, seen)
    return hosts


def environment_items(env) -> list[tuple[str, str]]:
    pairs = []
    if isinstance(env, dict):
        for k, v in env.items():
            if v is None:
                continue
            pairs.append((str(k), str(v)))
    elif isinstance(env, list):
        for item in env:
            if isinstance(item, str) and "=" in item:
                k, v = item.split("=", 1)
                pairs.append((k, v))
    return pairs


def check_compose(root: pathlib.Path, paths: list[str]) -> list[Finding]:
    out = []
    for p in paths:
        if not COMPOSE.match(os.path.basename(p)):
            continue
        try:
            doc = load_compose(root / p)
        except yaml.YAMLError as e:
            out.append(Finding(p, None, "compose-unreadable",
                               f"could not be read as YAML ({type(e).__name__}); "
                               "nothing in it can be judged", FIX))
            continue
        services = (doc or {}).get("services") or {}
        if not isinstance(services, dict):
            continue
        hosts = compose_hosts(root, p) | LOCAL_HOSTS
        for sname, svc in services.items():
            if not isinstance(svc, dict):
                continue
            for name, value in environment_items(svc.get("environment")):
                kind = kind_of(name)
                if not kind or kind not in URL_KINDS:
                    continue
                v = unquote(value)
                if not v or is_interpolation(v) or PLACEHOLDER.match(v):
                    continue
                parsed = credential_host(v)
                if parsed is None:
                    continue
                host, password = parsed
                if not password or PLACEHOLDER.match(password):
                    continue
                if host in hosts:
                    continue
                out.append(Finding(p, None, "compose-credential",
                                   f"{name} on service {sname} carries a credential to "
                                   f"{host}, a host this compose project does not start "
                                   "(032 SE9)", LEAKED))
    return out


def check_allowlist_policy(root: pathlib.Path, paths: list[str]) -> list[Finding]:
    out = []
    for p in paths:
        base = os.path.basename(p)
        if base in ALLOWLIST_FILES:
            out.append(Finding(p, None, "allow-list-not-admitted",
                               f"{base} is a repository-side exemption; SE4 admits one "
                               "allow-list reason and the catalog's config carries it "
                               "(032 SE4, SE9)", FIX))
            continue
        # A document that names the marker is not using it, and the scan
        # ignores markers everywhere regardless (--ignore-gitleaks-allow).
        if p.endswith(DOCUMENTATION):
            continue
        full = root / p
        try:
            if full.stat().st_size > MARKER_SIZE_CAP or full.is_symlink():
                continue
            with full.open("rb") as fh:
                head = fh.read(TEXT_PROBE)
                if b"\0" in head:
                    continue
                data = head + fh.read()
        except OSError:
            continue
        if ALLOW_MARKER not in data:
            continue
        for n, line in enumerate(data.split(b"\n"), start=1):
            if ALLOW_MARKER in line:
                out.append(Finding(p, n, "allow-list-not-admitted",
                                   "an inline allow marker exempts a line where nobody "
                                   "reviews the reason (032 SE4)", FIX))
    return out


def judge_repository(root: pathlib.Path, only: set[str] | None = None) -> tuple[list[Finding], int]:
    paths = tracked_files(root)
    if only is not None:
        paths = [p for p in paths if p in only]
    findings: list[Finding] = []
    findings += check_tracked_env(paths)
    findings += check_env_example(root, paths)
    findings += check_dockerfiles(root, paths)
    findings += check_compose(root, paths)
    findings += check_allowlist_policy(root, paths)
    return findings, len(paths)


# --- gitleaks, the other half ----------------------------------------------

def run_gitleaks(binary: str, repo: pathlib.Path, config: str | None,
                 log_opts: str | None = None) -> bool:
    """True when gitleaks reports a leak. Anything but a clean 0 or a leak 1 raises."""
    cmd = [binary, "git", str(repo), "--redact", "--no-banner", "--no-color",
           "--exit-code", str(GITLEAKS_LEAKS_FOUND)]
    if config:
        cmd += ["--config", config]
    if log_opts:
        cmd += ["--log-opts", log_opts]
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if r.returncode == 0:
        return False
    if r.returncode == GITLEAKS_LEAKS_FOUND:
        return True
    raise RuntimeError(f"gitleaks exited {r.returncode}: {(r.stderr or r.stdout).strip()[-600:]}")


# --- the corpus proof --------------------------------------------------------

LOCATION_PATH = {
    "dockerfile": "Dockerfile",
    "env_example": ENV_EXAMPLE,
    "source": "src/app.js",
    "compose": "docker-compose.yml",
}
HISTORY_LINE = re.compile(r"^commit\s+\S+:\s+(?P<path>\S+)\s+(?P<op>[+-])\s+(?P<text>.*)$")


def git(repo: pathlib.Path, *args: str) -> None:
    subprocess.run(["git", "-C", str(repo), *args], check=True,
                   capture_output=True,
                   env={**os.environ, "GIT_AUTHOR_NAME": "corpus", "GIT_AUTHOR_EMAIL": "corpus@example.invalid",
                        "GIT_COMMITTER_NAME": "corpus", "GIT_COMMITTER_EMAIL": "corpus@example.invalid"})


def write(repo: pathlib.Path, rel: str, text: str) -> None:
    dest = repo / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(text + ("\n" if text and not text.endswith("\n") else ""), encoding="utf-8")


def materialise(case: dict, repo: pathlib.Path) -> None:
    git(repo, "init", "-q")
    loc, content = case["location"], case["content"]
    if loc == "tracked_path":
        write(repo, content, "")
        git(repo, "add", "-A")
        git(repo, "commit", "-q", "--allow-empty", "-m", case["case"])
    elif loc == "history":
        steps = [HISTORY_LINE.match(line) for line in content.splitlines()]
        if not steps or any(s is None for s in steps):
            raise RuntimeError(f"{case['case']}: history content is not 'commit X: path +/- text' lines")
        for m in steps:
            if m.group("op") == "+":
                write(repo, m.group("path"), "{\n  " + m.group("text").strip() + "\n}")
            else:
                (repo / m.group("path")).unlink()
            git(repo, "add", "-A")
            git(repo, "commit", "-q", "--allow-empty", "-m", m.group("op"))
    else:
        write(repo, LOCATION_PATH[loc], content)
        git(repo, "add", "-A")
        git(repo, "commit", "-q", "--allow-empty", "-m", case["case"])


def strongest(responses: list[str]) -> str | None:
    if LEAKED in responses:
        return LEAKED
    if FIX in responses:
        return FIX
    return None


def prove_corpus(corpus_path: pathlib.Path, gitleaks: str | None, config: str | None) -> int:
    corpus = json.loads(corpus_path.read_text(encoding="utf-8"))
    cases = corpus.get("forbidden_locations")
    if not isinstance(cases, list) or not cases:
        print(f"FAIL: {corpus_path} carries no forbidden_locations part", file=sys.stderr)
        return 2
    failures = 0
    for case in cases:
        with tempfile.TemporaryDirectory(prefix="secret-locations-") as tmp:
            repo = pathlib.Path(tmp)
            materialise(case, repo)
            findings, _ = judge_repository(repo)
            responses = [f.response for f in findings]
            checks = sorted({f.check for f in findings})
            if gitleaks:
                if run_gitleaks(gitleaks, repo, config):
                    responses.append(LEAKED)
                    checks.append("gitleaks")
            elif case["location"] in ("source", "history"):
                print(f"fail  {case['case']}: needs gitleaks to judge a {case['location']} case, "
                      "and none was given")
                failures += 1
                continue
        got_finding = bool(responses)
        got_response = strongest(responses)
        want = case["expect"]
        ok = got_finding == bool(want.get("finding"))
        if ok and got_finding:
            ok = got_response == want.get("response")
        tag = " (detector)" if case.get("detector") else ""
        if ok:
            by = ", ".join(checks) if checks else "no finding"
            print(f"  ok   {case['case']}{tag}: {by}")
        else:
            failures += 1
            print(f"fail  {case['case']}{tag}: expected finding={want.get('finding')} "
                  f"response={want.get('response')}, got finding={got_finding} "
                  f"response={got_response} via {checks or 'nothing'}")
    n = len(cases)
    if failures:
        print(f"FAIL: {failures} of {n} forbidden_locations case(s) do not hold")
        return 1
    half = "with gitleaks" if gitleaks else "without gitleaks"
    print(f"ok  {n} forbidden_locations case(s) hold, {half}")
    return 0


