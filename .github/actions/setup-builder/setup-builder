#!/usr/bin/env bash
# Decides, at job start, whether this job builds on the shared build farm or
# on a local builder inside the runner's own dind, and writes the local
# builder's mirror config when the registry cache answers.
#
# Fail-open: any doubt means local, never a red build. Every input comes from
# the runner controller through the runner's environment, so a runner the
# controller did not set up for the farm is local without asking anything:
#
#   GHR_BUILDKIT_ENDPOINT    tcp://<farm>:<port>
#   GHR_BUILDKIT_SERVERNAME  the name the farm's certificate carries
#   GHR_BUILDKIT_CERTS       a directory the controller fills once the job has
#                            started: ca.pem client.pem client-key.pem for a
#                            private repository's job, or `denied` holding why
#                            this job gets no key (gha-runner-controller#620)
#   GHR_REGISTRY_CACHE       https://<host>, no path
#   GHR_BUILDKIT_REQUEST_URL where this job may ask the controller for its
#                            key instead of waiting for the files
#   GHR_BUILDKIT_REQUEST_KEY this runner's own key to ask with
#                            (gha-runner-controller#657)
#
# The action's inputs (ENDPOINT, SERVERNAME, CERTS, REGISTRY_CACHE) override
# them; an empty input falls back to the environment.
#
# tools/test-setup-builder runs this script under each combination, because
# the image jobs that run it never run in the catalog's own CI.
set -uo pipefail

ENDPOINT="${ENDPOINT:-${GHR_BUILDKIT_ENDPOINT:-}}"
SERVERNAME="${SERVERNAME:-${GHR_BUILDKIT_SERVERNAME:-}}"
CERTS="${CERTS:-${GHR_BUILDKIT_CERTS:-/etc/aj78/buildkit-client}}"
REGISTRY_CACHE="${REGISTRY_CACHE:-${GHR_REGISTRY_CACHE:-}}"
PLATFORMS="${PLATFORMS:-linux/amd64}"
FORK="${FORK:-false}"
PROBE_TIMEOUT="${PROBE_TIMEOUT:-8}"
CERTS_WAIT="${CERTS_WAIT:-75}"
GITHUB_OUTPUT="${GITHUB_OUTPUT:-/dev/stdout}"
GITHUB_STEP_SUMMARY="${GITHUB_STEP_SUMMARY:-/dev/stderr}"
RUNNER_TEMP="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
REQUEST_URL="${GHR_BUILDKIT_REQUEST_URL:-}"
REQUEST_KEY="${GHR_BUILDKIT_REQUEST_KEY:-}"
# The one wait for the key, shared by asking and by watching for the files.
key_deadline=$((SECONDS + CERTS_WAIT))
# What asking the controller came to, for the step summary. Empty when the
# runner was given nowhere to ask.
asked=""

# certs_arrived waits up to CERTS_WAIT seconds for the controller to fill
# CERTS: the three files, or `denied`. It does so when GitHub's job-started
# message reaches it, which can be most of a minute after the job began:
# one empty 50-second poll, then the message (gha-runner-controller#656).
# Waiting that out costs less than setting up a local builder.
certs_arrived() {
  local deadline=$key_deadline
  while :; do
    if [ -e "$CERTS/denied" ] || [ -e "$CERTS/client-key.pem" ]; then
      # The controller copies the files in one archive; give the last a
      # moment to land.
      sleep 0.2
      return 0
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 0.5
  done
}

# json_field NAME FILE prints one string field of the controller's flat JSON
# answer with its \n escapes undone. The PEMs and the reasons it sends hold
# no quote or other escape, and the runner image promises no jq.
json_field() {
  local v
  v=$(sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" | head -n 1)
  printf '%b' "$v"
}

# ask_for_key asks the controller for this job's key, when the runner was
# told where to ask, rather than waiting for GitHub's job-started message to
# reach it. Its answer goes into a directory of this job's own, which CERTS
# then names: the three files on 200, `denied` with the reason on 403. Any
# other answer leaves CERTS alone, and the wait for the files goes on.
ask_for_key() {
  [ -n "$REQUEST_URL" ] && [ -n "$REQUEST_KEY" ] || return 1
  # The controller already filled the directory: nothing to ask for.
  if [ -e "$CERTS/client-key.pem" ] || [ -e "$CERTS/denied" ]; then return 1; fi
  local dir="$RUNNER_TEMP/setup-builder-certs" body="$RUNNER_TEMP/setup-builder-key.json"
  local hdr="$RUNNER_TEMP/setup-builder-key.headers" code started=$SECONDS left
  rm -rf "$dir"
  (umask 077; mkdir -p "$dir"; printf 'Authorization: Bearer %s\n' "$REQUEST_KEY" > "$hdr")
  left=$((key_deadline - SECONDS)); [ "$left" -ge 1 ] || left=1
  # The bearer goes from a file, so no process listing shows it.
  code=$(curl -sS -o "$body" -w '%{http_code}' --connect-timeout 5 --max-time "$left" \
      -X POST -H "@$hdr" -H 'Content-Type: application/json' \
      --data "{\"repository\":\"${GITHUB_REPOSITORY:-}\",\"run_id\":${GITHUB_RUN_ID:-0}}" \
      "${REQUEST_URL%/}/api/v1/buildkit/client-key" 2>/dev/null) || code=000
  rm -f "$hdr"
  case "$code" in
    200)
      local f field
      for f in ca.pem:ca_pem client.pem:client_cert_pem client-key.pem:client_key_pem; do
        field="${f#*:}"; f="${f%%:*}"
        (umask 077; json_field "$field" "$body" > "$dir/$f")
        if ! grep -q -- '-----BEGIN ' "$dir/$f"; then
          rm -f "$body"; asked="the controller's answer carried no $field"; return 1
        fi
      done
      rm -f "$body"
      CERTS="$dir"; asked="given by the controller in $((SECONDS - started))s"
      return 0 ;;
    403)
      json_field error "$body" > "$dir/denied"; rm -f "$body"
      CERTS="$dir"; asked="refused by the controller"
      return 0 ;;
    000) asked="the controller at $REQUEST_URL did not answer" ;;
    *) asked="the controller answered $code: $(json_field error "$body")" ;;
  esac
  rm -f "$body"
  return 1
}

mode=local
# Set when a farm was expected and could not be used. A runner never given a
# farm is local by design and a fork by policy, so neither says anything.
# A platform the farm lacks is a notice rather than a warning: it is local by
# design too, and an arm64 leg would otherwise warn on every run.
level=""
if [ "$FORK" = true ]; then
  reason="pull request from a fork"
elif [ -z "$ENDPOINT" ]; then
  reason="this runner was not given a build farm (no GHR_BUILDKIT_ENDPOINT)"
elif ! { ask_for_key || certs_arrived; }; then
  reason="no readable client certificate in $CERTS after ${CERTS_WAIT}s"
  level=warning
elif [ -e "$CERTS/denied" ]; then
  # The controller withholds the key from a public repository's job, by
  # design, so this is a notice and not a warning.
  reason="build farm access withheld: $(head -n 1 "$CERTS/denied")"
  level=notice
elif [ ! -r "$CERTS/client-key.pem" ] || [ ! -r "$CERTS/client.pem" ] || [ ! -r "$CERTS/ca.pem" ]; then
  reason="no readable client certificate in $CERTS"
  level=warning
elif [ -e "${BUILDX_CONFIG:-${HOME:-}/.docker/buildx}/buildkitd.default.toml" ]; then
  # buildx loads this file into every builder it creates and refuses to
  # create a remote one while it exists ("setting config file is not
  # supported for remote driver"). A runner image from before the farm
  # carries it; gha-runner-controller#608 took it out.
  reason="this runner's image carries ~/.docker/buildx/buildkitd.default.toml, which buildx refuses for a remote builder"
  level=warning
else
  hostport="${ENDPOINT#tcp://}"; host="${hostport%:*}"; port="${hostport##*:}"
  [ -n "$SERVERNAME" ] || SERVERNAME="$host"
  if ! timeout 3 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
    # A cheap reachability gate. Without it a black-holed host costs about
    # 20s, because `buildx create --driver remote` dials the endpoint with
    # its own long timeout before the bootstrap check starts.
    reason="build farm $host:$port did not accept a connection within 3s"
    level=warning
  else
    probe="setup-builder-probe-$$"
    docker buildx rm "$probe" >/dev/null 2>&1 || true
    # buildx's own last line goes into the reason: a refusal here is a fact
    # about this runner that the summary should name, not a mystery.
    if ! err=$(timeout "$PROBE_TIMEOUT" docker buildx create --name "$probe" --driver remote \
         --driver-opt "cacert=$CERTS/ca.pem,cert=$CERTS/client.pem,key=$CERTS/client-key.pem,servername=$SERVERNAME" \
         "$ENDPOINT" 2>&1 >/dev/null); then
      reason="could not define a remote builder for $ENDPOINT: $(printf '%s\n' "$err" | tail -n 1)"
      level=warning
    elif ! info=$(timeout "$PROBE_TIMEOUT" docker buildx inspect --bootstrap "$probe" 2>/dev/null); then
      # --bootstrap dials the daemon and completes the mTLS handshake.
      reason="build farm refused this runner's client certificate or did not answer within ${PROBE_TIMEOUT}s"
      level=warning
    else
      # The farm builds only what its workers list; a platform it lacks would
      # need emulation it does not have.
      have=$(printf '%s\n' "$info" | sed -n 's/^Platforms:[[:space:]]*//p' | head -n 1 \
        | tr -d ' ' | tr ',' '\n' | sed 's/\*$//')
      missing=""
      IFS=, read -ra want <<< "$PLATFORMS"
      for p in "${want[@]}"; do
        p="${p// /}"; [ -n "$p" ] || continue
        printf '%s\n' "$have" | grep -qxF "$p" || missing="$missing $p"
      done
      if [ -n "$missing" ]; then
        reason="build farm has no worker for:${missing}"
        level=notice
      else
        mode=remote reason="build farm at $host:$port"
      fi
    fi
    docker buildx rm "$probe" >/dev/null 2>&1 || true
  fi
fi

# A local builder pulls base images through the registry cache only while it
# answers: a dead cache host would otherwise cost a connect timeout per fetch
# before BuildKit falls through to the origin. Only https://<host> qualifies.
# BuildKit mirror entries carry no scheme and are https, and a bare host or an
# http URL would be checked over plain http, where a redirect passes curl -f
# and turns on mirrors nothing checked.
config=""
mirrors=false
if [ "$mode" = local ] && [[ "$REGISTRY_CACHE" =~ ^https://[^/]+/?$ ]] \
   && curl -fsS -o /dev/null --connect-timeout 2 --max-time 3 "${REGISTRY_CACHE%/}/healthz" 2>/dev/null; then
  cache_host="${REGISTRY_CACHE#https://}"; cache_host="${cache_host%/}"
  config="$RUNNER_TEMP/setup-builder-buildkitd.toml"
  # The namespaces are the cache's layout, the same ones the controller
  # writes into each dind's hosts.toml.
  cat > "$config" <<EOF
# Written by setup-builder: the registry cache answered /healthz at job start.
[registry."docker.io"]
  mirrors = ["$cache_host"]
[registry."ghcr.io"]
  mirrors = ["$cache_host/ghcr"]
[registry."quay.io"]
  mirrors = ["$cache_host/quay"]
[registry."mcr.microsoft.com"]
  mirrors = ["$cache_host/mcr"]
EOF
  mirrors=true
fi

{
  echo "mode=$mode"
  echo "reason=$reason"
  echo "mirrors=$mirrors"
  echo "buildkitd_config=$config"
  # What the probe verified, so the remote step is given exactly that.
  echo "endpoint=$ENDPOINT"
  echo "servername=$SERVERNAME"
  echo "certs=$CERTS"
} >> "$GITHUB_OUTPUT"
{
  echo "### Builder: \`$mode\`"
  echo "- $reason"
  if [ -n "$asked" ]; then
    echo "- client key: $asked"
  fi
  if [ "$mode" = local ]; then
    echo "- base images through the registry cache: $([ "$mirrors" = true ] && echo yes || echo no)"
  fi
} >> "$GITHUB_STEP_SUMMARY"
if [ -n "$level" ]; then
  echo "::${level} title=Build farm not used::${reason}; building locally on $(hostname)"
fi
exit 0
