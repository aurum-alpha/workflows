#!/usr/bin/env python3
"""Verify every Node app in the fleet pins the same toolchain versions.

The version each repo actually uses comes from package.json's packageManager
field — that is what corepack activates locally and what pnpm/action-setup
reads in the shared jobs, so CI and a developer's machine can never disagree
with each other. What that field cannot do is agree ACROSS repos: nothing stops
one repo drifting to a different pnpm. This check closes that gap by comparing
every repo against fleet-versions.json.

Run against local clones:  tools/check-fleet-versions --root /workspace
Run against one repo:      tools/check-fleet-versions --root DIR --repo NAME

The --repo form is what job-ci-conformance uses: a repo's own CI has only its
own clone, so a checker that can only run over all eleven at once is a checker
that only runs when someone remembers to run it from a workstation. Naming a
repo with no Node app is a pass, not an error, so every caller can wire this up
unconditionally without first knowing whether it is a Node repo.

It checks THREE things, for the same reason and against the same file:

  packageManager   one pnpm across the fleet
  devDependencies  one version of each converged build-time package
  dependencies     one version of each converged RUNTIME package

The second half exists because the first was the whole check while eight
packages were converged by hand across nine repos and NOTHING held them there.
aurum-alpha/workflows#169 moved @types/node and the eslint six to a single
exact version in every Node app; a week later any `pnpm up` in any repo could
have undone that silently, because the only thing that would have noticed was
somebody re-reading nine manifests. Convergence that is not asserted is a
snapshot, not a standard.

The two dependency blocks are separate rather than one merged lookup, and the
section a package sits in is part of what is asserted. For a year this checker
read devDependencies alone, which meant the fleet could converge on a runtime
package -- react, say -- and have no way to say so: react and react-dom are
`dependencies` in all nine Node apps, correctly, and were therefore invisible
here. Merging the two sections into one lookup would have fixed that and lost
something worth keeping, because placement is itself a real defect class. A
runtime package parked in devDependencies breaks `--prod` installs; a types
package parked in dependencies ships nothing but noise, and jewelry-factory
carried exactly that until aurum-alpha/jewelry-factory#52. A checker that
accepted either section would have called both of those fine.

Versions are compared EXACTLY. A caret or tilde fails: `^7.3.0` in two repos
can resolve to different versions on different days, so a range is not a pin
and cannot be a fleet standard. That is also why a package mid-wave is absent
from fleet-versions.json rather than listed with a target -- listing it would
fail every repo whose turn has not come, and a check that is expected to fail
is a check nobody reads.
"""

import argparse
import json
import pathlib
import sys

# Node apps in the fleet, as paths to the directory holding package.json
# relative to each repo root. Dual-stack repos keep their app in a subdirectory.
NODE_APPS = {
    "credit-watch": ".",
    "expense-splitter": ".",
    "flight-watch": ".",
    "hiring-tracker": ".",
    "jewelry-factory": ".",
    "wardley-mapper": ".",
    # client-manager and gofast moved web/ to client/ (F#3, F#23) and this map
    # was not updated with them, so the check reported "package.json not found"
    # for both — a FAIL that says the repo is missing a file rather than that
    # this list is stale. It went unnoticed because nothing ran the checker;
    # that is the gap issue #79 exists to close.
    "client-manager": "client",
    "gofast": "client",
    # event-manager declares packageManager and was simply never listed, so its
    # pnpm could have drifted from the fleet without anything saying so.
    "event-manager": ".",
}


def load_expected(
    repo_root: pathlib.Path,
) -> tuple[str, dict[str, str], dict[str, str]]:
    data = json.loads((repo_root / "fleet-versions.json").read_text())
    # Both dependency blocks are optional. This is defensive rather than a
    # rollout mechanism, and it is worth being exact about which: fleet-
    # versions.json is read from the checker's OWN repo root, so in CI both it
    # and this file come from the same .aurum-standard checkout pinned at
    # standard_ref. They move together, always. A new block therefore cannot
    # reach a caller ahead of the code that reads it, and the .get() defaults
    # buy compatibility only for someone running this checker against a
    # hand-assembled tree.
    return (
        data["pnpm"],
        data.get("devDependencies", {}),
        data.get("dependencies", {}),
    )


def check_section(
    repo: str,
    manifest: dict,
    want: dict[str, str],
    section: str,
    other: str,
) -> int:
    """Compare one manifest section against the fleet standard for it.

    `section` is where the packages must be declared; `other` is the sibling
    section, checked only so a misplaced package is reported as misplaced
    rather than as missing. "react is not declared" sends a reader looking for
    an absent package; "react is declared in devDependencies" sends them to
    the line that is actually wrong.
    """
    declared = manifest.get(section, {})
    sibling = manifest.get(other, {})
    failures = 0

    for name, version in sorted(want.items()):
        got = declared.get(name)
        if got is None:
            if name in sibling:
                print(
                    f"{repo}: {name} is declared in {other}, "
                    f"fleet standard has it in {section} at {version}"
                )
            else:
                # Absent is a failure, not a skip. Every package listed in
                # fleet-versions.json is one the whole fleet converged on, so a
                # Node app that has dropped one has drifted just as surely as
                # one carrying the wrong version.
                print(
                    f"{repo}: {name} is not declared in {section}, "
                    f"fleet standard is {version}"
                )
            failures += 1
        elif got != version:
            # Names the range case explicitly: "^10.9.1 is not 10.9.1" reads
            # like a checker being pedantic unless it says why.
            hint = " (a range, not a pin)" if got[:1] in "^~><=" else ""
            print(
                f"{repo}: {name} is {got}{hint} in {section}, "
                f"fleet standard is {version}"
            )
            failures += 1

    return failures


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    args = ap.parse_args()

    here = pathlib.Path(__file__).resolve().parent.parent
    expected, want_dev, want_deps = load_expected(here)
    want = f"pnpm@{expected}"

    if args.repo:
        # A named repo with no Node app has nothing to disagree about. Say so
        # and pass: the alternative is every non-Node caller needing an `if:`
        # around the check, which is how checks stop being run at all.
        selected = {r: NODE_APPS[r] for r in args.repo if r in NODE_APPS}
        for r in args.repo:
            if r not in NODE_APPS:
                print(f"{r}: no Node app in fleet-versions scope — nothing to check")
        if not selected:
            print("\nPASS: no Node app to check")
            return 0
    else:
        selected = NODE_APPS

    failures = 0
    for repo, subdir in sorted(selected.items()):
        pkg = args.root / repo / subdir / "package.json"
        if not pkg.exists():
            print(f"{repo}: package.json not found at {pkg}", file=sys.stderr)
            failures += 1
            continue

        manifest = json.loads(pkg.read_text())

        declared = manifest.get("packageManager")
        if declared is None:
            print(f"{repo}: no packageManager field — must declare {want}")
            failures += 1
        elif declared != want:
            print(f"{repo}: packageManager is {declared}, fleet standard is {want}")
            failures += 1
        else:
            print(f"{repo}: {declared}")

        failures += check_section(
            repo, manifest, want_dev, "devDependencies", "dependencies"
        )
        failures += check_section(
            repo, manifest, want_deps, "dependencies", "devDependencies"
        )

    if failures:
        print(
            f"\nFAIL: {failures} repo(s) disagree with fleet-versions.json. "
            "Either bring the repo to the fleet version, or bump "
            "fleet-versions.json and roll the whole fleet."
        )
        return 1

    print(
        f"\nPASS: all {len(selected)} Node app(s) pin {want}, "
        f"{len(want_dev)} converged devDependencies "
        f"and {len(want_deps)} converged dependencies"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
