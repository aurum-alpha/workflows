    { "id": "money-jpy-ok", "def": "money", "value": { "amount": 1999, "currency": "JPY" }, "valid": true, "note": "¥1999 — JPY minor-unit exponent is 0; the exponent is the currency's, never a universal 2 (IP5)" },
    { "id": "money-negative-ok", "def": "money", "value": { "amount": -500, "currency": "EUR" }, "valid": true, "note": "refunds and adjustments are negative amounts, not a second shape (IP5)" },
    { "id": "money-rejects-float", "def": "money", "value": { "amount": 19.99, "currency": "USD" }, "valid": false, "note": "floats are not admitted for money (IP5)" },
    { "id": "money-rejects-missing-currency", "def": "money", "value": { "amount": 1999 }, "valid": false, "note": "an amount without a currency is not an amount (IP5)" },
    { "id": "money-rejects-lowercase-currency", "def": "money", "value": { "amount": 1999, "currency": "usd" }, "valid": false, "note": "ISO 4217 codes are uppercase on the wire (IP5)" },
    { "id": "money-rejects-string-amount", "def": "money", "value": { "amount": "1999", "currency": "USD" }, "valid": false, "note": "amount is an integer, not a numeric string (IP5)" }
  ],
  "canonical": [
    { "id": "ts-normalise-offset", "kind": "timestamp", "input": "2026-08-31T16:07:02.417+02:00", "emit": "2026-08-31T14:07:02.417Z" },
