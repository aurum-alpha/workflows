import datetime as dt
import json
import os
import pathlib
import re
import sys
from dataclasses import dataclass, field

SKIP_DIRS = {"node_modules", "vendor", ".git", "dist", "coverage", ".aurum-catalog", ".ci-root"}

CHECK_INNER = ("subject", "scope", "activeGrant")

BILLING_FIXTURE = ("now", "catalog", "subscriptions", "ledger", "overrides")
BILLING_OPS = {
    "entitled": ("capability",),
    "quotaFor": ("metric",),
    "allowanceFor": ("metric",),
    "settingFor": ("setting",),
    "withinQuota": ("metric", "current"),
    "withinAllowance": ("metric", "used"),
    "entitlementsFor": (),
}
CATALOG_SCHEMA_ID = "https://contracts.aurumalpha.dev/billing/catalog.schema.json"
SUBSCRIPTION_SCHEMA_ID = "https://contracts.aurumalpha.dev/billing/subscription.schema.json"
ADMISSION_SCHEMA_ID = "https://contracts.aurumalpha.dev/json-document-storage/admission.schema.json"

PERMISSION = re.compile(r"^[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*$")
ACCESS_GRANTING = {"password", "api_key", "token", "connection_string"}
DURATION = re.compile(
    r"^P(?:(?P<y>\d+)Y)?(?:(?P<mo>\d+)M)?(?:(?P<w>\d+)W)?(?:(?P<d>\d+)D)?"
    r"(?:T(?:(?P<h>\d+)H)?(?:(?P<mi>\d+)M)?(?:(?P<s>\d+(?:\.\d+)?)S)?)?$"
)


def load_json(path: pathlib.Path) -> object:
    return json.loads(path.read_text(encoding="utf-8"))


def seconds(duration: object) -> float | None:
    """An ISO 8601 duration as seconds, with a month as 30 days and a year as
    365, which is enough to order the durations a declaration carries."""
    if not isinstance(duration, str):
        return None
    m = DURATION.match(duration)
    if not m or duration == "P":
        return None
    g = {k: float(v) for k, v in m.groupdict().items() if v is not None}
    return (
        g.get("y", 0) * 365 * 86400
        + g.get("mo", 0) * 30 * 86400
        + g.get("w", 0) * 7 * 86400
        + g.get("d", 0) * 86400
        + g.get("h", 0) * 3600
        + g.get("mi", 0) * 60
        + g.get("s", 0)
    )


def find_contracts(root: pathlib.Path, explicit: pathlib.Path | None) -> pathlib.Path | None:
    if explicit is not None:
        return explicit
    candidate = root / "contracts"
    if not candidate.is_dir():
        return None
    if any(candidate.glob("*/corpus.json")) or any(
        (candidate / rel).is_file() for rel in ("rbac/decisions.json", "billing/entitlements.json")
    ):
        return candidate
    return None


def registry_for(contracts: pathlib.Path):
    from referencing import Registry, Resource

    registry = Registry()
    schemas: dict[str, dict] = {}
    for schema_path in sorted(contracts.rglob("*.schema.json")):
        schema = load_json(schema_path)
        if not isinstance(schema, dict):
            continue
        sid = schema.get("$id")
        if isinstance(sid, str) and sid:
            registry = registry.with_resource(sid, Resource.from_contents(schema))
            schemas[sid] = schema
    return registry, schemas


def schema_errors(registry, ref: str, value) -> list[str]:
    """Validate `value` against a schema id, with an optional JSON pointer."""
    from jsonschema import Draft202012Validator

    try:
        validator = Draft202012Validator({"$ref": ref}, registry=registry)
        return [e.message for e in sorted(validator.iter_errors(value), key=lambda e: list(e.path))]
    except Exception as exc:  # noqa: BLE001 — report and continue
        return [f"schema {ref} could not be resolved ({exc})"]


# ---------------------------------------------------------------------------
# Runner checks. Each takes the context, the case and the instance and returns
# the reasons it rejects the instance, or []. A check that has an expectation
# of its own beside the verdict (the calendar findings) reports through
# ctx.direct().


@dataclass
class Context:
    contracts: pathlib.Path
    registry: object
    schemas: dict
    capability: str
    part: str
    corpus: dict
    findings: list[str] = field(default_factory=list)
    cache: dict = field(default_factory=dict)

    def direct(self, message: str) -> None:
        self.findings.append(f"{self.capability}.{self.part}: {message}")

    def profiles(self) -> dict:
        if "profiles" not in self.cache:
            path = self.contracts / "json-document-storage" / "storage-profiles.json"
            data = load_json(path) if path.is_file() else {}
            self.cache["profiles"] = data.get("engines", {}) if isinstance(data, dict) else {}
        return self.cache["profiles"]


def recovery_arithmetic(ctx: Context, case: dict, decl) -> list[str]:
    reasons: list[str] = []
    if not isinstance(decl, dict):
        return reasons
    horizon = seconds(decl.get("erasure_horizon"))
    for store in decl.get("stores") or []:
        if not isinstance(store, dict):
            continue
        name = store.get("name", "<store>")
        ret = store.get("retention") if isinstance(store.get("retention"), dict) else {}
        drill = store.get("drill") if isinstance(store.get("drill"), dict) else {}
        floor, ceiling = seconds(ret.get("floor")), seconds(ret.get("ceiling"))
        cadence, stale = seconds(drill.get("cadence")), seconds(drill.get("stale_after"))
        if floor is not None and ceiling is not None and floor > ceiling:
            reasons.append(f"{name}: retention.floor > retention.ceiling")
        if ceiling is not None and horizon is not None and ceiling > horizon:
            reasons.append(f"{name}: retention.ceiling > erasure_horizon")
        if cadence is not None and floor is not None and cadence > floor:
            reasons.append(f"{name}: drill.cadence > retention.floor")
        if cadence is not None and stale is not None and cadence > stale:
            reasons.append(f"{name}: drill.cadence > drill.stale_after")
    return reasons


def reference_key_agrees_with_row(ctx: Context, case: dict, ref) -> list[str]:
    if not isinstance(ref, dict) or not isinstance(ref.get("key"), str):
        return []
    segments = ref["key"].split("/")
    reasons: list[str] = []
    if segments[-1] != str(ref.get("id")):
        reasons.append("the key's final segment is not the id")
    tenant = ref.get("tenant_id")
    if tenant is not None and segments[0] != str(tenant):
        reasons.append("the key's first segment is not tenant_id")
    return reasons


def _declared_secrets(decl) -> list[dict]:
    entries = decl.get("secrets") if isinstance(decl, dict) else None
    return [s if isinstance(s, dict) else {} for s in (entries if isinstance(entries, list) else [])]


def secret_names_unique(ctx: Context, case: dict, decl) -> list[str]:
    """A finding names positions in the declaration and never repeats what the
    declaration says, so a CI log carries no part of it."""
    first_at: dict[object, int] = {}
    reasons: list[str] = []
    for i, s in enumerate(_declared_secrets(decl)):
        name = s.get("name")
        if name in first_at:
            reasons.append(f"secrets[{i}] repeats the name of secrets[{first_at[name]}]")
        else:
            first_at[name] = i
    return reasons


def one_credential_per_backing_service(ctx: Context, case: dict, decl) -> list[str]:
    holders: dict[object, list[int]] = {}
    for i, s in enumerate(_declared_secrets(decl)):
        if s.get("kind") not in ACCESS_GRANTING or "migrate" in (s.get("images") or []):
            continue
        holders.setdefault(s.get("backing_service"), []).append(i)
    return [
        f"secrets[{', '.join(str(i) for i in at)}] are {len(at)} access-granting credentials to one backing service"
        for at in holders.values()
        if len(at) > 1
    ]


def _declared(case: dict) -> list[dict]:
    return [d for d in (case.get("declared") or []) if isinstance(d, dict)]


def leak_event_targets_the_declaration(ctx: Context, case: dict, event) -> list[str]:
    target = event.get("target") if isinstance(event, dict) and isinstance(event.get("target"), dict) else {}
    if target.get("type") != "secret":
        return ["target.type is not secret"]
    for d in _declared(case):
        if d.get("id") == target.get("id") and d.get("name") == target.get("display"):
            return []
    return ["target does not name a declared secret by id and name"]


def leak_event_action_is_a_permission(ctx: Context, case: dict, event) -> list[str]:
    action = event.get("action") if isinstance(event, dict) else None
    if not isinstance(action, str) or not PERMISSION.match(action):
        return ["action is not resource.verb"]
    if action.startswith("auth."):
        return ["action is in the reserved auth namespace"]
    return []


def leak_event_carries_no_declared_value(ctx: Context, case: dict, event) -> list[str]:
    blob = json.dumps(event)
    return [f"the event carries the value of {d.get('name')}" for d in _declared(case) if d.get("value") and str(d["value"]) in blob]


def admission_engine_profile_admits_role(ctx: Context, case: dict, adm) -> list[str]:
    if not isinstance(adm, dict):
        return []
    profile = ctx.profiles().get(adm.get("engine"))
    if not isinstance(profile, dict):
        return []
    roles = profile.get("admitted_roles") or []
    return [] if adm.get("role") in roles else [f"the {adm.get('engine')} profile admits roles {roles}, not {adm.get('role')}"]


def admission_current_version_has_schema(ctx: Context, case: dict, adm) -> list[str]:
    reasons: list[str] = []
    for coll in (adm.get("collections") or []) if isinstance(adm, dict) else []:
        if not isinstance(coll, dict):
            continue
        version = coll.get("current_schema_version")
        if str(version) not in (coll.get("schemas") or {}):
            reasons.append(f"{coll.get('name')}: current_schema_version {version} has no schema")
    return reasons


def admission_credentials_differ(ctx: Context, case: dict, adm) -> list[str]:
    creds = adm.get("credentials") if isinstance(adm, dict) and isinstance(adm.get("credentials"), dict) else {}
    if creds.get("runtime") is not None and creds.get("runtime") == creds.get("declaration"):
        return ["runtime and declaration credentials are one credential"]
    return []


def admission_scoped_index_leads_with_isolation(ctx: Context, case: dict, adm) -> list[str]:
    reasons: list[str] = []
    for coll in (adm.get("collections") or []) if isinstance(adm, dict) else []:
        if not isinstance(coll, dict) or not coll.get("scoped"):
            continue
        levels = coll.get("isolation_levels") or []
        if not levels:
            continue
        lead = f"{levels[0]}_id"
        for index in coll.get("indexes") or []:
            fields = index.get("fields") if isinstance(index, dict) else None
            first = fields[0].get("field") if fields and isinstance(fields[0], dict) else None
            if first != lead:
                reasons.append(f"{coll.get('name')}: index {index.get('name')} leads with {first}, not {lead}")
    return reasons


def envelope_scoped_carries_tenant(ctx: Context, case: dict, doc) -> list[str]:
    coll = case.get("collection") if isinstance(case.get("collection"), dict) else {}
    if coll.get("scoped") and isinstance(doc, dict) and "tenant_id" not in doc:
        return ["a scoped collection's document carries no tenant_id"]
    return []


def envelope_within_ceiling(ctx: Context, case: dict, doc) -> list[str]:
    coll = case.get("collection") if isinstance(case.get("collection"), dict) else {}
    ceiling = coll.get("max_document_bytes")
    size = case.get("bytes")
    if not isinstance(size, int):
        size = len(json.dumps(doc, separators=(",", ":"), ensure_ascii=False).encode("utf-8"))
    if isinstance(ceiling, int) and size > ceiling:
        return [f"{size} bytes exceeds the collection's ceiling of {ceiling}"]
    return []


def acceptance_calendar(ctx: Context, case: dict, inst) -> list[str]:
    """SB2's calendar half. It has its own expectation, `findings`, and never
    changes the schema verdict."""
    today_s = case.get("today")
    if not isinstance(today_s, str):
        return []
    today = dt.date.fromisoformat(today_s)
    entries = [inst] if "entry" in case else (inst.get("acceptances") or [] if isinstance(inst, dict) else [])
    found: set[str] = set()
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        try:
            expires = dt.date.fromisoformat(entry["expires"]) if isinstance(entry.get("expires"), str) else None
            accepted = dt.date.fromisoformat(entry["accepted_on"]) if isinstance(entry.get("accepted_on"), str) else None
        except ValueError:
            continue
        if expires is not None and expires < today:
            found.add("acceptance.expired")
        if expires is not None and accepted is not None and (expires - accepted).days > 90:
            found.add("acceptance.window_exceeds_90_days")
    expected = case.get("findings")
    if isinstance(expected, list) and sorted(found) != sorted(expected):
        ctx.direct(f"{case.get('case')}: calendar findings {sorted(found)} differ from expected {sorted(expected)}")
    return []


def error_message_adds_to_msg(ctx: Context, case: dict, line) -> list[str]:
    """030 SC2: a class is not a diagnosis. The one mechanical half of that
    judgment is an error message that repeats the line's msg and adds
    nothing to it."""
    if not isinstance(line, dict) or not isinstance(line.get("error"), dict):
        return []
    msg = str(line.get("msg", "")).strip().lower()
    message = str(line["error"].get("message", "")).strip().lower()
    if msg and message == msg:
        return ["error.message repeats msg and adds no reason"]
    return []


def engine_enum_equals_profile_keys(ctx: Context) -> list[str]:
    schema = ctx.schemas.get(ADMISSION_SCHEMA_ID) or {}
    enum = sorted(((schema.get("properties") or {}).get("engine") or {}).get("enum") or [])
    keys = sorted(ctx.profiles().keys())
    if enum and keys and enum != keys:
        return [f"admission.schema.json engine enum {enum} differs from storage-profiles.json keys {keys}"]
    return []


CHECKS = {
    "recovery_arithmetic": recovery_arithmetic,
    "reference_key_agrees_with_row": reference_key_agrees_with_row,
    "secret_names_unique": secret_names_unique,
    "one_credential_per_backing_service": one_credential_per_backing_service,
    "leak_event_targets_the_declaration": leak_event_targets_the_declaration,
    "leak_event_action_is_a_permission": leak_event_action_is_a_permission,
    "leak_event_carries_no_declared_value": leak_event_carries_no_declared_value,
    "admission_engine_profile_admits_role": admission_engine_profile_admits_role,
    "admission_current_version_has_schema": admission_current_version_has_schema,
    "admission_credentials_differ": admission_credentials_differ,
    "admission_scoped_index_leads_with_isolation": admission_scoped_index_leads_with_isolation,
    "envelope_scoped_carries_tenant": envelope_scoped_carries_tenant,
    "envelope_within_ceiling": envelope_within_ceiling,
    "acceptance_calendar": acceptance_calendar,
    "error_message_adds_to_msg": error_message_adds_to_msg,
}
PART_CHECKS = {
    "engine_enum_equals_profile_keys": engine_enum_equals_profile_keys,
}


# ---------------------------------------------------------------------------
# The generic runner.


def resolve_fixture(corpus: dict, instance) -> tuple[object, str | None]:
    """{"$fixture": name} -> the corpus's fixture of that name, or an error."""
    if not (isinstance(instance, dict) and set(instance) == {"$fixture"}):
        return instance, None
    name = instance["$fixture"]
    for key in ("fixture", "fixtures"):
        table = corpus.get(key)
        if isinstance(table, dict) and name in table:
            return table[name], None
    return None, f"names fixture {name!r}, which the corpus does not carry"


def instance_of(rule: dict, case: dict) -> tuple[object, str | None, bool]:
    """(instance, schema ref, present). `instances` maps alternative case keys
    to schema refs; `instance` names one key and the schema comes from `schema`
    or from the case's own `schema_from` key through `schemas`."""
    alternatives = rule.get("instances")
    if isinstance(alternatives, dict):
        for key, ref in alternatives.items():
            if key in case:
                return case[key], ref, True
        return None, None, False
    key = rule.get("instance")
    if not isinstance(key, str) or key not in case:
        return None, None, False
    ref = rule.get("schema")
    named = rule.get("schema_from")
    if isinstance(named, str):
        table = rule.get("schemas") or {}
        ref = table.get(case.get(named))
    return case[key], ref, True


def judge_corpus(ctx_base: dict, capability: str, corpus_path: pathlib.Path) -> tuple[list[str], int, int, list[str]]:
    corpus = load_json(corpus_path)
    if not isinstance(corpus, dict):
        return [f"{corpus_path}: corpus is not an object"], 0, 0, []
    rules = corpus.get("judged_by")
    if not isinstance(rules, dict):
        return [], 0, 0, []
    findings: list[str] = []
    judged = skipped = 0
    parts: list[str] = []
    for part, rule in rules.items():
        if part == "description" or not isinstance(rule, dict):
            continue
        ctx = Context(corpus=corpus, capability=capability, part=part, **ctx_base)
        cases = corpus.get(part)
        if not isinstance(cases, list):
            findings.append(f"{capability}: judged_by names part {part!r}, which the corpus does not carry")
            continue
        parts.append(part)
        checks = []
        for name in rule.get("checks") or []:
            if name in CHECKS:
                checks.append(CHECKS[name])
            else:
                findings.append(f"{capability}.{part}: names runner check {name!r}, which this tool does not implement")
        for name in rule.get("part_checks") or []:
            if name in PART_CHECKS:
                findings.extend(f"{capability}.{part}: {m}" for m in PART_CHECKS[name](ctx))
            else:
                findings.append(f"{capability}.{part}: names part check {name!r}, which this tool does not implement")
        for case in cases:
            if not isinstance(case, dict):
                findings.append(f"{capability}.{part}: a case is not an object")
                continue
            case_id = case.get("case") or case.get("id") or "<unnamed case>"
            instance, ref, present = instance_of(rule, case)
            if not present:
                skipped += 1
                continue
            if not isinstance(ref, str):
                findings.append(f"{capability}.{part}: {case_id}: no schema resolves for this case")
                continue
            instance, problem = resolve_fixture(corpus, instance)
            if problem:
                findings.append(f"{capability}.{part}: {case_id}: {problem}")
                continue
            expected = case.get("valid")
            if expected not in (True, False):
                findings.append(f"{capability}.{part}: {case_id}: missing a boolean 'valid'")
                continue
            errors = schema_errors(ctx.registry, ref, instance)
            reasons: list[str] = []
            for check in checks:
                reasons.extend(check(ctx, case, instance))
            actual = not errors and not reasons
            if case.get("schemaCannotCatch") and errors:
                findings.append(f"{capability}.{part}: {case_id}: flagged schemaCannotCatch, and the schema rejects it: {errors[0]}")
            if actual != expected:
                detail = errors[0] if errors else (reasons[0] if reasons else "the schema and every check accept it")
                findings.append(f"{capability}.{part}: {case_id}: expected {'valid' if expected else 'invalid'}, got {detail}")
            judged += 1
        findings.extend(ctx.findings)
    return findings, judged, skipped, parts


# ---------------------------------------------------------------------------
# Repository files the schemas name.


def repository_files(root: pathlib.Path, contracts: pathlib.Path, registry, schemas: dict) -> tuple[list[str], int]:
    wanted: dict[str, tuple[str, dict]] = {}
    for sid, schema in schemas.items():
        note = schema.get("x-repository-file")
        if isinstance(note, dict) and isinstance(note.get("name"), str):
            wanted[note["name"]] = (sid, note)
    if not wanted:
        return [], 0
    findings: list[str] = []
    count = 0
    contracts_resolved = contracts.resolve()
    for dirpath, dirnames, filenames in os.walk(root):
        here = pathlib.Path(dirpath)
        dirnames[:] = sorted(
            d for d in dirnames
            if d not in SKIP_DIRS and (here / d).resolve() != contracts_resolved
        )
        for name in filenames:
            if name not in wanted:
                continue
            sid, note = wanted[name]
            path = here / name
            try:
                data = load_json(path)
            except (OSError, ValueError) as exc:
                findings.append(f"{path}: cannot be read as JSON ({exc})")
                continue
            count += 1
            rel = path.relative_to(root)
            if note.get("instance") == "array":
                if not isinstance(data, list):
                    findings.append(f"{rel}: expected an array of instances")
                    continue
                for i, item in enumerate(data):
                    for message in schema_errors(registry, sid, item):
                        findings.append(f"{rel}[{i}]: {message}")
            else:
                for message in schema_errors(registry, sid, data):
                    findings.append(f"{rel}: {message}")
    return findings, count


# ---------------------------------------------------------------------------
# The two fixtures.


def run_rbac_structure(contracts: pathlib.Path) -> list[str]:
    path = contracts / "rbac" / "decisions.json"
    if not path.is_file():
        return []
    data = load_json(path)
    if not isinstance(data, dict):
        return [f"{path}: decisions corpus is not an object"]
    findings: list[str] = []
    fixture = data.get("fixture")
    if not isinstance(fixture, dict):
        findings.append(f"{path}: fixture is missing")
        return findings
    for key in ("permissions", "roles", "grants"):
        if key not in fixture:
            findings.append(f"{path}: fixture.{key} is missing")
    for permission in fixture.get("permissions") or []:
        if not isinstance(permission, str) or not PERMISSION.match(permission):
            findings.append(f"{path}: fixture permission {permission!r} is not resource.action (070 RB2)")
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks:
        findings.append(f"{path}: checks[] is missing or empty")
        return findings
    seen: set[str] = set()
    for case in checks:
        if not isinstance(case, dict):
            findings.append(f"{path}: a check is not an object")
            continue
        case_id = case.get("id")
        if not isinstance(case_id, str) or not case_id:
            findings.append(f"{path}: a check has an empty id")
            continue
        if case_id in seen:
            findings.append(f"{path}: duplicate check id {case_id}")
        seen.add(case_id)
        inner = case.get("check")
        if not isinstance(inner, dict):
            findings.append(f"{path}: check {case_id} is missing check{{}}")
            continue
        missing = [k for k in CHECK_INNER if k not in inner]
        if missing:
            findings.append(f"{path}: check {case_id} missing {', '.join(missing)}")
        expect = case.get("expect")
        if not isinstance(expect, dict) or not expect:
            findings.append(f"{path}: check {case_id} missing expect{{}}")
    rejections = data.get("rejections")
    if isinstance(rejections, list):
        for case in rejections:
            if not isinstance(case, dict) or not isinstance(case.get("id"), str):
                findings.append(f"{path}: a rejection is missing an id")
    return findings


def catalog_integrity(catalog: dict, path: pathlib.Path) -> list[str]:
    findings: list[str] = []
    caps = [c["id"] for c in catalog.get("capabilities") or [] if isinstance(c, dict) and isinstance(c.get("id"), str)]
    metrics = [m for m in catalog.get("metrics") or [] if isinstance(m, dict)]
    settings = [s["id"] for s in catalog.get("settings") or [] if isinstance(s, dict) and isinstance(s.get("id"), str)]
    ids = caps + [m["id"] for m in metrics if isinstance(m.get("id"), str)] + settings
    seen: set[str] = set()
    for entitlement_id in ids:
        if entitlement_id in seen:
            findings.append(f"{path}: duplicate entitlement id {entitlement_id}")
        seen.add(entitlement_id)
    quota_ids = [m["id"] for m in metrics if m.get("kind") == "quota" and isinstance(m.get("id"), str)]
    allowance_ids = [m["id"] for m in metrics if m.get("kind") == "allowance" and isinstance(m.get("id"), str)]
    cap_set = set(caps)
    for plan in catalog.get("plans") or []:
        if not isinstance(plan, dict):
            continue
        plan_id = plan.get("id", "<missing>")
        for capability in plan.get("capabilities") or []:
            if capability not in cap_set:
                findings.append(f"{path}: plan {plan_id} lists undeclared capability {capability}")
        quotas = plan.get("quotas") if isinstance(plan.get("quotas"), dict) else {}
        for metric_id in quota_ids:
            if metric_id not in quotas:
                findings.append(f"{path}: plan {plan_id} missing declared quota {metric_id}")
        allowances = plan.get("allowances") if isinstance(plan.get("allowances"), dict) else {}
        for metric_id in allowance_ids:
            if metric_id not in allowances:
                findings.append(f"{path}: plan {plan_id} missing declared allowance {metric_id}")
        plan_settings = plan.get("settings") if isinstance(plan.get("settings"), dict) else {}
        for setting_id in settings:
            if setting_id not in plan_settings:
                findings.append(f"{path}: plan {plan_id} missing declared setting {setting_id}")
    return findings


def billing_check_shape(path: pathlib.Path, label: str, case: dict) -> list[str]:
    findings: list[str] = []
    operation = case.get("operation")
    if operation not in BILLING_OPS:
        findings.append(f"{path}: {label} has unknown operation {operation!r}")
        return findings
    inner = case.get("check")
    if not isinstance(inner, dict):
        findings.append(f"{path}: {label} is missing check{{}}")
        return findings
    required = ("tenant",) + BILLING_OPS[operation]
    missing = [k for k in required if k not in inner]
    if missing:
        findings.append(f"{path}: {label} missing {', '.join(missing)}")
    expect = case.get("expect")
    if not isinstance(expect, dict) or not expect:
        findings.append(f"{path}: {label} missing expect{{}}")
    return findings


def run_billing_structure(contracts: pathlib.Path, registry) -> list[str]:
    path = contracts / "billing" / "entitlements.json"
    if not path.is_file():
        return []
    data = load_json(path)
    if not isinstance(data, dict):
        return [f"{path}: entitlements corpus is not an object"]
    findings: list[str] = []
    fixture = data.get("fixture")
    if not isinstance(fixture, dict):
        findings.append(f"{path}: fixture is missing")
        return findings
    for key in BILLING_FIXTURE:
        if key not in fixture:
            findings.append(f"{path}: fixture.{key} is missing")
    catalog = fixture.get("catalog")
    if isinstance(catalog, dict):
        for message in schema_errors(registry, CATALOG_SCHEMA_ID, catalog):
            findings.append(f"{path}: fixture.catalog: {message}")
        findings.extend(catalog_integrity(catalog, path))
    for label, def_name in (("subscriptions", "subscription"), ("ledger", "ledgerRow"), ("overrides", "override")):
        for i, row in enumerate(fixture.get(label) or []):
            for message in schema_errors(registry, f"{SUBSCRIPTION_SCHEMA_ID}#/$defs/{def_name}", row):
                findings.append(f"{path}: fixture.{label}[{i}]: {message}")
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks:
        findings.append(f"{path}: checks[] is missing or empty")
        return findings
    seen: set[str] = set()
    for case in checks:
        if not isinstance(case, dict):
            findings.append(f"{path}: a check is not an object")
            continue
        case_id = case.get("id")
        if not isinstance(case_id, str) or not case_id:
            findings.append(f"{path}: a check has an empty id")
            continue
        if case_id in seen:
            findings.append(f"{path}: duplicate check id {case_id}")
        seen.add(case_id)
        findings.extend(billing_check_shape(path, f"check {case_id}", case))
        before = case.get("before")
        if before is not None:
            if not isinstance(before, dict):
                findings.append(f"{path}: check {case_id} before is not an object")
            else:
                findings.extend(billing_check_shape(path, f"check {case_id} before", before))
    rejections = data.get("rejections")
    if isinstance(rejections, list):
        for case in rejections:
            if not isinstance(case, dict) or not isinstance(case.get("id"), str):
                findings.append(f"{path}: a rejection is missing an id")
                continue
            expect = case.get("expect")
            if not isinstance(expect, dict) or not (expect.get("refused") is True or expect.get("error") is True):
                findings.append(f"{path}: rejection {case['id']} missing expect.refused or expect.error")
    elif rejections is not None:
        findings.append(f"{path}: rejections is not a list")
    return findings


