#!/usr/bin/env bash
# Tests .github/actions/go-caches/go-caches, the Go cache setup every
# job-go-*.yml runs. The catalog's own CI never runs those jobs, so this is the
# only place the script runs before it reaches the portfolio.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
script="${root}/.github/actions/go-caches/go-caches"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fails=0
pass() { echo "  ok  $1"; }
fail() { echo "FAIL  $1"; fails=$((fails + 1)); }

# run [VAR=value ...]: run the script for one simulated job, with its own
# RUNNER_TEMP, GITHUB_ENV and GITHUB_OUTPUT.
run() {
  local job; job="$(mktemp -d "${work}/job-XXXX")"
  mkdir -p "${job}/temp"
  : > "${job}/env"; : > "${job}/out"
  env -i PATH="$PATH" HOME="$job" \
    RUNNER_TEMP="${job}/temp" \
    GITHUB_ENV="${job}/env" GITHUB_OUTPUT="${job}/out" \
    "$@" "$script" > "${job}/log" 2>&1
  local rc=$?
  echo "$job"
  return $rc
}

# caches_in_temp <job>: both caches exist under that job's RUNNER_TEMP.
caches_in_temp() {
  grep -q "^GOMODCACHE=$1/temp/go-mod$" "$1/env" && grep -q "^GOCACHE=$1/temp/go-build$" "$1/env" \
    && [ -d "$1/temp/go-mod" ] && [ -d "$1/temp/go-build" ]
}

# 1. Proxy off: both caches under RUNNER_TEMP, and the module cache restored.
j="$(run)"
if caches_in_temp "$j" && grep -qx 'skip-mod-cache=false' "${j}/out"; then
  pass "proxy off: caches under RUNNER_TEMP, module cache restored"; else fail "proxy off"; cat "${j}/log"; fi

# 2. Proxy on: the same caches, and the module cache restore skipped.
j="$(run GHR_GOPROXY=1 GOPROXY=http://goproxy.lan:3000)"
if caches_in_temp "$j" && grep -qx 'skip-mod-cache=true' "${j}/out" \
   && grep -q "goproxy.lan" "${j}/log"; then
  pass "proxy on: caches under RUNNER_TEMP, module cache skipped"; else fail "proxy on"; cat "${j}/log"; fi

# 3. Any value but 1 is not the proxy.
for v in 0 true ""; do
  j="$(run GHR_GOPROXY="$v")"
  if grep -qx 'skip-mod-cache=false' "${j}/out"; then pass "GHR_GOPROXY='${v}': module cache restored"; else fail "GHR_GOPROXY='${v}'"; cat "${j}/log"; fi
done

# 4. Two jobs on one host never share a cache directory.
a="$(run GHR_GOPROXY=1)"; b="$(run GHR_GOPROXY=1)"
if [ "$(grep GOMODCACHE "${a}/env")" != "$(grep GOMODCACHE "${b}/env")" ] \
   && [ "$(grep GOCACHE "${a}/env")" != "$(grep GOCACHE "${b}/env")" ]; then
  pass "two jobs: separate caches"; else fail "two jobs share a cache"; fi

if [ "$fails" -gt 0 ]; then
  echo "${fails} case(s) failed"
  exit 1
fi
echo "all cases passed"
