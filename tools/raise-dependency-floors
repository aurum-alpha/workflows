#!/usr/bin/env python3
"""Raise each floor in dependency-versions.json to where the fleet is.

An entry in dependency-versions.json admits any exact version from `min`
through `max`, so Dependabot moves one repository at a time without failing
the others. What an interval does not do on its own is keep the fleet current: a
repository can sit on `min` for as long as nobody looks. This tool is the
looking. Over a directory holding every repository at its default branch, it
finds the lowest version any Node unit declares for each package and raises
`min` to it. Once `min` reaches `max`, the move that `max` started is done. The floor only ever moves to a version every repository
already runs, so raising it fails no one.

Run against local clones:
    tools/raise-dependency-floors --root /workspace            # report
    tools/raise-dependency-floors --root /workspace --write    # and rewrite

`--root` must hold EVERY repository that calls job-ci-conformance. A repository
missing from it is a repository the new floor may fail, and nothing here can
tell an absent repository from one that does not declare the package. A
package no unit declares keeps its floor, since there is no evidence to raise
it on.

Exit status is 0 whether or not a floor can move, and non-zero for a usage
error or a record the checker would refuse.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent


def load_checker():
    """check-dependency-versions, imported, so unit discovery and version
    parsing have one implementation between the two tools."""
    path = HERE / "check-dependency-versions"
    loader = importlib.machinery.SourceFileLoader("cdv", str(path))
    spec = importlib.util.spec_from_loader("cdv", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def lowest_declared(cdv, root: pathlib.Path, section: str) -> dict[str, str]:
    """name -> the lowest exact version any unit under root declares there."""
    lowest: dict[str, str] = {}
    for repo in sorted(p.name for p in root.iterdir()
                       if p.is_dir() and not p.name.startswith(".")):
        for unit in cdv.node_units(root, repo):
            manifest = json.loads(
                (root / repo / unit / "package.json").read_text())
            for name, got in manifest.get(section, {}).items():
                if not cdv.VERSION.match(got):
                    continue
                if name not in lowest or \
                        cdv.version_key(got) < cdv.version_key(lowest[name]):
                    lowest[name] = got
    return lowest


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", required=True, type=pathlib.Path)
    ap.add_argument("--versions", type=pathlib.Path,
                    default=HERE.parent / "dependency-versions.json")
    ap.add_argument("--write", action="store_true",
                    help="rewrite the record with the raised floors")
    args = ap.parse_args()

    cdv = load_checker()
    data = json.loads(args.versions.read_text())
    raised = 0
    for section in ("devDependencies", "dependencies"):
        specs = data.get(section, {})
        cdv.validate_specs(section, specs)
        lowest = lowest_declared(cdv, args.root, section)
        for name, spec in sorted(specs.items()):
            if name not in lowest:
                continue
            fleet = lowest[name]
            if cdv.version_key(fleet) <= cdv.version_key(spec["min"]):
                continue
            if not cdv.within_max(fleet, spec["max"]):
                # The checker fails such a unit, so a fleet that got here is
                # one the checker has not run over. Say so and leave it.
                print(f"{section}.{name}: lowest declared {fleet} is above "
                      f"max {spec['max']}; floor left at {spec['min']}")
                continue
            print(f"{section}.{name}: min {spec['min']} -> {fleet}")
            spec["min"] = fleet
            raised += 1

    if not raised:
        print("No floor can rise: some repository declares each package at "
              "its floor.")
        return 0
    if args.write:
        args.versions.write_text(json.dumps(data, indent=2) + "\n")
        print(f"Raised {raised} floor(s) in {args.versions}.")
    else:
        print(f"{raised} floor(s) can rise; --write records them.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
