    { "id": "tsinput-accepts-no-millis", "def": "timestampInput", "value": "2026-08-31T14:07:02Z", "valid": true },
    { "id": "tsinput-accepts-lowercase", "def": "timestampInput", "value": "2026-08-31t14:07:02.417z", "valid": true, "note": "RFC 3339 permits lowercase t/z on input (IP4)" },
