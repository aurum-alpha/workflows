def judge_all(contracts: pathlib.Path, registry, schemas: dict) -> tuple[list[str], list[str], int]:
    """Every corpus's schema-decided half. Returns findings, one report line
    per corpus, and the number of cases judged."""
    ctx_base = {"contracts": contracts, "registry": registry, "schemas": schemas}
    findings: list[str] = []
    lines: list[str] = []
    total = 0
    for corpus_path in sorted(contracts.glob("*/corpus.json")):
        capability = corpus_path.parent.name
        corpus_findings, judged, skipped, parts = judge_corpus(ctx_base, capability, corpus_path)
        findings.extend(corpus_findings)
        total += judged
        if parts:
            note = f", {skipped} case(s) without an instance skipped" if skipped else ""
            lines.append(f"  {'fail' if corpus_findings else 'ok  '} {capability}: {judged} cases judged across {', '.join(parts)}{note}")
    return findings, lines, total


def run_all(contracts: pathlib.Path, root: pathlib.Path | None = None) -> tuple[list[str], str]:
    """Everything the checker proves about one contracts tree, and the ok line."""
    registry, schemas = registry_for(contracts)
    findings = run_schemas(contracts) + run_corpus_ids(contracts)
    judged_findings, lines, total = judge_all(contracts, registry, schemas)
    findings.extend(judged_findings)
    for line in lines:
        print(line)
    fixtures = []
    if (contracts / "rbac" / "decisions.json").is_file():
        findings.extend(run_rbac_structure(contracts))
        fixtures.append("rbac/decisions.json")
    if (contracts / "billing" / "entitlements.json").is_file():
        findings.extend(run_entitlements_fixture(contracts, registry))
        fixtures.append("billing/entitlements.json")
    files = 0
    if root is not None:
        file_findings, files = repository_files(root, contracts, registry, schemas)
        findings.extend(file_findings)
    schema_n = sum(1 for _ in contracts.rglob("*.schema.json"))
    summary = f"ok  {schema_n} schema(s) parse and resolve; {total} schema-decided cases under {contracts}"
    if fixtures:
        summary += f"; fixtures {' and '.join(fixtures)} loadable"
    if root is not None:
        summary += f"; {files} repository file(s) validated"
    return findings, summary


def report(findings: list[str], ok_line: str) -> int:
    if not findings:
        print(ok_line)
        return 0
    for finding in findings:
        print(f"fail  {finding}", file=sys.stderr)
    return 1


def self_test() -> int:
    """The fixtures under testdata/ are the proof the $ref walk still walks."""
    if not SELF_TEST.is_dir():
        print(f"self-test fixtures missing at {SELF_TEST}", file=sys.stderr)
        return 2

    def contracts_of(name: str) -> pathlib.Path:
        return SELF_TEST / name / "contracts"

    failures: list[str] = []

    ok, _ = run_all(contracts_of("ok"))
    if ok:
        failures.append("ok fixture was refused:\n  " + "\n  ".join(ok))

    broken, _ = run_all(contracts_of("broken-ref"))
    if not any("missing.schema.json" in finding for finding in broken):
        failures.append(
            "broken-ref fixture did not name the missing file "
            f"(got {broken or ['no findings']})"
        )

    pointer, _ = run_all(contracts_of("broken-pointer"))
    if not any("pointer does not resolve" in finding for finding in pointer):
        failures.append(
            "broken-pointer fixture did not refuse the missing $def "
            f"(got {pointer or ['no findings']})"
        )

    wrong, _ = run_all(contracts_of("wrong-id"))
    if not any("$id is" in finding and "expected" in finding for finding in wrong):
        failures.append(
            f"wrong-id fixture did not refuse the mismatched $id (got {wrong or ['no findings']})"
        )

    dups, _ = run_all(contracts_of("duplicate-id"))
    if not any("duplicate case id" in finding for finding in dups):
        failures.append(
            "duplicate-id fixture did not refuse the repeated id "
            f"(got {dups or ['no findings']})"
        )

    if failures:
        for failure in failures:
            print(f"fail  {failure}", file=sys.stderr)
        return 1
    print(f"ok  self-test fixtures under {SELF_TEST}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path("."))
    parser.add_argument("--contracts", type=pathlib.Path, default=None)
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="run against tools/testdata/contract-conformance and expect the known findings",
    )
    args = parser.parse_args()
    try:
        from jsonschema import Draft202012Validator  # noqa: F401
        from referencing import Registry  # noqa: F401
    except ImportError:
        print("jsonschema is required to run the contract checker (pip install jsonschema)", file=sys.stderr)
        return 2
    if args.self_test:
        return self_test()
    root = args.root.resolve()
    contracts = find_contracts(root, args.contracts.resolve() if args.contracts else None)
    if contracts is None:
        print("no contracts in this repository; nothing to run")
        return 0
    findings, summary = run_all(contracts, root)
    return report(findings, summary)


if __name__ == "__main__":
    sys.exit(main())
