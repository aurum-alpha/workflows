#!/usr/bin/env python3
"""Prove the contracts this repository owns still parse.

Every *.schema.json under contracts/ is a legal JSON Schema for the dialect
its $schema names, its $id matches its path, and every $ref resolves to a
file in the tree (and to the JSON pointer, when one is named). A typo in a
$ref, an $id that does not match its path, or a schema that is not a schema
fails here rather than in whichever repository vendors the file next.

The static halves of the auth, RBAC and billing corpora still run: the
validity half of auth/corpus.json is schema-decided; decisions.json and
entitlements.json are fixtures a runner can load. Each platform module still
executes check() itself, and each product that answers for billing still
executes entitlementsFor() itself.

Every other JSON file under contracts/ must parse, and case ids inside a
corpus file must be unique. A duplicated id defeats the modules that drive
cases by id.

A repository with no contracts/ passes, the way one with no ANSWERS passes
check-corpus-coverage.

--self-test runs the checker against tools/testdata/contract-conformance,
including a schema whose $ref names a file that is not there. That fixture
is what fails if the $ref walk stops walking.

Run:  tools/check-contract-conformance [--root DIR] [--contracts DIR]
      tools/check-contract-conformance --self-test
Exit: 0 covered or nothing to run, 1 findings, 2 could not ask
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent
SELF_TEST = HERE / "testdata" / "contract-conformance"

ID_PREFIX = "https://contracts.aurumalpha.dev/"
DRAFT_2020_12 = "https://json-schema.org/draft/2020-12/schema"

# The keys under which a corpus keeps its cases. Same set
# check-corpus-coverage reads, so a rename there is a rename here.
CASE_KEYS = (
    "checks",
    "rejections",
    "behaviour",
    "validity",
    "resolve",
    "switch",
    "view",
)

SCHEMA_IDS = {
    "me": "https://contracts.aurumalpha.dev/auth/me.schema.json",
}

CATALOG_SCHEMA_ID = "https://contracts.aurumalpha.dev/billing/catalog.schema.json"
SUBSCRIPTION_SCHEMA_ID = (
    "https://contracts.aurumalpha.dev/billing/subscription.schema.json"
)

CHECK_INNER = ("subject", "scope", "activeGrant")

BILLING_FIXTURE = ("now", "catalog", "subscriptions", "ledger", "overrides")
BILLING_OPS = {
    "entitled": ("capability",),
    "quotaFor": ("metric",),
    "allowanceFor": ("metric",),
    "settingFor": ("setting",),
    "withinQuota": ("metric", "current"),
    "withinAllowance": ("metric", "used"),
    "entitlementsFor": (),
}


def load_json(path: pathlib.Path) -> object:
    return json.loads(path.read_text(encoding="utf-8"))


def find_contracts(root: pathlib.Path, explicit: pathlib.Path | None) -> pathlib.Path | None:
    if explicit is not None:
        return explicit
    candidate = root / "contracts"
    if not candidate.is_dir():
        return None
    if (
        (candidate / "auth" / "corpus.json").is_file()
        or (candidate / "rbac" / "decisions.json").is_file()
        or (candidate / "billing" / "entitlements.json").is_file()
        or any(candidate.rglob("*.schema.json"))
    ):
        return candidate
    return None


def rel_to(contracts: pathlib.Path, path: pathlib.Path) -> str:
    return path.relative_to(contracts).as_posix()


def walk_refs(node: object) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        ref = node.get("$ref")
        if isinstance(ref, str) and ref:
            found.append(ref)
        for value in node.values():
            found.extend(walk_refs(value))
    elif isinstance(node, list):
        for value in node:
            found.extend(walk_refs(value))
    return found


def resolve_pointer(document: object, pointer: str) -> object:
    """RFC 6901. Raises ValueError when the pointer does not resolve."""
    if pointer in ("", "#"):
        return document
    if pointer.startswith("#"):
        pointer = pointer[1:]
    if not pointer:
        return document
    if not pointer.startswith("/"):
        raise ValueError(f"pointer {pointer!r} is not a JSON pointer")
    node: object = document
    for raw in pointer[1:].split("/"):
        key = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(node, dict):
            if key not in node:
                raise ValueError(f"missing {key!r}")
            node = node[key]
        elif isinstance(node, list):
            try:
                node = node[int(key)]
            except (ValueError, IndexError) as exc:
                raise ValueError(f"index {key!r} is not in the array") from exc
        else:
            raise ValueError(f"cannot walk {key!r} through a {type(node).__name__}")
    return node


def load_schema(path: pathlib.Path) -> dict | str:
    try:
        data = load_json(path)
    except json.JSONDecodeError as exc:
        return f"is not valid JSON ({exc.msg} at line {exc.lineno})"
    if not isinstance(data, dict):
        return "is not a JSON object"
    return data


def run_schemas(contracts: pathlib.Path) -> list[str]:
    from jsonschema import Draft202012Validator

    findings: list[str] = []
    loaded: dict[pathlib.Path, dict] = {}
    for path in sorted(contracts.rglob("*.schema.json")):
        rel = rel_to(contracts, path)
        data = load_schema(path)
        if isinstance(data, str):
            findings.append(f"{rel}: {data}")
            continue
        loaded[path] = data
        schema_uri = data.get("$schema")
        if schema_uri != DRAFT_2020_12:
            findings.append(
                f"{rel}: $schema is {schema_uri!r}, expected {DRAFT_2020_12}"
            )
        expected_id = ID_PREFIX + rel
        sid = data.get("$id")
        if not isinstance(sid, str) or not sid:
            findings.append(f"{rel}: missing $id (expected {expected_id})")
        elif sid != expected_id:
            findings.append(f"{rel}: $id is {sid!r}, expected {expected_id}")
        try:
            Draft202012Validator.check_schema(data)
        except Exception as exc:  # noqa: BLE001 — report and continue
            findings.append(f"{rel}: not a legal JSON Schema ({exc})")
    for path, data in loaded.items():
        rel = rel_to(contracts, path)
        for ref in walk_refs(data):
            findings.extend(resolve_ref(contracts, path, rel, ref, loaded))
    return findings


def resolve_ref(
    contracts: pathlib.Path,
    source: pathlib.Path,
    rel: str,
    ref: str,
    loaded: dict[pathlib.Path, dict],
) -> list[str]:
    uri, hash_sign, pointer = ref.partition("#")
    fragment = f"#{pointer}" if hash_sign else ""
    if not uri:
        target = source
        target_doc = loaded.get(source)
        if target_doc is None:
            return [f"{rel}: $ref {ref!r} is in a file that did not parse"]
    elif uri.startswith(ID_PREFIX):
        target = contracts / uri[len(ID_PREFIX) :]
        if not target.is_file():
            return [f"{rel}: $ref {ref!r} names no file under contracts/"]
        target_doc = loaded.get(target)
        if target_doc is None:
            loaded_doc = load_schema(target)
            if isinstance(loaded_doc, str):
                return [f"{rel}: $ref {ref!r} target {loaded_doc}"]
            target_doc = loaded_doc
    elif uri.startswith("https://") or uri.startswith("http://"):
        return [f"{rel}: $ref {ref!r} is not a contracts.aurumalpha.dev URI"]
    else:
        target = (source.parent / uri).resolve()
        try:
            target.relative_to(contracts.resolve())
        except ValueError:
            return [f"{rel}: $ref {ref!r} walks outside contracts/"]
        if not target.is_file():
            return [f"{rel}: $ref {ref!r} names no file under contracts/"]
        target_doc = loaded.get(target)
        if target_doc is None:
            loaded_doc = load_schema(target)
            if isinstance(loaded_doc, str):
                return [f"{rel}: $ref {ref!r} target {loaded_doc}"]
            target_doc = loaded_doc
    if not fragment:
        return []
    try:
        resolve_pointer(target_doc, fragment)
    except ValueError as exc:
        return [f"{rel}: $ref {ref!r} pointer does not resolve ({exc})"]
    return []


def case_id(case: object) -> str | None:
    if not isinstance(case, dict):
        return None
    for key in ("id", "case"):
        value = case.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def run_corpus_ids(contracts: pathlib.Path) -> list[str]:
    findings: list[str] = []
    for path in sorted(contracts.rglob("*.json")):
        if path.name.endswith(".schema.json"):
            continue
        rel = rel_to(contracts, path)
        try:
            data = load_json(path)
        except json.JSONDecodeError as exc:
            findings.append(f"{rel}: is not valid JSON ({exc.msg} at line {exc.lineno})")
            continue
        if not isinstance(data, dict):
            findings.append(f"{rel}: is not a JSON object")
            continue
        seen: set[str] = set()
        for key in CASE_KEYS:
            cases = data.get(key)
            if not isinstance(cases, list):
                continue
            for case in cases:
                cid = case_id(case)
                if cid is None:
                    continue
                if cid in seen:
                    findings.append(f"{rel}: duplicate case id {cid}")
                seen.add(cid)
    return findings


def registry_for(contracts: pathlib.Path):
    from referencing import Registry, Resource

    registry = Registry()
    for schema_path in contracts.rglob("*.schema.json"):
        schema = load_json(schema_path)
        if not isinstance(schema, dict):
            continue
        sid = schema.get("$id")
        if isinstance(sid, str) and sid:
            registry = registry.with_resource(sid, Resource.from_contents(schema))
    return registry


def schema_errors(registry, schema_id: str, value, def_name: str | None = None) -> list[str]:
    from jsonschema import Draft202012Validator

    try:
        schema = (
            {"$ref": f"{schema_id}#/$defs/{def_name}"}
            if def_name
            else registry[schema_id].contents
        )
    except Exception as exc:  # noqa: BLE001 — report and continue
        return [f"schema {schema_id} not in the vendored tree ({exc})"]
    validator = Draft202012Validator(schema, registry=registry)
    return [e.message for e in sorted(validator.iter_errors(value), key=lambda e: e.path)]


def run_auth_validity(contracts: pathlib.Path, registry) -> list[str]:
    from jsonschema import Draft202012Validator

    corpus_path = contracts / "auth" / "corpus.json"
    if not corpus_path.is_file():
        return []
    corpus = load_json(corpus_path)
    if not isinstance(corpus, dict):
        return [f"{corpus_path}: corpus is not an object"]
    findings: list[str] = []
    for case in corpus.get("validity") or []:
        if not isinstance(case, dict):
            findings.append(f"{corpus_path}: a validity case is not an object")
            continue
        case_id = case.get("id", "<missing id>")
        def_name = case.get("def")
        schema_id = SCHEMA_IDS.get(def_name) if isinstance(def_name, str) else None
        if schema_id is None:
            findings.append(f"{case_id}: unknown validity def {def_name!r}")
            continue
        try:
            schema = registry[schema_id].contents
        except Exception as exc:  # noqa: BLE001 — report and continue
            findings.append(f"{case_id}: schema {schema_id} not in the vendored tree ({exc})")
            continue
        validator = Draft202012Validator(schema, registry=registry)
        errors = sorted(validator.iter_errors(case.get("value")), key=lambda e: e.path)
        ok = not errors
        expected = case.get("valid")
        if expected is True and not ok:
            first = errors[0]
            findings.append(f"{case_id}: expected valid, got {first.message}")
        elif expected is False and ok:
            findings.append(f"{case_id}: expected invalid, document validated")
        elif expected not in (True, False):
            findings.append(f"{case_id}: validity case is missing a boolean 'valid'")
    return findings


def run_rbac_structure(contracts: pathlib.Path) -> list[str]:
    path = contracts / "rbac" / "decisions.json"
    if not path.is_file():
        return []
    data = load_json(path)
    if not isinstance(data, dict):
        return [f"{path}: decisions corpus is not an object"]
    findings: list[str] = []
    fixture = data.get("fixture")
    if not isinstance(fixture, dict):
        findings.append(f"{path}: fixture is missing")
        return findings
    for key in ("permissions", "roles", "grants"):
        if key not in fixture:
            findings.append(f"{path}: fixture.{key} is missing")
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks:
        findings.append(f"{path}: checks[] is missing or empty")
        return findings
    seen: set[str] = set()
    for case in checks:
        if not isinstance(case, dict):
            findings.append(f"{path}: a check is not an object")
            continue
        case_id = case.get("id")
        if not isinstance(case_id, str) or not case_id:
            findings.append(f"{path}: a check has an empty id")
            continue
        if case_id in seen:
            findings.append(f"{path}: duplicate check id {case_id}")
        seen.add(case_id)
        inner = case.get("check")
        if not isinstance(inner, dict):
            findings.append(f"{path}: check {case_id} is missing check{{}}")
            continue
        missing = [k for k in CHECK_INNER if k not in inner]
        if missing:
            findings.append(f"{path}: check {case_id} missing {', '.join(missing)}")
        expect = case.get("expect")
        if not isinstance(expect, dict) or not expect:
            findings.append(f"{path}: check {case_id} missing expect{{}}")
    rejections = data.get("rejections")
    if isinstance(rejections, list):
        for case in rejections:
            if not isinstance(case, dict) or not isinstance(case.get("id"), str):
                findings.append(f"{path}: a rejection is missing an id")
    return findings


def catalog_integrity(catalog: dict, path: pathlib.Path) -> list[str]:
    findings: list[str] = []
    caps = [
        c["id"]
        for c in catalog.get("capabilities") or []
        if isinstance(c, dict) and isinstance(c.get("id"), str)
    ]
    metrics = [m for m in catalog.get("metrics") or [] if isinstance(m, dict)]
    settings = [
        s["id"]
        for s in catalog.get("settings") or []
        if isinstance(s, dict) and isinstance(s.get("id"), str)
    ]
    ids = caps + [m["id"] for m in metrics if isinstance(m.get("id"), str)] + settings
    seen: set[str] = set()
    for entitlement_id in ids:
        if entitlement_id in seen:
            findings.append(f"{path}: duplicate entitlement id {entitlement_id}")
        seen.add(entitlement_id)
    quota_ids = [m["id"] for m in metrics if m.get("kind") == "quota" and isinstance(m.get("id"), str)]
    allowance_ids = [
        m["id"] for m in metrics if m.get("kind") == "allowance" and isinstance(m.get("id"), str)
    ]
    cap_set = set(caps)
    for plan in catalog.get("plans") or []:
        if not isinstance(plan, dict):
            continue
        plan_id = plan.get("id", "<missing>")
        for capability in plan.get("capabilities") or []:
            if capability not in cap_set:
                findings.append(
                    f"{path}: plan {plan_id} lists undeclared capability {capability}"
                )
        quotas = plan.get("quotas") if isinstance(plan.get("quotas"), dict) else {}
        for metric_id in quota_ids:
            if metric_id not in quotas:
                findings.append(f"{path}: plan {plan_id} missing declared quota {metric_id}")
        allowances = plan.get("allowances") if isinstance(plan.get("allowances"), dict) else {}
        for metric_id in allowance_ids:
            if metric_id not in allowances:
                findings.append(
                    f"{path}: plan {plan_id} missing declared allowance {metric_id}"
                )
        plan_settings = plan.get("settings") if isinstance(plan.get("settings"), dict) else {}
        for setting_id in settings:
            if setting_id not in plan_settings:
                findings.append(
                    f"{path}: plan {plan_id} missing declared setting {setting_id}"
                )
    return findings


def billing_check_shape(path: pathlib.Path, label: str, case: dict) -> list[str]:
    findings: list[str] = []
    operation = case.get("operation")
    if operation not in BILLING_OPS:
        findings.append(f"{path}: {label} has unknown operation {operation!r}")
        return findings
    inner = case.get("check")
    if not isinstance(inner, dict):
        findings.append(f"{path}: {label} is missing check{{}}")
        return findings
    required = ("tenant",) + BILLING_OPS[operation]
    missing = [k for k in required if k not in inner]
    if missing:
        findings.append(f"{path}: {label} missing {', '.join(missing)}")
    expect = case.get("expect")
    if not isinstance(expect, dict) or not expect:
        findings.append(f"{path}: {label} missing expect{{}}")
    return findings


def run_billing_structure(contracts: pathlib.Path, registry) -> list[str]:
    path = contracts / "billing" / "entitlements.json"
    if not path.is_file():
        return []
    data = load_json(path)
    if not isinstance(data, dict):
        return [f"{path}: entitlements corpus is not an object"]
    findings: list[str] = []
    fixture = data.get("fixture")
    if not isinstance(fixture, dict):
        findings.append(f"{path}: fixture is missing")
        return findings
    for key in BILLING_FIXTURE:
        if key not in fixture:
            findings.append(f"{path}: fixture.{key} is missing")
    catalog = fixture.get("catalog")
    if isinstance(catalog, dict):
        for message in schema_errors(registry, CATALOG_SCHEMA_ID, catalog):
            findings.append(f"{path}: fixture.catalog: {message}")
        findings.extend(catalog_integrity(catalog, path))
    for i, row in enumerate(fixture.get("subscriptions") or []):
        for message in schema_errors(registry, SUBSCRIPTION_SCHEMA_ID, row, "subscription"):
            findings.append(f"{path}: fixture.subscriptions[{i}]: {message}")
    for i, row in enumerate(fixture.get("ledger") or []):
        for message in schema_errors(registry, SUBSCRIPTION_SCHEMA_ID, row, "ledgerRow"):
            findings.append(f"{path}: fixture.ledger[{i}]: {message}")
    for i, row in enumerate(fixture.get("overrides") or []):
        for message in schema_errors(registry, SUBSCRIPTION_SCHEMA_ID, row, "override"):
            findings.append(f"{path}: fixture.overrides[{i}]: {message}")
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks:
        findings.append(f"{path}: checks[] is missing or empty")
        return findings
    seen: set[str] = set()
    for case in checks:
        if not isinstance(case, dict):
            findings.append(f"{path}: a check is not an object")
            continue
        case_id = case.get("id")
        if not isinstance(case_id, str) or not case_id:
            findings.append(f"{path}: a check has an empty id")
            continue
        if case_id in seen:
            findings.append(f"{path}: duplicate check id {case_id}")
        seen.add(case_id)
        findings.extend(billing_check_shape(path, f"check {case_id}", case))
        before = case.get("before")
        if before is not None:
            if not isinstance(before, dict):
                findings.append(f"{path}: check {case_id} before is not an object")
            else:
                findings.extend(billing_check_shape(path, f"check {case_id} before", before))
    rejections = data.get("rejections")
    if isinstance(rejections, list):
        for case in rejections:
            if not isinstance(case, dict) or not isinstance(case.get("id"), str):
                findings.append(f"{path}: a rejection is missing an id")
                continue
            expect = case.get("expect")
            if not isinstance(expect, dict) or not (
                expect.get("refused") is True or expect.get("error") is True
            ):
                findings.append(
                    f"{path}: rejection {case['id']} missing expect.refused or expect.error"
                )
    elif rejections is not None:
        findings.append(f"{path}: rejections is not a list")
    return findings


def run_all(contracts: pathlib.Path) -> list[str]:
    try:
        from jsonschema import Draft202012Validator  # noqa: F401
        from referencing import Registry  # noqa: F401
    except ImportError:
        raise SystemExit(
            "jsonschema is required to run the contract checker "
            "(pip install jsonschema)"
        )
    registry = registry_for(contracts)
    return (
        run_schemas(contracts)
        + run_corpus_ids(contracts)
        + run_auth_validity(contracts, registry)
        + run_rbac_structure(contracts)
        + run_billing_structure(contracts, registry)
    )


def report(findings: list[str], ok_line: str) -> int:
    if not findings:
        print(ok_line)
        return 0
    for finding in findings:
        print(f"fail  {finding}", file=sys.stderr)
    return 1


def self_test() -> int:
    """The fixtures under testdata/ are the proof the $ref walk still walks."""
    if not SELF_TEST.is_dir():
        print(f"self-test fixtures missing at {SELF_TEST}", file=sys.stderr)
        return 2

    def contracts_of(name: str) -> pathlib.Path:
        return SELF_TEST / name / "contracts"

    failures: list[str] = []

    ok = run_all(contracts_of("ok"))
    if ok:
        failures.append("ok fixture was refused:\n  " + "\n  ".join(ok))

    broken = run_all(contracts_of("broken-ref"))
    if not any("missing.schema.json" in finding for finding in broken):
        failures.append(
            "broken-ref fixture did not name the missing file "
            f"(got {broken or ['no findings']})"
        )

    pointer = run_all(contracts_of("broken-pointer"))
    if not any("pointer does not resolve" in finding for finding in pointer):
        failures.append(
            "broken-pointer fixture did not refuse the missing $def "
            f"(got {pointer or ['no findings']})"
        )

    wrong = run_all(contracts_of("wrong-id"))
    if not any("$id is" in finding and "expected" in finding for finding in wrong):
        failures.append(
            f"wrong-id fixture did not refuse the mismatched $id (got {wrong or ['no findings']})"
        )

    dups = run_all(contracts_of("duplicate-id"))
    if not any("duplicate case id" in finding for finding in dups):
        failures.append(
            "duplicate-id fixture did not refuse the repeated id "
            f"(got {dups or ['no findings']})"
        )

    if failures:
        for failure in failures:
            print(f"fail  {failure}", file=sys.stderr)
        return 1
    print(f"ok  self-test fixtures under {SELF_TEST}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path("."))
    parser.add_argument("--contracts", type=pathlib.Path, default=None)
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="run against tools/testdata/contract-conformance and expect the known findings",
    )
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    root = args.root.resolve()
    contracts = find_contracts(root, args.contracts.resolve() if args.contracts else None)
    if contracts is None:
        print("no contracts in this repository; nothing to run")
        return 0
    try:
        findings = run_all(contracts)
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 2
    schema_n = sum(1 for _ in contracts.rglob("*.schema.json"))
    ran = [
        name
        for name, rel in (
            ("auth", "auth/corpus.json"),
            ("RBAC", "rbac/decisions.json"),
            ("billing", "billing/entitlements.json"),
        )
        if (contracts / rel).is_file()
    ]
    parts = [f"{schema_n} schema{'s' if schema_n != 1 else ''}"]
    if ran:
        parts.append(" and ".join(ran) + " corpora")
    return report(findings, f"ok  {' + '.join(parts)} under {contracts}")


if __name__ == "__main__":
    sys.exit(main())
