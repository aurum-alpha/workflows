DURATION = re.compile(
    r"^P(?:(?P<y>\d+)Y)?(?:(?P<mo>\d+)M)?(?:(?P<w>\d+)W)?(?:(?P<d>\d+)D)?"
    r"(?:T(?:(?P<h>\d+)H)?(?:(?P<mi>\d+)M)?(?:(?P<s>\d+(?:\.\d+)?)S)?)?$"
)


def load_json(path: pathlib.Path) -> object:
    return json.loads(path.read_text(encoding="utf-8"))


def seconds(duration: object) -> float | None:
    """An ISO 8601 duration as seconds, with a month as 30 days and a year as
    365, which is enough to order the durations a declaration carries."""
    if not isinstance(duration, str):
        return None
    m = DURATION.match(duration)
    if not m or duration == "P":
        return None
    g = {k: float(v) for k, v in m.groupdict().items() if v is not None}
    return (
        g.get("y", 0) * 365 * 86400
        + g.get("mo", 0) * 30 * 86400
        + g.get("w", 0) * 7 * 86400
        + g.get("d", 0) * 86400
        + g.get("h", 0) * 3600
        + g.get("mi", 0) * 60
        + g.get("s", 0)
    )


def find_contracts(root: pathlib.Path, explicit: pathlib.Path | None) -> pathlib.Path | None:
    if explicit is not None:
        return explicit
    candidate = root / "contracts"
    if not candidate.is_dir():
        return None
    if (
        any(candidate.glob("*/corpus.json"))
        or any(candidate.rglob("*.schema.json"))
        or any((candidate / rel).is_file() for rel in ("rbac/decisions.json", "billing/entitlements.json"))
    ):
        return candidate
    return None


def rel_to(contracts: pathlib.Path, path: pathlib.Path) -> str:
    return path.relative_to(contracts).as_posix()


def walk_refs(node: object) -> list[str]:
    found: list[str] = []
    if isinstance(node, dict):
        ref = node.get("$ref")
        if isinstance(ref, str) and ref:
            found.append(ref)
        for value in node.values():
            found.extend(walk_refs(value))
    elif isinstance(node, list):
        for value in node:
            found.extend(walk_refs(value))
    return found


def resolve_pointer(document: object, pointer: str) -> object:
    """RFC 6901. Raises ValueError when the pointer does not resolve."""
    if pointer in ("", "#"):
        return document
    if pointer.startswith("#"):
        pointer = pointer[1:]
    if not pointer:
        return document
    if not pointer.startswith("/"):
        raise ValueError(f"pointer {pointer!r} is not a JSON pointer")
    node: object = document
    for raw in pointer[1:].split("/"):
        key = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(node, dict):
            if key not in node:
                raise ValueError(f"missing {key!r}")
            node = node[key]
        elif isinstance(node, list):
            try:
                node = node[int(key)]
            except (ValueError, IndexError) as exc:
                raise ValueError(f"index {key!r} is not in the array") from exc
        else:
            raise ValueError(f"cannot walk {key!r} through a {type(node).__name__}")
    return node


def load_schema(path: pathlib.Path) -> dict | str:
    try:
        data = load_json(path)
    except json.JSONDecodeError as exc:
        return f"is not valid JSON ({exc.msg} at line {exc.lineno})"
    if not isinstance(data, dict):
        return "is not a JSON object"
    return data


def run_schemas(contracts: pathlib.Path) -> list[str]:
    from jsonschema import Draft202012Validator

    findings: list[str] = []
    loaded: dict[pathlib.Path, dict] = {}
    for path in sorted(contracts.rglob("*.schema.json")):
        rel = rel_to(contracts, path)
        data = load_schema(path)
        if isinstance(data, str):
            findings.append(f"{rel}: {data}")
            continue
        loaded[path] = data
        schema_uri = data.get("$schema")
        if schema_uri != DRAFT_2020_12:
            findings.append(
                f"{rel}: $schema is {schema_uri!r}, expected {DRAFT_2020_12}"
            )
        expected_id = ID_PREFIX + rel
        sid = data.get("$id")
        if not isinstance(sid, str) or not sid:
            findings.append(f"{rel}: missing $id (expected {expected_id})")
        elif sid != expected_id:
            findings.append(f"{rel}: $id is {sid!r}, expected {expected_id}")
        try:
            Draft202012Validator.check_schema(data)
        except Exception as exc:  # noqa: BLE001 — report and continue
            findings.append(f"{rel}: not a legal JSON Schema ({exc})")
    for path, data in loaded.items():
        rel = rel_to(contracts, path)
        for ref in walk_refs(data):
            findings.extend(resolve_ref(contracts, path, rel, ref, loaded))
    return findings


def resolve_ref(
    contracts: pathlib.Path,
    source: pathlib.Path,
    rel: str,
    ref: str,
    loaded: dict[pathlib.Path, dict],
) -> list[str]:
    uri, hash_sign, pointer = ref.partition("#")
    fragment = f"#{pointer}" if hash_sign else ""
    if not uri:
        target = source
        target_doc = loaded.get(source)
        if target_doc is None:
            return [f"{rel}: $ref {ref!r} is in a file that did not parse"]
    elif uri.startswith(ID_PREFIX):
        target = contracts / uri[len(ID_PREFIX) :]
        if not target.is_file():
            return [f"{rel}: $ref {ref!r} names no file under contracts/"]
        target_doc = loaded.get(target)
        if target_doc is None:
            loaded_doc = load_schema(target)
            if isinstance(loaded_doc, str):
                return [f"{rel}: $ref {ref!r} target {loaded_doc}"]
            target_doc = loaded_doc
    elif uri.startswith("https://") or uri.startswith("http://"):
        return [f"{rel}: $ref {ref!r} is not a contracts.aurumalpha.dev URI"]
    else:
        target = (source.parent / uri).resolve()
        try:
            target.relative_to(contracts.resolve())
        except ValueError:
            return [f"{rel}: $ref {ref!r} walks outside contracts/"]
        if not target.is_file():
            return [f"{rel}: $ref {ref!r} names no file under contracts/"]
        target_doc = loaded.get(target)
        if target_doc is None:
            loaded_doc = load_schema(target)
            if isinstance(loaded_doc, str):
                return [f"{rel}: $ref {ref!r} target {loaded_doc}"]
            target_doc = loaded_doc
    if not fragment:
        return []
    try:
        resolve_pointer(target_doc, fragment)
    except ValueError as exc:
        return [f"{rel}: $ref {ref!r} pointer does not resolve ({exc})"]
    return []


def case_name(case: object) -> str | None:
    if not isinstance(case, dict):
        return None
    for name_key in CASE_NAME_KEYS:
        value = case.get(name_key)
        if isinstance(value, str) and value:
            return value
    return None


def run_corpus_ids(contracts: pathlib.Path) -> list[str]:
    """Every JSON file that is not a schema parses to an object, and a case
    name is unique within its file, whatever part it sits in."""
    findings: list[str] = []
    for path in sorted(contracts.rglob("*.json")):
        if path.name.endswith(".schema.json"):
            continue
        rel = rel_to(contracts, path)
        try:
            data = load_json(path)
        except json.JSONDecodeError as exc:
            findings.append(f"{rel}: is not valid JSON ({exc.msg} at line {exc.lineno})")
            continue
        if not isinstance(data, dict):
            findings.append(f"{rel}: is not a JSON object")
            continue
        seen: set[str] = set()
        for cases in data.values():
            if not isinstance(cases, list):
                continue
            for case in cases:
                cid = case_name(case)
                if cid is None:
                    continue
                if cid in seen:
                    findings.append(f"{rel}: duplicate case id {cid}")
                seen.add(cid)
    return findings


def registry_for(contracts: pathlib.Path):
    from referencing import Registry, Resource

    registry = Registry()
    schemas: dict[str, dict] = {}
    for schema_path in sorted(contracts.rglob("*.schema.json")):
        schema = load_json(schema_path)
        if not isinstance(schema, dict):
            continue
        sid = schema.get("$id")
        if isinstance(sid, str) and sid:
            registry = registry.with_resource(sid, Resource.from_contents(schema))
            schemas[sid] = schema
    return registry, schemas


def schema_errors(registry, ref: str, value) -> list[str]:
    """Validate `value` against a schema id, with an optional JSON pointer."""
    from jsonschema import Draft202012Validator

    try:
        validator = Draft202012Validator({"$ref": ref}, registry=registry)
        return [e.message for e in sorted(validator.iter_errors(value), key=lambda e: list(e.path))]
    except Exception as exc:  # noqa: BLE001 — report and continue
        return [f"schema {ref} could not be resolved ({exc})"]


# ---------------------------------------------------------------------------
# Runner checks. Each takes the context, the case and the instance, and
# reports every reason it rejects the instance through ctx.reject(). A check
# with an expectation of its own beside the verdict (the calendar findings)
# reports through ctx.direct(). Checks return nothing: a finding is built from
# what the context collected, never from a check's return value.


@dataclass
class Context:
    contracts: pathlib.Path
    registry: object
    schemas: dict
    capability: str
    part: str
    corpus: dict
    findings: list[str] = field(default_factory=list)
    rejections: list[str] = field(default_factory=list)
    cache: dict = field(default_factory=dict)

    def reject(self, reason: str) -> None:
        self.rejections.append(reason)

    def direct(self, message: str) -> None:
        self.findings.append(f"{self.capability}.{self.part}: {message}")

    def profiles(self) -> dict:
        if "profiles" not in self.cache:
            path = self.contracts / "json-document-storage" / "storage-profiles.json"
            data = load_json(path) if path.is_file() else {}
            self.cache["profiles"] = data.get("engines", {}) if isinstance(data, dict) else {}
        return self.cache["profiles"]


def recovery_arithmetic(ctx: Context, case: dict, decl) -> None:
    if not isinstance(decl, dict):
        return
    horizon = seconds(decl.get("erasure_horizon"))
    for store in decl.get("stores") or []:
        if not isinstance(store, dict):
            continue
        name = store.get("name", "<store>")
        ret = store.get("retention") if isinstance(store.get("retention"), dict) else {}
        drill = store.get("drill") if isinstance(store.get("drill"), dict) else {}
        floor, ceiling = seconds(ret.get("floor")), seconds(ret.get("ceiling"))
        cadence, stale = seconds(drill.get("cadence")), seconds(drill.get("stale_after"))
        if floor is not None and ceiling is not None and floor > ceiling:
            ctx.reject(f"{name}: retention.floor > retention.ceiling")
        if ceiling is not None and horizon is not None and ceiling > horizon:
            ctx.reject(f"{name}: retention.ceiling > erasure_horizon")
        if cadence is not None and floor is not None and cadence > floor:
            ctx.reject(f"{name}: drill.cadence > retention.floor")
        if cadence is not None and stale is not None and cadence > stale:
            ctx.reject(f"{name}: drill.cadence > drill.stale_after")


def reference_segments_agree_with_row(ctx: Context, case: dict, ref) -> None:
    """026 BS3, BS10: the object path's final segment is the id, and where the
    row is tenant-scoped its first segment is the tenant."""
    if not isinstance(ref, dict) or not isinstance(ref.get("key"), str):
        return
    segments = ref["key"].split("/")
    if segments[-1] != str(ref.get("id")):
        ctx.reject("the final path segment is not the id")
    tenant = ref.get("tenant_id")
    if tenant is not None and segments[0] != str(tenant):
        ctx.reject("the first path segment is not tenant_id")


def _declaration_entries(decl) -> list[dict]:
    entries = decl.get("secrets") if isinstance(decl, dict) else None
    return [s if isinstance(s, dict) else {} for s in (entries if isinstance(entries, list) else [])]


def declaration_names_unique(ctx: Context, case: dict, decl) -> None:
    """A finding names positions in the declaration and never repeats what the
    declaration says, so a CI log carries no part of it."""
    first_at: dict[object, int] = {}
    for i, s in enumerate(_declaration_entries(decl)):
        name = s.get("name")
        if name in first_at:
            ctx.reject(f"secrets[{i}] repeats the name of secrets[{first_at[name]}]")
        else:
            first_at[name] = i


def backing_service_granted_once(ctx: Context, case: dict, decl) -> None:
    holders: dict[object, list[int]] = {}
    for i, s in enumerate(_declaration_entries(decl)):
        if s.get("kind") not in ACCESS_GRANTING or "migrate" in (s.get("images") or []):
            continue
        holders.setdefault(s.get("backing_service"), []).append(i)
    for at in holders.values():
        if len(at) > 1:
            positions = ", ".join(str(i) for i in at)
            ctx.reject(f"secrets[{positions}] are {len(at)} access-granting entries to one backing service")


def _declared(case: dict) -> list[dict]:
    return [d for d in (case.get("declared") or []) if isinstance(d, dict)]


def leak_event_targets_the_declaration(ctx: Context, case: dict, event) -> None:
    target = event.get("target") if isinstance(event, dict) and isinstance(event.get("target"), dict) else {}
    if target.get("type") != "secret":
        ctx.reject("target.type is not secret")
        return
    for d in _declared(case):
        if d.get("id") == target.get("id") and d.get("name") == target.get("display"):
            return
    ctx.reject("target does not name a declared entry by id and name")


def leak_event_action_is_a_permission(ctx: Context, case: dict, event) -> None:
    action = event.get("action") if isinstance(event, dict) else None
    if not isinstance(action, str) or not PERMISSION.match(action):
        ctx.reject("action is not resource.verb")
    elif action.startswith("auth."):
        ctx.reject("action is in the reserved auth namespace")


def leak_event_carries_no_declared_value(ctx: Context, case: dict, event) -> None:
    blob = json.dumps(event)
    for i, d in enumerate(_declared(case)):
        if d.get("value") and str(d["value"]) in blob:
            ctx.reject(f"the event carries the value of declared[{i}]")


def admission_engine_profile_admits_role(ctx: Context, case: dict, adm) -> None:
    if not isinstance(adm, dict):
        return
    profile = ctx.profiles().get(adm.get("engine"))
    if not isinstance(profile, dict):
        return
    roles = profile.get("admitted_roles") or []
    if adm.get("role") not in roles:
        ctx.reject(f"the {adm.get('engine')} profile admits roles {roles}, not {adm.get('role')}")


def admission_current_version_has_schema(ctx: Context, case: dict, adm) -> None:
    for coll in (adm.get("collections") or []) if isinstance(adm, dict) else []:
        if not isinstance(coll, dict):
            continue
        version = coll.get("current_schema_version")
        if str(version) not in (coll.get("schemas") or {}):
            ctx.reject(f"{coll.get('name')}: current_schema_version {version} has no schema")


def admission_runtime_and_declaration_variables_differ(ctx: Context, case: dict, adm) -> None:
    pair = adm.get("credentials") if isinstance(adm, dict) and isinstance(adm.get("credentials"), dict) else {}
    if pair.get("runtime") is not None and pair.get("runtime") == pair.get("declaration"):
        ctx.reject("the runtime and declaration variables are one variable")


def admission_scoped_index_leads_with_isolation(ctx: Context, case: dict, adm) -> None:
    for coll in (adm.get("collections") or []) if isinstance(adm, dict) else []:
        if not isinstance(coll, dict) or not coll.get("scoped"):
            continue
        levels = coll.get("isolation_levels") or []
        if not levels:
            continue
        lead = f"{levels[0]}_id"
        for index in coll.get("indexes") or []:
            fields = index.get("fields") if isinstance(index, dict) else None
            first = fields[0].get("field") if fields and isinstance(fields[0], dict) else None
            if first != lead:
                ctx.reject(f"{coll.get('name')}: index {index.get('name')} leads with {first}, not {lead}")


def envelope_scoped_carries_tenant(ctx: Context, case: dict, doc) -> None:
    coll = case.get("collection") if isinstance(case.get("collection"), dict) else {}
    if coll.get("scoped") and isinstance(doc, dict) and "tenant_id" not in doc:
        ctx.reject("a scoped collection's document carries no tenant_id")


def envelope_within_ceiling(ctx: Context, case: dict, doc) -> None:
    coll = case.get("collection") if isinstance(case.get("collection"), dict) else {}
    ceiling = coll.get("max_document_bytes")
    size = case.get("bytes")
    if not isinstance(size, int):
        size = len(json.dumps(doc, separators=(",", ":"), ensure_ascii=False).encode("utf-8"))
    if isinstance(ceiling, int) and size > ceiling:
        ctx.reject(f"{size} bytes exceeds the collection's ceiling of {ceiling}")


def acceptance_calendar(ctx: Context, case: dict, inst) -> None:
    """SB2's calendar half. It has its own expectation, `findings`, and never
    changes the schema verdict."""
    today_s = case.get("today")
    if not isinstance(today_s, str):
        return
    today = dt.date.fromisoformat(today_s)
    entries = [inst] if "entry" in case else (inst.get("acceptances") or [] if isinstance(inst, dict) else [])
    found: set[str] = set()
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        try:
            expires = dt.date.fromisoformat(entry["expires"]) if isinstance(entry.get("expires"), str) else None
            accepted = dt.date.fromisoformat(entry["accepted_on"]) if isinstance(entry.get("accepted_on"), str) else None
        except ValueError:
            continue
        if expires is not None and expires < today:
            found.add("acceptance.expired")
        if expires is not None and accepted is not None and (expires - accepted).days > 90:
            found.add("acceptance.window_exceeds_90_days")
    expected = case.get("findings")
    if isinstance(expected, list) and sorted(found) != sorted(expected):
        ctx.direct(f"{case.get('case')}: calendar findings {sorted(found)} differ from expected {sorted(expected)}")


def error_message_adds_to_msg(ctx: Context, case: dict, line) -> None:
    """030 SC2: a class is not a diagnosis. The one mechanical half of that
    judgment is an error message that repeats the line's msg and adds
    nothing to it."""
    if not isinstance(line, dict) or not isinstance(line.get("error"), dict):
        return
    msg = str(line.get("msg", "")).strip().lower()
    message = str(line["error"].get("message", "")).strip().lower()
    if msg and message == msg:
        ctx.reject("error.message repeats msg and adds no reason")


def engine_enum_equals_profile_engines(ctx: Context) -> None:
    schema = ctx.schemas.get(ADMISSION_SCHEMA_ID) or {}
    enum = sorted(((schema.get("properties") or {}).get("engine") or {}).get("enum") or [])
    profiled = sorted(engine for engine in ctx.profiles())
    if enum and profiled and enum != profiled:
        ctx.direct(f"admission.schema.json engine enum {enum} differs from the engines storage-profiles.json profiles {profiled}")


CHECKS = {
    "recovery_arithmetic": recovery_arithmetic,
    "reference_key_agrees_with_row": reference_segments_agree_with_row,
    "secret_names_unique": declaration_names_unique,
    "one_credential_per_backing_service": backing_service_granted_once,
    "leak_event_targets_the_declaration": leak_event_targets_the_declaration,
    "leak_event_action_is_a_permission": leak_event_action_is_a_permission,
    "leak_event_carries_no_declared_value": leak_event_carries_no_declared_value,
    "admission_engine_profile_admits_role": admission_engine_profile_admits_role,
    "admission_current_version_has_schema": admission_current_version_has_schema,
    "admission_credentials_differ": admission_runtime_and_declaration_variables_differ,
    "admission_scoped_index_leads_with_isolation": admission_scoped_index_leads_with_isolation,
    "envelope_scoped_carries_tenant": envelope_scoped_carries_tenant,
    "envelope_within_ceiling": envelope_within_ceiling,
    "acceptance_calendar": acceptance_calendar,
    "error_message_adds_to_msg": error_message_adds_to_msg,
}
