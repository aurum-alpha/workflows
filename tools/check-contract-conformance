def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path("."))
    parser.add_argument("--contracts", type=pathlib.Path, default=None)
    args = parser.parse_args()
    root = args.root.resolve()
    contracts = find_contracts(root, args.contracts.resolve() if args.contracts else None)
    if contracts is None:
        print("no corpus under contracts/ in this repository; nothing to run")
        return 0
    try:
        from jsonschema import Draft202012Validator  # noqa: F401
        from referencing import Registry  # noqa: F401
    except ImportError:
        print("jsonschema is required to run the corpora (pip install jsonschema)", file=sys.stderr)
        return 2
    registry, schemas = registry_for(contracts)
    ctx_base = {"contracts": contracts, "registry": registry, "schemas": schemas}

    findings: list[str] = []
    total = 0
    for corpus_path in sorted(contracts.glob("*/corpus.json")):
        capability = corpus_path.parent.name
        corpus_findings, judged, skipped, parts = judge_corpus(ctx_base, capability, corpus_path)
        findings.extend(corpus_findings)
        total += judged
        if parts:
            note = f", {skipped} case(s) without an instance skipped" if skipped else ""
            print(f"  {'fail' if corpus_findings else 'ok  '} {capability}: {judged} cases judged across {', '.join(parts)}{note}")
    fixtures = []
    if (contracts / "rbac" / "decisions.json").is_file():
        findings.extend(run_rbac_structure(contracts))
        fixtures.append("rbac/decisions.json")
    if (contracts / "billing" / "entitlements.json").is_file():
        findings.extend(run_billing_structure(contracts, registry))
        fixtures.append("billing/entitlements.json")
    file_findings, files = repository_files(root, contracts, registry, schemas)
    findings.extend(file_findings)

    for finding in findings:
        print(f"fail  {finding}", file=sys.stderr)
    if findings:
        return 1
    summary = f"ok  {total} schema-decided cases under {contracts}"
    if fixtures:
        summary += f"; fixtures {' and '.join(fixtures)} loadable"
    summary += f"; {files} repository file(s) validated"
    print(summary)
    return 0


if __name__ == "__main__":
    sys.exit(main())
