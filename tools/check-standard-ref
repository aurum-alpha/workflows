#!/usr/bin/env python3
"""Verify job-ci-conformance's standard_ref moved with the checkers it selects.

job-ci-conformance takes the checkers from a pinned commit of this repo, named
by the standard_ref input's default. GitHub gives a called workflow no handle
on its own SHA, so that default cannot be derived — it has to be written down,
and the writing down is what gets forgotten.

It has now been forgotten three times, and the third was the expensive one:
#93 added two shared jobs and #94 added an allow-list entry, neither bumped
this default, and lid-firmware's first conformance run reported its two brand
new stub jobs as "unknown shared workflow" and its allow-listed job as
unexplained drift. Three findings, all of them false, all from one stale line.

The rule: a pull request that changes a checker in tools/ or a shared job in
.github/workflows/job-*.yml must also set standard_ref to the pull request's
BASE commit — the previous main. Base and not HEAD, because the default can
never name the commit that sets it; one commit of lag is structural. What this
gate prevents is the lag being five commits, or twenty.

A pull request touching neither is not asked to bump anything.

Three surfaces, not two, and the third was missing until it cost a wave. A
caller consumes `tools/`, `.github/workflows/job-*.yml` AND `setup/` — the
composite actions a bespoke caller-side job references by SHA. All three reach
a caller solely through a tag, which is why this file also reports the
unreleased backlog below.

The third surface is checker INPUT: data the checkers read out of the SAME
pinned clone they are themselves taken from, listed in CHECKER_INPUT_FILES.
Today that is fleet-versions.json alone, and check-fleet-versions says so in
its own words — "read from the checker's OWN repo root, so in CI both it and
this file come from the same .aurum-standard checkout pinned at standard_ref."

It is selected by standard_ref exactly as tools/ is, so it goes stale exactly
as tools/ does. What it does NOT look like is code, which is why it sat
outside both regexes while every other pinned-clone file sat inside them.

That omission has now failed in both directions on the same file:

  - wave A REMOVED four packages from fleet-versions.json and left this
    default behind, so repos that had already dropped them were failed for not
    declaring what the fleet had retired;
  - wave 6 MODIFIED the typescript pin to 7.0.2 and this checker printed
    "nothing a caller consumes changed" and passed, correctly by its own rule,
    while the change it was passing asserted nothing against anybody until a
    follow-up moved the pin onto it.

The first was a false red, the second a false green. A data change was never
exempt from the bump — it was exempt from being REMINDED about the bump, which
is worse, because the reminder is the entire mechanism. It is no longer exempt.

THIS CHECKER USED TO DEMAND A .version BUMP in the same pull request, and no
longer does. The version file now moves in a pull request of its own that
changes nothing but the version and prose, gated by job-version-gate: a
release is reviewed as a release, and the bytes it mints are a build of a tree
main has already proved. A rule requiring the bump HERE and a rule forbidding
it THERE cannot both be satisfied, so this one gave way — it was the weaker of
the two, because it only ever proved that a number moved, never that anyone
had decided to release.

What is lost with it is a forcing function, and pretending otherwise would be
the failure this repository exists to name. Nothing now makes a catalog change
reach the fleet on the day it lands. What replaces it is visibility rather
than a gate: every run prints how many consumed changes are sitting on main
unreleased, and the oldest one's age. A release pull request is then something
someone opens on purpose. If that backlog is still being ignored a month from
now, the honest next step is a job that opens the release pull request itself
— not a rule that pretends the bump belongs to the feature that preceded it.

Usage: check-standard-ref --base <sha>   (empty base: not a pull request, pass)
"""

import argparse
import pathlib
import re
import subprocess
import sys

# Data a checker reads out of the pinned clone rather than out of the repo
# under test or the unpinned catalog. Membership is decided by ONE question:
# does the checker resolve the path relative to its own __file__ with no
# AURUM_CATALOG_ROOT escape? fleet-versions.json is the only file in this repo
# that does, verified by reading every checker rather than by assumption --
# check-caller-permissions, check-eslint-config and check-ci-conformance all
# take the override, so in CI they read the CURRENT catalog and are immune to
# this staleness by construction.
#
# A tuple and not a regex, because it is a LIST OF REAL FILES and gets checked
# against the filesystem below. A regex naming a file that has been renamed
# matches nothing, fails nothing, and reopens this gate in silence.
CHECKER_INPUT_FILES = ("fleet-versions.json",)

_SHARED = ["tools/", r"\.github/workflows/job-[\w.-]+\.yml$"]
_INPUTS = [re.escape(f) + "$" for f in CHECKER_INPUT_FILES]

# Changes a caller consumes, and so cannot reach one without a tag. Checker
# input belongs here too: a caller only sees a new fleet-versions.json by
# re-pinning to a tag that carries the standard_ref bump pointing at it.
CONSUMED = re.compile("^(" + "|".join(_SHARED + ["setup/"] + _INPUTS) + ")")
# Of those, the ones standard_ref actually selects -- checker code AND the
# data that code reads beside it. setup/ is absent because a caller references
# a composite action by its own SHA, not through standard_ref.
CHECKERS = re.compile("^(" + "|".join(_SHARED + _INPUTS) + ")")
DEFAULT_RE = re.compile(
    r"standard_ref:.*?default:\s*([0-9a-f]{40})", re.DOTALL)


def verify_checker_inputs(root) -> bool:
    """Every file in CHECKER_INPUT_FILES still exists at the repo root.

    This guards the failure mode the list itself introduces. A rule written as
    a filename is only a rule while the file is called that; rename or delete
    it and the pattern stops matching, this gate stops asking for the bump, and
    nothing anywhere goes red. That is precisely the silence this whole surface
    was added to end, so it would be a poor joke to reintroduce it one layer up.

    Loud and fatal rather than a warning: a checker that cannot verify its own
    inputs has nothing useful to say about anyone else's.
    """
    missing = [f for f in CHECKER_INPUT_FILES if not (root / f).exists()]
    if not missing:
        return True
    print("\nFAIL: CHECKER_INPUT_FILES names a file that is not in this repo:",
          file=sys.stderr)
    for f in missing:
        print(f"  {f}", file=sys.stderr)
    print("Either the file moved and this list must move with it, or it is "
          "gone and the entry should be deleted. Until one of those happens "
          "this gate silently stops requiring a standard_ref bump for it.",
          file=sys.stderr)
    return False


def report_backlog(root, base) -> None:
    """Say how much consumed change is sitting on main with no release.

    Never fails. Nobody's pull request is at fault for a backlog that predates
    it, and a gate that goes red for something the author cannot fix is a gate
    people learn to click past.

    Measured from the last commit that touched .version rather than from the
    newest tag, because the file is the source of truth and the tag is an index
    created after the fact (Principle 14). That also means this works in a
    clone with no tags fetched, which is most of them.
    """
    last = subprocess.run(
        ["git", "log", "--format=%H", "-1", base, "--", ".version"],
        cwd=root, capture_output=True, text=True).stdout.strip()
    if not last:
        return

    span = f"{last}..{base}"
    commits = subprocess.run(["git", "log", "--format=%H", span],
                             cwd=root, capture_output=True, text=True).stdout.split()
    unreleased = []
    for c in commits:
        names = subprocess.run(
            ["git", "diff-tree", "--no-commit-id", "--name-only", "-r", c],
            cwd=root, capture_output=True, text=True).stdout.splitlines()
        if any(CONSUMED.match(f) for f in names):
            unreleased.append(c)

    if not unreleased:
        print("\nbacklog: every consumed change on main is released")
        return

    oldest = unreleased[-1]
    when = subprocess.run(["git", "log", "-1", "--format=%as", oldest],
                          cwd=root, capture_output=True, text=True).stdout.strip()
    subject = subprocess.run(["git", "log", "-1", "--format=%s", oldest],
                             cwd=root, capture_output=True, text=True).stdout.strip()
    print(f"\nbacklog: {len(unreleased)} consumed change(s) on main are "
          f"unreleased; the oldest landed {when}:")
    print(f"  {oldest[:7]} {subject[:72]}")
    print("Open a release pull request — .version and prose only — to mint "
          "them and let Dependabot re-pin the fleet.")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", default="", help="pull request base SHA")
    ap.add_argument("--repo-root", default=".", type=pathlib.Path)
    args = ap.parse_args()

    root = args.repo_root

    # Before the early return for a non-pull-request run: a broken input list
    # is wrong on every invocation, not only on the ones that compare a diff.
    if not verify_checker_inputs(root):
        return 2

    if not args.base:
        print("not a pull request — nothing to compare against")
        return 0
    wf = root / ".github/workflows/job-ci-conformance.yml"
    m = DEFAULT_RE.search(wf.read_text())
    if not m:
        print("could not find standard_ref's default in job-ci-conformance.yml",
              file=sys.stderr)
        return 2
    declared = m.group(1)

    diff = subprocess.run(
        ["git", "diff", "--name-only", f"{args.base}...HEAD"],
        cwd=root, capture_output=True, text=True, check=True).stdout
    touched = sorted(f for f in diff.splitlines() if CONSUMED.match(f))
    checkers = sorted(f for f in touched if CHECKERS.match(f))

    # Printed on every pull request, not only the ones that add to it: the
    # backlog is a fleet-wide state, and the person most likely to act on it is
    # whoever is looking at CI right now.
    report_backlog(root, args.base)

    if not touched:
        print("\nnothing a caller consumes changed")
        return 0

    print("\nchanged, and consumed by callers:")
    for f in touched:
        print(f"  {f}")

    if not checkers:
        print("\nPASS: no checker or shared job changed — standard_ref not "
              "required to move")
        return 0

    if declared == args.base:
        print(f"\nPASS: standard_ref is {declared[:7]}, the base of this "
              f"pull request")
        return 0

    print(f"\nFAIL: standard_ref is {declared[:7]} but the base of this pull "
          f"request is {args.base[:7]}.\n"
          f"A caller pinning this change would run checkers from {declared[:7]} "
          f"— without the change.\n"
          f"Set the default in job-ci-conformance.yml to {args.base}.")

    # Spelled out when DATA is what triggered this, because the demand is
    # otherwise surprising: nothing executable changed, and the natural read is
    # that the gate has misfired. It has not. The checkers take this file from
    # the same pinned clone they come from, so an unbumped pin means every
    # caller keeps asserting the old values.
    if all(f in CHECKER_INPUT_FILES for f in checkers):
        print(f"\nNothing executable changed here — {', '.join(checkers)} is "
              f"checker INPUT. It is read out of the same pinned clone the "
              f"checkers are, so until this default moves onto it every caller "
              f"goes on asserting the previous values and the change asserts "
              f"nothing against anybody.")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
