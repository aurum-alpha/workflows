#!/usr/bin/env python3
"""Verify job-ci-conformance's standard_ref moved with the checkers it selects.

job-ci-conformance takes the checkers from a pinned commit of this repo, named
by the standard_ref input's default. GitHub gives a called workflow no handle
on its own SHA, so that default cannot be derived — it has to be written down,
and the writing down is what gets forgotten.

It has now been forgotten three times, and the third was the expensive one:
#93 added two shared jobs and #94 added an allow-list entry, neither bumped
this default, and lid-firmware's first conformance run reported its two brand
new stub jobs as "unknown shared workflow" and its allow-listed job as
unexplained drift. Three findings, all of them false, all from one stale line.

The rule: a pull request that changes a checker in tools/ or a shared job in
.github/workflows/job-*.yml must also set standard_ref to the pull request's
BASE commit — the previous main. Base and not HEAD, because the default can
never name the commit that sets it; one commit of lag is structural. What this
gate prevents is the lag being five commits, or twenty.

A pull request touching neither is not asked to bump anything.

Two surfaces, not one. A caller consumes `tools/`, `.github/workflows/job-*.yml`
AND `setup/` — the composite actions a bespoke caller-side job references by
SHA. Only the first two are checkers, so only they can leave standard_ref
stale; but all three reach a caller solely through a tag, so all three need
.version to move. setup/ was outside this check entirely, which meant a
composite could be fixed and the fix could reach nobody: no bump, no tag, no
re-pin, and a caller pinning it by SHA would go on getting the old body
forever. That is not hypothetical either — it is why setup/node-pnpm spent
its whole life on pins two majors behind the prelude it duplicates.

Usage: check-standard-ref --base <sha>   (empty base: not a pull request, pass)
"""

import argparse
import pathlib
import re
import subprocess
import sys

# Changes a caller consumes, and so cannot reach one without a tag.
CONSUMED = re.compile(r"^(tools/|\.github/workflows/job-[\w.-]+\.yml$|setup/)")
# Of those, the ones standard_ref actually selects.
CHECKERS = re.compile(r"^(tools/|\.github/workflows/job-[\w.-]+\.yml$)")
DEFAULT_RE = re.compile(
    r"standard_ref:.*?default:\s*([0-9a-f]{40})", re.DOTALL)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", default="", help="pull request base SHA")
    ap.add_argument("--repo-root", default=".", type=pathlib.Path)
    args = ap.parse_args()

    if not args.base:
        print("not a pull request — nothing to compare against")
        return 0

    root = args.repo_root
    wf = root / ".github/workflows/job-ci-conformance.yml"
    m = DEFAULT_RE.search(wf.read_text())
    if not m:
        print("could not find standard_ref's default in job-ci-conformance.yml",
              file=sys.stderr)
        return 2
    declared = m.group(1)

    diff = subprocess.run(
        ["git", "diff", "--name-only", f"{args.base}...HEAD"],
        cwd=root, capture_output=True, text=True, check=True).stdout
    touched = sorted(f for f in diff.splitlines() if CONSUMED.match(f))
    checkers = sorted(f for f in touched if CHECKERS.match(f))

    if not touched:
        print("nothing a caller consumes changed — no bump required")
        return 0

    print("changed, and consumed by callers:")
    for f in touched:
        print(f"  {f}")

    # The same change that moves standard_ref has to move .version, because a
    # catalog change nobody can name is a catalog change nobody can adopt.
    # CI tags each merge to main with the value of this file, and Dependabot
    # resolves that tag to open re-pin pull requests across the fleet. Skip the
    # bump and the tag does not move, so the change reaches no repo until
    # somebody notices by hand — which is exactly how eight of ten repos ended
    # up pinning between two and four different commits.
    changed = [f for f in diff.splitlines() if f == ".version"]
    if not changed:
        print("\nFAIL: something a caller consumes changed but .version did not.\n"
              "CI tags main with .version and Dependabot re-pins the fleet from "
              "that tag; without a bump this change reaches nobody.")
        return 1

    def read(rev):
        r = subprocess.run(["git", "show", f"{rev}:.version"],
                           cwd=root, capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""

    before, after = read(args.base), read("HEAD")
    if before == after:
        print(f"\nFAIL: .version is in the diff but still reads {after!r}.")
        return 1
    if not re.fullmatch(r"\d+\.\d+\.\d+", after):
        print(f"\nFAIL: .version is {after!r}; expected MAJOR.MINOR.PATCH.")
        return 1
    if re.fullmatch(r"\d+\.\d+\.\d+", before):
        lo = tuple(map(int, before.split(".")))
        hi = tuple(map(int, after.split(".")))
        if hi <= lo:
            print(f"\nFAIL: .version went {before} -> {after}, which is not forward. "
                  "Tags are created once and never moved, so a repeat or a "
                  "decrease silently ships nothing.")
            return 1
    print(f"\n.version {before or '(absent)'} -> {after}")

    if not checkers:
        print("\nPASS: no checker or shared job changed — standard_ref not "
              "required to move")
        return 0

    if declared == args.base:
        print(f"\nPASS: standard_ref is {declared[:7]}, the base of this "
              f"pull request")
        return 0

    print(f"\nFAIL: standard_ref is {declared[:7]} but the base of this pull "
          f"request is {args.base[:7]}.\n"
          f"A caller pinning this change would run checkers from {declared[:7]} "
          f"— without the change.\n"
          f"Set the default in job-ci-conformance.yml to {args.base}.")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
