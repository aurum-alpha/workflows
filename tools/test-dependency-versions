#!/usr/bin/env python3
"""Tests check-dependency-versions' intervals and raise-dependency-floors.

Both tools run in every caller's ci-conformance and on the fleet's record, and
neither has a caller here that exercises a failing case. Each case below builds
a throwaway fleet and a throwaway record, runs the tool, and holds it to an
exit status and a line of output.
"""

import json
import pathlib
import subprocess
import sys
import tempfile

TOOLS = pathlib.Path(__file__).resolve().parent
CHECK = TOOLS / "check-dependency-versions"
RAISE = TOOLS / "raise-dependency-floors"

RECORD = {
    "pnpm": "10.34.6",
    "devDependencies": {
        "@playwright/test": {"min": "1.64.1", "max": "1.64.1"},
        "oxlint": {"min": "1.89.0", "max": "1.90"},
        "vite": {"min": "8.3.5", "max": "8"},
        "vitest": {"min": "4.1.12", "max": "4"},
        "@vitest/coverage-v8": {"min": "4.1.12", "max": "4",
                                "same_as": "vitest"},
    },
    "dependencies": {},
    "runtimes": {"node": "26"},
    "images": {},
}

failures = 0


def fleet(tmp: pathlib.Path, units: dict[str, dict]) -> pathlib.Path:
    """One repository per entry, each a Node unit declaring those devDependencies."""
    root = tmp / "fleet"
    for repo, dev in units.items():
        d = root / repo
        d.mkdir(parents=True)
        (d / "package.json").write_text(json.dumps(
            {"packageManager": "pnpm@10.34.6", "devDependencies": dev}))
        (d / ".node-version").write_text("26\n")
    return root


def record(tmp: pathlib.Path, data: dict) -> pathlib.Path:
    path = tmp / "dependency-versions.json"
    path.write_text(json.dumps(data, indent=2) + "\n")
    return path


def run(tool, *args) -> tuple[int, str]:
    p = subprocess.run([sys.executable, str(tool), *map(str, args)],
                       capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


def case(name, units, want_rc, want_text, data=RECORD):
    global failures
    with tempfile.TemporaryDirectory() as t:
        tmp = pathlib.Path(t)
        rc, out = run(CHECK, "--root", fleet(tmp, units),
                      "--versions", record(tmp, data))
    if rc == want_rc and want_text in out:
        print(f"  ok  {name}")
    else:
        print(f"FAIL  {name}: exit {rc}, wanted {want_rc} with {want_text!r}")
        print("      " + out.replace("\n", "\n      "))
        failures += 1


case("a version inside the interval passes",
     {"a": {"oxlint": "1.90.0"}}, 0, "PASS")
case("a patch of the max minor passes",
     {"a": {"oxlint": "1.90.7"}}, 0, "PASS")
case("a later minor of the max major passes",
     {"a": {"vite": "8.9.0"}}, 0, "PASS")
case("the floor itself passes",
     {"a": {"oxlint": "1.89.0"}}, 0, "PASS")
case("below the floor fails",
     {"a": {"oxlint": "1.88.4"}}, 1,
     "oxlint is 1.88.4 in devDependencies, Aurum Alpha standard is [1.89.0, 1.90]")
case("the minor past max fails",
     {"a": {"oxlint": "1.91.0"}}, 1, "Aurum Alpha standard is [1.89.0, 1.90]")
case("a next major fails",
     {"a": {"vite": "9.0.0"}}, 1, "vite is 9.0.0")
case("a caret inside the interval still fails",
     {"a": {"vite": "^8.4.0"}}, 1, "(a range, not a pin)")
case("min equal to max demands that version",
     {"a": {"@playwright/test": "1.64.2"}}, 1,
     "Aurum Alpha standard is [1.64.1, 1.64.1]")
case("a pinned package moving to its next version admits both",
     {"a": {"@playwright/test": "1.64.1"}, "b": {"@playwright/test": "1.65.0"}},
     0, "PASS",
     data={**RECORD, "devDependencies": {
         "@playwright/test": {"min": "1.64.1", "max": "1.65.0"}}})
case("a lockstep pair at one version passes",
     {"a": {"vitest": "4.1.13", "@vitest/coverage-v8": "4.1.13"}}, 0, "PASS")
case("a lockstep pair split inside the interval fails",
     {"a": {"vitest": "4.1.13", "@vitest/coverage-v8": "4.1.12"}}, 1,
     "must match")
case("each repository moves on its own",
     {"a": {"oxlint": "1.89.0"}, "b": {"oxlint": "1.90.0"}}, 0, "PASS")
case("an interval whose min is above its max is refused",
     {"a": {"oxlint": "1.90.0"}}, 1, "is above max",
     data={**RECORD, "devDependencies": {
         "oxlint": {"min": "1.91.0", "max": "1.90"}}})
case("an entry with an unknown key is refused",
     {"a": {"oxlint": "1.90.0"}}, 1, "an entry is",
     data={**RECORD, "devDependencies": {
         "oxlint": {"min": "1.89.0", "max": "1.90", "below": "2"}}})
case("a bare version string is refused",
     {"a": {"oxlint": "1.90.0"}}, 1, "an entry is",
     data={**RECORD, "devDependencies": {"oxlint": "1.90.0"}})


def raise_case(name, units, want_min, write=True):
    global failures
    with tempfile.TemporaryDirectory() as t:
        tmp = pathlib.Path(t)
        path = record(tmp, RECORD)
        args = ["--root", fleet(tmp, units), "--versions", path]
        rc, out = run(RAISE, *args, *(["--write"] if write else []))
        got = json.loads(path.read_text())["devDependencies"]["oxlint"]["min"]
    if rc == 0 and got == want_min:
        print(f"  ok  {name}")
    else:
        print(f"FAIL  {name}: exit {rc}, oxlint.min {got}, wanted {want_min}")
        print("      " + out.replace("\n", "\n      "))
        failures += 1


raise_case("the floor rises to the lowest version the fleet declares",
           {"a": {"oxlint": "1.90.1"}, "b": {"oxlint": "1.90.0"}}, "1.90.0")
raise_case("one repository at the floor holds it",
           {"a": {"oxlint": "1.90.1"}, "b": {"oxlint": "1.89.0"}}, "1.89.0")
raise_case("a repository that does not declare the package does not hold it",
           {"a": {"oxlint": "1.90.0"}, "b": {"vite": "8.3.5"}}, "1.90.0")
raise_case("without --write the record is left alone",
           {"a": {"oxlint": "1.90.0"}}, "1.89.0", write=False)
raise_case("a fleet past max does not drag the floor there",
           {"a": {"oxlint": "1.91.2"}}, "1.89.0")
raise_case("the floor rises to max, which ends the move",
           {"a": {"oxlint": "1.90.4"}}, "1.90.4")

def image_case(name, tag, want_rc, want_text, spec):
    global failures
    with tempfile.TemporaryDirectory() as t:
        tmp = pathlib.Path(t)
        root = fleet(tmp, {"a": {}})
        (root / "a" / "compose.yaml").write_text(
            f"services:\n  db:\n    image: mysql:{tag}\n")
        rc, out = run(CHECK, "--root", root, "--versions",
                      record(tmp, {**RECORD, "images": {"mysql": spec}}))
    if rc == want_rc and want_text in out:
        print(f"  ok  {name}")
    else:
        print(f"FAIL  {name}: exit {rc}, wanted {want_rc} with {want_text!r}")
        print("      " + out.replace("\n", "\n      "))
        failures += 1


MOVING = {"min": "9.1.0", "max": "9.7.4"}
image_case("an image at its one tag passes", "9.1.0", 0, "PASS", "9.1.0")
image_case("an image off its one tag fails", "9.7.4", 1,
           "mysql is 9.7.4, Aurum Alpha standard is 9.1.0", "9.1.0")
image_case("an image interval admits its floor", "9.1.0", 0, "PASS", MOVING)
image_case("an image interval admits its max", "9.7.4", 0, "PASS", MOVING)
image_case("an image past its interval fails", "9.7.5", 1,
           "Aurum Alpha standard is [9.1.0, 9.7.4]", MOVING)
image_case("an image below its interval fails", "8.4.13", 1,
           "Aurum Alpha standard is [9.1.0, 9.7.4]", MOVING)
image_case("a suffixed tag is outside a version interval", "9.7.4-oracle", 1,
           "Aurum Alpha standard is [9.1.0, 9.7.4]", MOVING)
image_case("an image interval whose min is above its max is refused", "9.1.0",
           1, "is above max", {"min": "9.7.4", "max": "9.1.0"})
image_case("an image interval of a suffixed tag is refused", "9.1.0", 1,
           "of plain versions", {"min": "9.1.0", "max": "9.7.4-oracle"})

# The e2e job runs each @playwright/test release in its own image. Every
# version the record admits at either end of the interval needs a line there,
# or the first repository to move fails in the job rather than here.
REPO = TOOLS.parent
job = (REPO / ".github/workflows/job-test-e2e-playwright.yml").read_text()
table = job.split("PLAYWRIGHT_IMAGES: |", 1)[1].split("\n    steps:", 1)[0]
images = {line.split()[0] for line in table.strip().splitlines()}
spec = json.loads((REPO / "dependency-versions.json").read_text()
                  )["devDependencies"]["@playwright/test"]
missing = sorted({spec["min"], spec["max"]} - images)
if missing:
    print(f"FAIL  job-test-e2e-playwright carries an image for every "
          f"@playwright/test version the record names: missing {missing}")
    failures += 1
else:
    print("  ok  job-test-e2e-playwright carries an image for every "
          "@playwright/test version the record names")

if failures:
    print(f"\nFAIL: {failures} case(s)")
    sys.exit(1)
print("\nPASS")
