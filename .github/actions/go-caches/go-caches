#!/usr/bin/env bash
# go-caches: where a Go job's module and build caches live, and whether the job
# restores the module cache through actions/cache.
#
# Both caches go under RUNNER_TEMP, so concurrent jobs on one self-hosted host
# never share either. A shared build cache would let one repository's job place
# compiled output that another repository then links.
#
# The controller that starts self-hosted runners may put a Go module proxy on
# the LAN in front of them. It then sets GOPROXY to that proxy and
# GHR_GOPROXY=1. A job behind the proxy fetches only the modules it needs, over
# the LAN, so restoring the whole module cache from actions/cache costs more
# than it saves, and the job skips it. Without GHR_GOPROXY=1 (GitHub-hosted
# runners, or a controller without a proxy), actions/cache fills the module
# cache as before.
#
# Inputs (environment):
#   RUNNER_TEMP, GITHUB_ENV, GITHUB_OUTPUT  set by the runner
#   GHR_GOPROXY                             set by the runner controller
set -euo pipefail

: "${RUNNER_TEMP:?}" "${GITHUB_ENV:?}" "${GITHUB_OUTPUT:?}"

mod="${RUNNER_TEMP}/go-mod"
build="${RUNNER_TEMP}/go-build"
mkdir -p "$mod" "$build"
{
  echo "GOMODCACHE=${mod}"
  echo "GOCACHE=${build}"
} >> "$GITHUB_ENV"

if [ "${GHR_GOPROXY:-}" = "1" ]; then
  skip=true
  echo "Module cache: fetched through the LAN proxy at ${GOPROXY:-(GOPROXY unset)}; actions/cache skipped"
else
  skip=false
  echo "Module cache: restored through actions/cache"
fi
echo "skip-mod-cache=${skip}" >> "$GITHUB_OUTPUT"
