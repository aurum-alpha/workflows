#!/usr/bin/env python3
"""Assert a repo's ci.yml obeys CI_STANDARD. This is the gate, not a report.

Every principle below was written down before it was enforced, and every one of
them was violated by at least one repo while the text sat in CI_STANDARD.md
saying otherwise. A principle nobody can fail is a preference. This script is
the difference.

It is deliberately built to run TWO ways from ONE source:

  * `--repo-root .`  — inside a repo's own CI, via job-ci-conformance.yml, so a
    repo cannot drift without its own ci-ok going red. This is the enforcement.
  * `--portfolio DIR`  — across every clone under DIR, for sweeps from a
    workstation. This is the audit.

Rules, each naming the principle it enforces and the incident that proved the
principle needed enforcing:

  P3  fail closed          continue-on-error only where the standard allows it
  P4  standard runner line runs-on goes through vars.RUNNER, or is declared
  P6  concurrency          cancel superseded PR runs, never main
  P18 one workflow         ci.yml is the pipeline; dependabot is the exception
  PIN sha pinning          every action at a 40-hex sha with a # vX.Y.Z comment
  D1  no orphan jobs       every job has needs:, except declared roots and the
                          conformance job, which reads no build output. Build
                          first, fail fast: if it does not compile there is
                          nothing worth linting or testing, so no gate runs
                          beside the build
  D2  no inverted DAG      a build never needs a gate
  D3  publish is gated     a publish job reaches a gate transitively —
                           unless its whole image chain is sourceless
                           (job-image-build with no artifacts:)
  D4  publish is in ci-ok  a publish job outside the rollup fails invisibly
  D5  publish runs on PRs  the main-check goes on the step, never the job
  REL release in the rollup  job-version-release is named in ci-ok's needs,
                          does not need ci-ok, and ci-ok counts it only on a
                          push to the default branch
  D6  every job blocks     every job is NAMED in ci-ok's needs, not merely
                          needs. Distinct from D1: a job can sit correctly
                          downstream of the build and still be absent from the
                          rollup, and then its failure stops nothing
  WD  workdir is a real path  a shared job's workdir input is relative, stays
                          inside the repo, and holds the manifest that job's
                          language reads: package.json for a JS or TS job,
                          composer.json for a PHP one, read off the callee's
                          `language=` declaration
  D8  needs.<id> resolves    every ${{ needs.X.* }} expression names a job that
                          exists and that this job declares in needs:. A rename
                          that updates job ids and needs: lists still leaves
                          these dangling, and the expression silently evaluates
                          to empty rather than failing
  D7  something runs it    a job that builds an image is depended on by a job
                          that runs it. Under the build/starts/publish split the
                          build job never starts anything, so the question is
                          whether anything is downstream of it at all: a staged
                          digest nothing pulls is an image nobody ran. On the
                          starts job, start_blocked_by waives the check and must
                          name the blocker — an empty reason is a boolean
                          wearing a string's clothes. Nothing satisfies this by
                          assertion
  RN  no renamed commands    a job id token (server-go-*, client-ts-*, …) never
                          appears immediately after a tool name in a run: body.
                          Renaming job ids with a whole-word regex also rewrites
                          the shell commands that share the old name — `go build`
                          became `go server-go-build`, which is not a subcommand
                          and fails in zero seconds
  RET uploads state a life   every repo-local actions/upload-artifact declares
                          retention-days. Without one it inherits the repository
                          default of 90 days, and artifact storage is an org-wide
                          quota: when it fills, every repo's uploads fail at once
                          with a red check carrying no log and no output. The
                          rule asserts presence, never a value — 1 day is right
                          for a hand-off between jobs, 90 is right for firmware
                          in a repo with no release pipeline, and only a person
                          can tell those apart
  TRG push is default-only   ci.yml's push: trigger lists only the default
                          branch. A feature-branch push and its pull request are
                          different refs — refs/heads/<b> and refs/pull/<n>/merge
                          — so they fall in different concurrency groups and
                          neither cancels the other. push: ["**"] therefore runs
                          the entire DAG twice per commit for the same answer,
                          which on a starved runner pool is the whole cost
  CM  CI does not commit      no step pushes to the repository under test.
                          A generated file committed back by CI is always one
                          build behind — the artifact was built before the file
                          existed — and the commit is invariably [skip ci], so
                          the version it carries is never built at all. Generate
                          it into the build output instead
  RU  one rollup             ci-ok's body is the shared composite action, not a
                          copy of it. The needs: list is the repo's own DAG and
                          stays in the repo; the fifteen lines that decide what
                          `failure` and `cancelled` mean had drifted three ways
                          across eleven repos before this rule existed. Passes
                          toJSON(needs), not toJSON(needs.*.result) — the
                          flattened form cannot name which job failed
  DECL a catalog job declares what it is  a caller reaching a catalog
                          workflow that carries no `# aurum-job:` line is
                          reported, never absorbed: with no declaration the
                          role rules have nothing to say, and a rule with
                          nothing to say is indistinguishable from one that
                          passed
  ROLE what a job IS comes from the catalog workflow it calls, read off that
                          workflow's own `# aurum-job:` declaration. A job
                          calling nothing has no role and no DAG obligations —
                          it is repo-specific, and the standard did not define
                          it
  IN  caller inputs exist      every key under `with:` is an input the shared
                          job declares, and every required input is passed.
                          GitHub rejects the whole FILE at startup for a
                          misspelled or missing input — zero jobs, no logs,
                          and actionlint cannot see it because the callee
                          lives in another repository
  PERM caller grant covers callee  a called workflow can never hold more than
       the job calling it — exceed it and GitHub rejects the whole FILE at
       startup: zero jobs, no logs, and actionlint sees nothing wrong. A caller
       that declares nothing is reported too, but as what it is: reliance on the
       repository default, which the file cannot show and an org setting can
       revoke from every caller at once

Nothing here reads meaning out of a job id. Four regexes used to — ROOT_RE,
BUILD_RE, GATE_RE and PUBLISH_RE — and they were unsound in both directions. A
job named `pub` calling job-image-publish escaped D3, D4 and D5 entirely,
because none of the four magic words appeared in it; a PHP repo's `package`,
which lays a vendor tree into a dist directory, was failed as an ungated
publish. The `uses:` line names the exact workflow a job runs, which settles
the question the regexes were estimating.

Whether a job id is well FORMED is a separate rule and not yet written: the
grammar <purpose>-<language>[-<framework>][-<product>]-<capability>[-<tool>]
is what makes ids legible in tooling outside CI, and the declarations this now
reads are what will let it be checked against the job actually called.

Exit: 0 conformant, 1 violations, 2 no ci workflow found.
"""

import argparse
import difflib
import os
import pathlib
import re
import sys

CI_NAMES = ("ci.yml", "ci.yaml")
# Dependabot's config is not a pipeline and cannot be gated by ci-ok, because
# it is not a workflow run.
ALLOWED_OTHER_WORKFLOWS = {"dependabot.yml", "dependabot.yaml"}


def is_library(path: pathlib.Path) -> bool:
    """A workflow whose only trigger is workflow_call is a library.

    Principle 18 is about pipelines: a second *pipeline* cannot be gated by
    ci-ok, so nothing stops it publishing from a commit that failed. A reusable
    workflow has no trigger of its own — it only ever runs as a job inside the
    caller's pipeline, gated by the caller's ci-ok. The shared job catalog in
    this very repo is thirteen such files, so a filename allowlist would have
    called the standard's own home the worst offender in the portfolio.
    """
    lines = path.read_text().splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if re.match(r"^on:\s*$", ln))
    except StopIteration:
        return False
    triggers = set()
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith(" "):
            break  # dedent out of the on: block
        m = re.match(r"^  ([\w-]+):", ln)
        if m:
            triggers.add(m.group(1))
    return triggers == {"workflow_call"}


def defines_catalog(repo: pathlib.Path) -> bool:
    """This tree DEFINES shared jobs rather than calling them.

    The one exemption ADOPT needs, and it is a property of the tree rather than
    a repository's name. A repo holding reusable workflows is the catalog; its
    own ci.yml gates those definitions and cannot be a stub of them.

    It replaces a hardcoded list of adopting repositories, which reached the
    same answer for the catalog and the wrong answer for everyone else. Such a
    list can only be redundant — a repo that calls job-ci-conformance.yml has
    adopted the check by calling it — or wrong, when a caller absent from the
    list silently gets ADOPT skipped after asking to be checked. The second
    case was live, and it fails the quiet way: the rules are not reported and
    not failed, they simply do not run.

    Debt is the caller's to declare, through the job's warn_only input, in its
    own ci.yml. It is not something this repository knows about anyone.

    is_library() and D6 are the same move: P18 refused a filename allowlist
    because it would have named the catalog its own worst offender, and D6
    retired OUTSIDE_ROLLUP for a structural test so there was no second list to
    forget. This is the third and last of them.
    """
    wf = repo / ".github" / "workflows"
    if not wf.is_dir():
        return False
    return any(is_library(p) for p in sorted(wf.glob("*.y*ml")))


# What a job IS comes from the catalog workflow it calls, never from its id.
#
# Every rule below that needs to know a job's kind — is it a build, a gate, a
# thing that publishes — used to read the letters in the job id and guess:
#
#   ROOT_RE     ^(changes|create-docker-.*-image|(...)*(mod|build|install|composer))$
#   BUILD_RE    (^|-)(build|install|composer)$
#   GATE_RE     (lint|typecheck|test|vet|gofmt|prettier|analysis|scanner|check|audit)
#   PUBLISH_RE  (publish|release|package|image)
#
# All four are gone, and each was wrong in a way the next one could not fix.
# BUILD_RE could not see that `image-build` packages rather than compiles, so
# PUBLISH_RE had to be subtracted from it. PUBLISH_RE matched a PHP repo's
# `package` — a vendor tree laid into a dist directory — and demanded gates it
# had already moved elsewhere. GATE_RE matched `gofmt` but not `fmt`, so the
# one Go repo obeying the naming rule had a gate the checker could not see. And
# none of them could tell a repo's own job from a catalog one, which is how a
# name-keyed waiver list came to exist to say "not that one".
#
# The evidence was there the whole time: `uses:` names the exact workflow the
# job runs. A job calling job-image-publish.yml IS a publish. One calling
# job-go-build.yml IS a build. The checker was guessing while holding the
# answer, and two rules had already worked this out for themselves — the
# conformance job's D1 exemption and the prune's D6 exemption both match on the
# shared job called, "rather than by a name pattern that would also catch a
# repo's own job".
#
# So each catalog job declares what it is, on its first line:
#
#     # aurum-job: capability=build language=go role=build
#
# and this reads that declaration out of the catalog clone. A job whose `uses:`
# names no catalog workflow has NO role: it is repo-specific, the standard did
# not define it, and no rule here infers anything about it.
#
# The roles, and what each one costs the job that carries it:
#
#   build      a source build. May be a graph root (D1). Must not wait on a
#              gate (D2). Does not itself satisfy D3.
#   root       comes first and compiles nothing — dependency resolution. May be
#              a graph root; nothing else.
#   gate       proves something about the SOURCE. Satisfies D3, and a build
#              that waits on one fails D2.
#   policy     proves something about the REPO'S CONFIGURATION rather than the
#              artifact. May be a graph root, because it reads no build output.
#              Deliberately does NOT satisfy D3: conformance and the version
#              gate say nothing about the bytes being published.
#   publish    emits or promotes an artifact. D3, D4 and D5 apply.
#   stage      assembles or runs a candidate artifact, held by digest under no
#              tag. It needs the builds that produced its inputs and nothing
#              else, so it runs beside the gates instead of after them. D4 and
#              D5 apply. D3 does not: the publish that tags the candidate is
#              what must reach a gate.
#   toolchain  builds what other jobs run inside. A graph root, and not a
#              product, so D3's premise does not reach it.
#   none       no DAG obligations either way.
DECL_RE = re.compile(
    r"^#\s*aurum-job:\s*capability=(?P<capability>\S+)\s+"
    r"language=(?P<language>\S+)\s+role=(?P<role>\S+)\s*$"
)
ROOT_ROLES = {"build", "root", "policy", "toolchain"}
_DECL_CACHE: dict[str, dict[str, str] | None] = {}


class Undeclared(str):
    """A catalog job that is there but says nothing about itself.

    Distinct from None, and the distinction is the whole guard. None means the
    job calls no catalog workflow — repo-specific, and correctly roleless. This
    means the workflow was found and carries no `# aurum-job:` line, which is
    not a fact about the caller at all: it is this checker unable to answer, and
    it must never read as "no obligations".

    It exists because the alternative was measured, not imagined. The change
    that introduced roles first landed the declarations and the reader in one
    commit. The declarations are resolved against the CATALOG LISTING clone,
    which catalog_roots() deliberately leaves unpinned, so that clone is the
    default branch — which on that pull request did not have them yet. Every
    role came back None, D1 through D5 had nothing to say, and the conformance
    job went green on a checker its own change had just disabled. Locally it
    passed for the opposite reason: with no AURUM_CATALOG_ROOT set the fallback
    is the checker's own repo root, which did have them. Two trees, two answers,
    and the green one was the lie.

    catalog_dir() carries the same lesson one level up — "Split out from
    catalog_inputs so a MISSING FILE can be told apart from a MISSING CATALOG.
    Conflating them is what let job-go-gofmt.yml through." A silent rule and a
    satisfied rule look identical, so anything that cannot answer says so.
    """


CATALOG_USES_RE = re.compile(
    r"([\w.-]+)/([\w.-]+)/\.github/workflows/([\w.-]+\.ya?ml)@"
)


def catalog_target(uses: str) -> str | None:
    """`<repo>/<file.yml>` for a call into the catalog, else None.

    One parse of `uses:`, shared by the declaration reader and rule ID, so the
    two can never disagree about what counts as a catalog call.

    A local path — `./.github/workflows/x.yml`, which is how the catalog calls
    its own jobs — does not match, and that is deliberate rather than an
    oversight: see rule ID for what it means and why it is not papered over.
    """
    m = CATALOG_USES_RE.match(uses.strip())
    if not m or m.group(1) != CATALOG_OWNER:
        return None
    return f"{m.group(2)}/{m.group(3)}"


def catalog_declaration(uses: str) -> dict[str, str] | Undeclared | None:
    """The `# aurum-job:` declaration of the catalog workflow this job calls.

    None when the job calls nothing or calls a third party — no role, and no
    rule keyed on role does anything with it.

    Undeclared when the catalog workflow was found and carries no declaration.
    Rule DECL reports that; no DAG rule reads a role from it.

    A catalog file the clone does not carry is left to rule CAT, which already
    reports it with the catalog listing it searched.
    """
    key = catalog_target(uses)
    if key is None:
        return None
    repo_name, fname = key.split("/", 1)
    if key in _DECL_CACHE:
        return _DECL_CACHE[key]
    found = None
    for root in catalog_roots(repo_name):
        f = root / ".github/workflows" / fname
        if not f.is_file():
            continue
        found = Undeclared(fname)
        for line in f.read_text().splitlines()[:5]:
            d = DECL_RE.match(line)
            if d:
                found = d.groupdict()
            break
        break
    _DECL_CACHE[key] = found
    return found


def role_of(props: dict) -> str | None:
    d = catalog_declaration(props.get("uses", ""))
    return d["role"] if isinstance(d, dict) else None


