    { "id": "uuidv7-rejects-uppercase", "def": "uuidv7", "value": "01923E8A-7F4E-7CC3-9A2B-3F8D2C1B0A99", "valid": false, "note": "wire form is lowercase; one canonical string so byte equality is id equality (IP3)" },
    { "id": "uuidv7-rejects-unhyphenated", "def": "uuidv7", "value": "01923e8a7f4e7cc39a2b3f8d2c1b0a99", "valid": false, "note": "canonical hyphenated form only (IP2)" },
    { "id": "nanoid-ok", "def": "nanoid", "value": "V1StGXR8_Z5jdHi6B-my", "valid": true },
