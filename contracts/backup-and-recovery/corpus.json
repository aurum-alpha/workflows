{
  "contract": "backup-and-recovery",
  "schemaVersion": 1,
  "description": "The conformance corpus for standards/028-backup-and-recovery.md. Three parts. 'declarations' is judged by recovery-declaration.schema.json plus four arithmetic relations the schema cannot express and a runner checks, each named in the case that exercises it: retention.floor <= retention.ceiling, retention.ceiling <= erasure_horizon, drill.cadence <= retention.floor, drill.cadence <= drill.stale_after; a case is accepted or rejected, and a rejection names its rule. 'ledger' is judged by erasure-ledger.schema.json alone. 'drills' is judged by running a recovery implementation and has three scenarios: 'freshness' gives the drill's cadence and staleness threshold, the first copy's instant and the drill's run records, and expects whether the store is stale and whether a deployment proceeds (BR4); 'objectives' gives the declared RPO and RTO and the drill's instants and expects the achieved values and the drill's outcome (BR4 step 6); 'restore' gives a copy with its as_of, rows, audit events and restored ledger table, the release's schema version and the ledger's copy from the backup domain, and expects the state at readiness and after (BR6, BR7). Two cases are detectors: 'restore-then-replay-leaves-erased-rows-absent' fails an implementation that reads the ledger from the restored table, and 'erased-rows-are-absent-at-readiness-not-only-afterwards' fails an implementation that reports ready before replay.",
  "declarations": [
    {
      "case": "a-relational-primary-store-under-pitr",
      "valid": true,
      "why": "BR1 and BR2 in full for the common case: a primary relational store under point-in-time recovery, objectives declared, encrypted, in a separate region and account, retained between a floor and a ceiling within the erasure horizon, drilled weekly with a query and readiness.",
      "declaration": {
        "schema_version": 1,
        "service": "invoicing",
        "erasure_horizon": "P90D",
        "runbook": "docs/operations/recovery.md",
        "stores": [
          {
            "name": "invoicing-db",
            "kind": "relational",
            "role": "primary",
            "rpo": "PT15M",
            "rto": "PT2H",
            "mechanism": "pitr",
            "encrypted": true,
            "failure_domain": "region_and_account",
            "retention": {
              "floor": "P30D",
              "ceiling": "P90D"
            },
            "drill": {
              "cadence": "P7D",
              "stale_after": "P14D"
            },
            "verification": [
              {
                "check": "query",
                "sql": "SELECT 1 FROM invoices WHERE tenant_id IS NOT NULL LIMIT 1",
                "min_rows": 1
              },
              {
                "check": "readiness"
              }
            ]
          }
        ]
      }
    },
