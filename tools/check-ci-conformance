def workflow_permissions(text: str) -> dict[str, str]:
    """The workflow-level permissions block, which is the default every job gets."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if re.match(r"^permissions:\s*$", ln))
    except StopIteration:
        return {}
    out = {}
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith(" "):
            break
        m = re.match(r"^  ([\w-]+):\s*(\S+)", ln)
        if m:
            out[m.group(1)] = m.group(2)
    return out


CONCURRENCY_EXPECTED = "cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}"


def find_ci(repo: pathlib.Path) -> pathlib.Path | None:
    for n in CI_NAMES:
        p = repo / ".github" / "workflows" / n
        if p.is_file():
            return p
    return None


def parse_jobs(text: str) -> dict[str, dict[str, str]]:
    """job id -> {key: raw value}, folding block sequences into their key."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:")
    except StopIteration:
        return {}
    jobs: dict[str, dict[str, str]] = {}
    cur = key = None
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith("  "):
            break
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            cur, key = m.group(1), None
            jobs[cur] = {}
            continue
        m = re.match(r"^    ([\w-]+):\s*(.*)$", ln)
        if m and cur is not None:
            key = m.group(1)
            jobs[cur][key] = m.group(2).strip()
            continue
        # Continuation lines: block-sequence items, or a folded scalar's body.
        if cur is not None and key is not None and ln.startswith("      "):
            jobs[cur][key] += " " + ln.strip().lstrip("- ")
    return jobs


def needs_of(props: dict[str, str]) -> set[str]:
    return set(re.findall(r"[\w-]+", props.get("needs", "")))


def ancestors(job: str, graph: dict[str, set[str]]) -> set[str]:
    seen: set[str] = set()
    stack = list(graph.get(job, ()))
    while stack:
        n = stack.pop()
        if n in seen or n not in graph:
            continue
        seen.add(n)
        stack.extend(graph[n])
    return seen


def sourceless_image_builds(text: str) -> set[str]:
    """Callers of job-image-build that pass no artifacts: input.

    D3 exists for artifact provenance: an image that COPYs a binary or a
    dist/ this repo built must sit downstream of the gates that tested that
    code, or a green publish ships code nothing looked at. `artifacts:` is
    where that provenance enters the image job — and when a caller passes
    none, the image contains no repo-built code at all. It is a Dockerfile
    over an upstream base: it either builds or it does not, and any
    assertions worth making about it belong in the Dockerfile as RUN steps,
    where a failure already fails the build (the runner image checks
    `docker compose version` and `node --version` exactly this way). There
    is no gate a chain like that could reach, because there is nothing in
    it a gate could have tested.

    Detection reads the raw job blocks rather than parse_jobs(): that parser
    folds every 6-space line into the preceding key, comments included, so a
