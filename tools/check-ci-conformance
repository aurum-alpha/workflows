#!/usr/bin/env python3
"""Assert a repo's ci.yml obeys CI_STANDARD. This is the gate, not a report.

Every principle below was written down before it was enforced, and every one of
them was violated by at least one repo while the text sat in CI_STANDARD.md
saying otherwise. A principle nobody can fail is a preference. This script is
the difference.

It is deliberately built to run TWO ways from ONE source:

  * `--repo-root .`  — inside a repo's own CI, via job-ci-conformance.yml, so a
    repo cannot drift without its own ci-ok going red. This is the enforcement.
  * `--fleet DIR`    — across every clone under DIR, for sweeps from a
    workstation. This is the audit.

Rules, each naming the principle it enforces and the incident that proved the
principle needed enforcing:

  P3  fail closed          continue-on-error only where the standard allows it
  P4  standard runner line runs-on goes through vars.RUNNER, or is declared
  P6  concurrency          cancel superseded PR runs, never main
  P18 one workflow         ci.yml is the pipeline; dependabot is the exception
  PIN sha pinning          every action at a 40-hex sha with a # vX.Y.Z comment
  D1  no orphan jobs       every job has needs:, except declared roots and the
                          conformance job, which reads no build output. Build
                          first, fail fast: if it does not compile there is
                          nothing worth linting or testing, so no gate runs
                          beside the build
  D2  no inverted DAG      a build never needs a gate
  D3  publish is gated     a publish job reaches a gate transitively
  D4  publish is in ci-ok  a publish job outside the rollup fails invisibly
  D5  publish runs on PRs  the main-check goes on the step, never the job
  D6  every job blocks     every job is NAMED in ci-ok's needs, not merely
                          needs. Distinct from D1: a job can sit correctly
                          downstream of the build and still be absent from the
                          rollup, and then its failure stops nothing
  WD  workdir is a shape       a JS shared job's workdir input is `.` or
                          `client` and nothing else. It distinguishes two real
                          repo shapes; it is not a per-repo path setting
  D8  needs.<id> resolves    every ${{ needs.X.* }} expression names a job that
                          exists and that this job declares in needs:. A rename
                          that updates job ids and needs: lists still leaves
                          these dangling, and the expression silently evaluates
                          to empty rather than failing
  D7  something runs it    a job that builds an image is depended on by a job
                          that runs it. Under the build/starts/publish split the
                          build job never starts anything, so the question is
                          whether anything is downstream of it at all: a staged
                          digest nothing pulls is an image nobody ran. On the
                          starts job, start_blocked_by waives the check and must
                          name the blocker — an empty reason is a boolean
                          wearing a string's clothes. Nothing satisfies this by
                          assertion
  RN  no renamed commands    a job id token (server-go-*, client-ts-*, …) never
                          appears immediately after a tool name in a run: body.
                          Renaming job ids with a whole-word regex also rewrites
                          the shell commands that share the old name — `go build`
                          became `go server-go-build`, which is not a subcommand
                          and fails in zero seconds
  TRG push is default-only   ci.yml's push: trigger lists only the default
                          branch. A feature-branch push and its pull request are
                          different refs — refs/heads/<b> and refs/pull/<n>/merge
                          — so they fall in different concurrency groups and
                          neither cancels the other. push: ["**"] therefore runs
                          the entire DAG twice per commit for the same answer,
                          which on a starved runner pool is the whole cost
  CM  CI does not commit      no step pushes to the repository under test.
                          A generated file committed back by CI is always one
                          build behind — the artifact was built before the file
                          existed — and the commit is invariably [skip ci], so
                          the version it carries is never built at all. Generate
                          it into the build output instead
  RU  one rollup             ci-ok's body is the shared composite action, not a
                          copy of it. The needs: list is the repo's own DAG and
                          stays in the repo; the fifteen lines that decide what
                          `failure` and `cancelled` mean had drifted three ways
                          across eleven repos before this rule existed. Passes
                          toJSON(needs), not toJSON(needs.*.result) — the
                          flattened form cannot name which job failed
  N1  the language token is true  a stub calling job-go-* has 'go' in position 2
  IN  caller inputs exist      every key under `with:` is an input the shared
                          job declares, and every required input is passed.
                          GitHub rejects the whole FILE at startup for a
                          misspelled or missing input — zero jobs, no logs,
                          and actionlint cannot see it because the callee
                          lives in another repository
  PERM caller grant covers callee  a called workflow can never hold more than
       the job calling it — exceed it and GitHub rejects the whole FILE at
       startup: zero jobs, no logs, and actionlint sees nothing wrong. A caller
       that declares nothing is reported too, but as what it is: reliance on the
       repository default, which the file cannot show and an org setting can
       revoke from every caller at once

N1 checks the LANGUAGE token and nothing else, because the language is all a
`uses:` line can prove. Purpose and framework are review-only: no line in the
file says whether a job serves the client or the server, and assuming otherwise
is precisely what renamed six repos' `build` to `react-build` when it compiles
both a React client and an Express server. Repo-local jobs are invisible to N1
for the same reason.

Exit: 0 conformant, 1 violations, 2 no ci workflow found.
"""

import argparse
import difflib
import pathlib
import re
import sys

CI_NAMES = ("ci.yml", "ci.yaml")
# Dependabot's config is not a pipeline and cannot be gated by ci-ok, because
# it is not a workflow run.
ALLOWED_OTHER_WORKFLOWS = {"dependabot.yml", "dependabot.yaml"}


def is_library(path: pathlib.Path) -> bool:
    """A workflow whose only trigger is workflow_call is a library.

    Principle 18 is about pipelines: a second *pipeline* cannot be gated by
    ci-ok, so nothing stops it publishing from a commit that failed. A reusable
    workflow has no trigger of its own — it only ever runs as a job inside the
    caller's pipeline, gated by the caller's ci-ok. The shared job catalog in
    this very repo is thirteen such files, so a filename allowlist would have
    called the standard's own home the worst offender in the fleet.
    """
    lines = path.read_text().splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if re.match(r"^on:\s*$", ln))
    except StopIteration:
        return False
    triggers = set()
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith(" "):
            break  # dedent out of the on: block
        m = re.match(r"^  ([\w-]+):", ln)
        if m:
            triggers.add(m.group(1))
    return triggers == {"workflow_call"}

# A graph root is the first node of a stack, or the change-detection job the
# rest keys off. Matched by SHAPE, not by an enumerated list of names: the list
# version hardcoded `build`, `web-build`, `go-mod` and friends, so the moment a
# repo renamed `build` to `react-build` — obeying N1 — the checker called its
# own standard a violation. Enumerating names is how a checker acquires the
# drift it exists to prevent. The prefix repeats — `([a-z0-9]+-)*` — because a
# job id carries purpose, language and framework before the capability, and an
# earlier version allowed exactly one segment, so `client-ts-react-build` read
# as an orphan the first time a real three-token id appeared.
ROOT_RE = re.compile(
    r"^(changes|create-docker-[\w-]+-image"
    r"|([a-z0-9]+-)*(mod|build|install(-prod)?))$"
)
BUILD_RE = re.compile(r"(^|-)(build|install)$")
GATE_RE = re.compile(r"(lint|typecheck|test|vet|gofmt|prettier|analysis|scanner|check|audit)")
PUBLISH_RE = re.compile(r"(publish|release|package|image)")
REPORTING_RE = re.compile(r"risk$")

# Names that trip PUBLISH_RE without producing a product artifact. Ungated is
# correct for each, for a different reason:
#   *-parity        asserts pins match across files; a gate, not a build
#   create-*-image  the CI toolchain image every other job runs inside, so by
#                   construction upstream of every gate
#   runner-image    a base image plus packages, sharing no source with the
#                   repo's code — there is nothing here to gate it on
NOT_A_PRODUCT_RE = re.compile(r"parity$|^create-docker-[\w-]+-image$|^runner-image$")

# A shared job proves the LANGUAGE of the source it runs against, and nothing
# more. job-go-vet can only be pointed at Go; job-node-lint can only be pointed
# at TypeScript/JavaScript.
#
# It does NOT prove the purpose or the framework. The first version of this rule
# assumed it did — "calls job-node-* therefore it is React" — and renamed six
# repos' `build` to `react-build` when that job compiles a React client AND an
# Express server from one command. hiring-tracker's `react-test-unit` ran
# fourteen server tests and zero client tests. The toolchain is not the codebase.
#
# So this checks the language token only: position two of the caller's id.
LANGUAGE_OF_SHARED_JOB = {
    "job-go-": "go",
    "job-node-": "ts",
    "job-ts-": "ts",
    "job-php-": "php",
}
# Jobs that act on no single codebase take no prefix: their bare name is the
# information, saying "this one spans the repo".
SPANS_REPO = {
    "ci-ok", "changes", "image", "package", "release", "test-e2e",
    "runner-image", "contract", "image-tag-parity", "osv-scanner",
    "release-risk", "package-deb", "package-image",
}

MAIN_GATE_RE = re.compile(
    r"refs/heads/main|is_default_branch|event_name\s*==\s*'push'"
)

# What each shared job asks for, so a caller's grant can be checked against it.
# This lived in a separate tool that had to be REMEMBERED, and the Phase F one-box
# run failed its first attempt because it was not. A checker you must remember to run is
# the same failure mode as a rule nobody enforces — so it moves in here, where
# every repo's own CI runs it.
CALLEE_NEEDS = {
    "job-image-docker": {"packages": "write"},
    "job-docker-image": {"packages": "write"},
    "job-image-cached": {"packages": "write"},
    # The split: build stages a digest on every run, publish promotes on main,
    # prune deletes. Only starts is read-only, which is the point of splitting —
    # the combined job took write on every pull request in the fleet so that one
    # main-only step inside it could push.
    "job-image-build": {"packages": "write"},
    "job-image-starts": {"packages": "read"},
    "job-image-publish": {"packages": "write"},
    "job-image-prune": {"packages": "write"},
    "job-release-risk": {"pull-requests": "write"},
}
PERM_RANK = {"none": 0, "read": 1, "write": 2}


def workflow_permissions(text: str) -> dict[str, str]:
    """The workflow-level permissions block, which is the default every job gets."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if re.match(r"^permissions:\s*$", ln))
    except StopIteration:
        return {}
    out = {}
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith(" "):
            break
        m = re.match(r"^  ([\w-]+):\s*(\S+)", ln)
        if m:
            out[m.group(1)] = m.group(2)
    return out


CONCURRENCY_EXPECTED = "cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}"


def find_ci(repo: pathlib.Path) -> pathlib.Path | None:
    for n in CI_NAMES:
        p = repo / ".github" / "workflows" / n
        if p.is_file():
            return p
    return None


def parse_jobs(text: str) -> dict[str, dict[str, str]]:
    """job id -> {key: raw value}, folding block sequences into their key."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:")
    except StopIteration:
        return {}
    jobs: dict[str, dict[str, str]] = {}
    cur = key = None
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith("  "):
            break
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            cur, key = m.group(1), None
            jobs[cur] = {}
            continue
        m = re.match(r"^    ([\w-]+):\s*(.*)$", ln)
        if m and cur is not None:
            key = m.group(1)
            jobs[cur][key] = m.group(2).strip()
            continue
        # Continuation lines: block-sequence items, or a folded scalar's body.
        if cur is not None and key is not None and ln.startswith("      "):
            jobs[cur][key] += " " + ln.strip().lstrip("- ")
    return jobs


def needs_of(props: dict[str, str]) -> set[str]:
    return set(re.findall(r"[\w-]+", props.get("needs", "")))


def ancestors(job: str, graph: dict[str, set[str]]) -> set[str]:
    seen: set[str] = set()
    stack = list(graph.get(job, ()))
    while stack:
        n = stack.pop()
        if n in seen or n not in graph:
            continue
        seen.add(n)
        stack.extend(graph[n])
    return seen


def check(repo: pathlib.Path) -> tuple[list[str], str | None]:
    ci = find_ci(repo)
    if ci is None:
        return [], None
    text = ci.read_text()
    jobs = parse_jobs(text)
    graph = {j: needs_of(p) for j, p in jobs.items()}
    rollup = graph.get("ci-ok", set())

    # "Gates hang off the build" presumes a build. A repo that compiles nothing
    # — this one checks yaml — has no such node, and its gates are the roots.
    has_build = any(BUILD_RE.search(j) for j in jobs)
    wf_perms = workflow_permissions(text)
    out: list[str] = []

    def bad(rule, msg):
        out.append(f"[{rule}] {msg}")

    # --- P18: ci.yml is the pipeline -------------------------------------
    wf_dir = repo / ".github" / "workflows"
    if wf_dir.is_dir():
        extra = sorted(
            p.name
            for p in wf_dir.iterdir()
            if p.suffix in (".yml", ".yaml")
            and p.name not in CI_NAMES
            and p.name not in ALLOWED_OTHER_WORKFLOWS
            and not is_library(p)
        )
        for name in extra:
            bad("P18", f"{name} sits outside ci.yml — nothing gates it, nothing reviews it")

    # --- P6: concurrency --------------------------------------------------
    if "concurrency:" not in text:
        bad("P6", "no concurrency block")
    elif CONCURRENCY_EXPECTED not in text:
        found = re.search(r"cancel-in-progress:\s*(.+)", text)
        bad(
            "P6",
            f"cancel-in-progress is {found.group(1).strip() if found else 'unset'}; "
            "main runs publish, and a cancelled run is not a failed one",
        )

    # --- TRG: push fires on the default branch only -----------------------
    # hiring-tracker carried push: ["**"] and so ran two full pipelines for
    # every feature-branch commit: one for refs/heads/<branch>, one for
    # refs/pull/<n>/merge. Different refs mean different concurrency groups, so
    # they did not cancel each other and both ran to completion.
    m_on = re.search(r"^on:\s*$(.*?)^\S", text, re.M | re.S)
    if m_on:
        m_push = re.search(r"^  push:\s*$\n((?:^    .*$\n)*)", m_on.group(1), re.M)
        if m_push:
            br = re.search(r"^    branches:\s*(.+?)\s*$", m_push.group(1), re.M)
            listed = br.group(1) if br else ""
            if "**" in listed or "*" == listed.strip("[]\"' "):
                bad("TRG", f"push: branches: {listed} runs the whole DAG a second time on "
                           "every feature-branch commit — the pull_request run already "
                           "covers it, and the two never cancel each other")

    # --- PIN: sha-pinned actions with a version comment -------------------
    for m in re.finditer(r"uses:\s*([\w.-]+/[^@\s]+)@([^\s#]+)[ \t]*(#.*)?$", text, re.M):
        action, ref, comment = m.group(1), m.group(2), m.group(3)
        if not re.fullmatch(r"[0-9a-f]{40}", ref):
            bad("PIN", f"{action}@{ref} is not a 40-hex sha — tags are mutable pointers")
        elif not comment or not re.match(r"#\s*v", comment.strip()):
            bad("PIN", f"{action}@{ref[:8]} has no trailing '# vX.Y.Z' comment")

    # --- RU: the rollup is shared, not copied ----------------------------
    # ci-ok is the one job every repo has and the one job none of them called
    # from the catalog, because a reusable workflow would rename the check to
    # `ci-ok / ok` and break branch protection in eleven places at once. A
    # composite action runs inside the caller's job, so the name survives and
    # only the body is shared.
    if "ci-ok" in jobs:
        rollup_blob = job_block(text, "ci-ok")
        shared = re.search(
            r"uses:\s*(?:\./\.github/actions/ci-ok\b"
            r"|aurum-alpha/workflows/\.github/actions/ci-ok@)",
            rollup_blob,
        )
        if not shared:
            bad("RU", "ci-ok does not use the shared ci-ok action — its rollup is a local copy")
        elif "toJSON(needs.*.result)" in rollup_blob:
            bad("RU", "ci-ok passes toJSON(needs.*.result); the flattened form cannot name the failing job")
        elif "toJSON(needs)" not in rollup_blob:
            bad("RU", "ci-ok does not pass needs_json: ${{ toJSON(needs) }}")
        # Only for the REMOTE form. The action reads inputs.needs_json and no
        # repository file, and the runner fetches an `owner/repo/path@ref`
        # action itself, so a checkout provides nothing. What it does provide
        # is a dependency on a token: the correct grant for this job is
        # `permissions: {}`, which leaves none, and the checkout then fails
        # outright against a private repository. gha-runner-controller failed
        # exactly that way with "Repository not found", while the identical
        # line passed on gofast because gofast is public — a step that works
        # only while a repo stays public is what this checker exists to name.
        #
        # The local path form `./.github/actions/ci-ok` is the exception and
        # needs its checkout: a local action has to be in the workspace. Only
        # this repository uses it, so that the action is gated by the same run
        # that ships it. Written as a carve-out rather than a looser regex,
        # because the first version of this rule flagged that legitimate case
        # and would have had the catalog fail its own gate.
        uses_remote = re.search(r"uses:\s*[\w.-]+/[\w.-]+/\.github/actions/ci-ok@", rollup_blob)
        if shared and uses_remote and "actions/checkout@" in rollup_blob:
            bad("RU", "ci-ok checks out the repo — the shared action reads no "
                      "file, and with permissions: {} the checkout has no token, "
                      "so it fails on a private repo")

    # --- P3 / P4 / D*: per job -------------------------------------------
    for job, props in sorted(jobs.items()):
        blob = job_block(text, job)

        if job != "ci-ok":
            # Build first, fail fast. A gate running beside the build burns a
            # runner on code that does not compile, and reports its own failure
            # instead of the one that caused it.
            #
            # The conformance job is the one gate that reason does not reach:
            # it reads ci.yml and package.json, never a build output, so a
            # broken build makes its verdict no less true. Gating it on the
            # build would mean a repo whose code does not compile never learns
            # its CI is nonconformant — the check least able to wait, waiting.
            # Matched by the shared job it calls, like the prune below, rather
            # than by a name pattern that would also catch a repo's own job.
            is_conformance = "job-ci-conformance" in props.get("uses", "")
            if has_build and not graph[job] and not ROOT_RE.match(job) \
                    and not is_conformance:
                bad("D1", f"'{job}' has no needs: — it runs beside the build it should gate")

            # Separate property: having a needs: puts a job in the right place
            # in the DAG; being NAMED IN ci-ok's needs is what makes its failure
            # block anything. A job can satisfy D1 and still stop nothing.
            #
            # DIRECT membership, not the transitive closure, and the difference
            # is the whole rule. ci-ok is `if: always()`, which opts it out of
            # needs meaning "must succeed" — it runs whatever its dependencies
            # did, and decides by counting "failure" and "cancelled" in the
            # needs object. A job it does not name has no entry in that object.
            # When a job fails, everything downstream of it is SKIPPED, and
            # skipped is neither failure nor cancelled, so a rollup naming only
            # the leaves of a chain counts zero of each and prints "All
            # dependencies succeeded" over a build that did not.
            #
            # Transitive reachability would accept exactly that shape: the
            # failing job is still reachable, and still invisible. The rollup
            # must name every job that can report a failure, which is every job
            # in the file — see rule D4, which is this same hole found once, for
            # publish alone, the hard way.
            # The prune is the one job deliberately outside the rollup:
            # housekeeping that fails says nothing about the commit, and a merge
            # blocked on a registry API hiccup is worse than a week of extra
            # blobs. Exempt by name, not by inference — and it must sit
            # downstream of ci-ok, so it cannot run before the gates pass.
            is_prune = "job-image-prune" in props.get("uses", "")
            if "ci-ok" in jobs and job not in rollup and not is_prune:
                bad("D6", f"'{job}' is not named in ci-ok's needs — the rollup "
                          "cannot see it fail")
            if is_prune and "ci-ok" not in graph[job]:
                bad("D6", f"'{job}' prunes the registry but does not need ci-ok — "
                          "housekeeping must not run ahead of the gates")

            # `image-build` ends in -build and is not one. D2 says a build never
            # needs a gate — build first, fail fast — and that is about SOURCE
            # builds, which compile something and must come before anything is
            # spent testing it. An image build compiles nothing: it packages
            # artifacts the source builds already produced, which is why it is
            # the convergence point every gate hangs off. PUBLISH_RE is exactly
            # the set of jobs that package rather than compile.
            if BUILD_RE.search(job) and not PUBLISH_RE.search(job):
                inv = sorted(n for n in graph[job] if GATE_RE.search(n) and not BUILD_RE.search(n))
                if inv:
                    bad("D2", f"'{job}' is a build but needs gate(s): {', '.join(inv)}")

            uses = props.get("uses", "")
            props["__with_raw__"] = with_block(text, job)

            # --- CAT: the shared workflow file actually exists --------------
            # A pin naming a file that is not there is a startup failure: GitHub
            # rejects the WHOLE workflow, so there are no jobs, no logs, and
            # nothing else in this file runs. Cheap to check, and the fleet
            # re-pin proved it is not hypothetical — bumping every sha without
            # checking the filenames still resolved left one caller pointing at
            # job-go-gofmt.yml, which had been renamed to job-go-fmt.yml.
            m_uses = re.match(r"[\w.-]+/([\w.-]+)/\.github/workflows/([\w.-]+\.ya?ml)@", uses.strip())
            if m_uses:
                cat = catalog_dir(m_uses.group(1))
                if cat is not None and not (cat / m_uses.group(2)).is_file():
                    have = sorted(f.name for f in cat.glob("job-*.yml"))
                    near = difflib.get_close_matches(m_uses.group(2), have, n=1)
                    hint = f" — did you mean {near[0]}?" if near else ""
                    bad("CAT", f"'{job}' calls {m_uses.group(2)}, which does not exist in the "
                               f"catalog{hint} The whole file fails at startup: no jobs, no logs")

            # --- IN: the caller's `with:` matches the callee's schema -------
            # Only checkable when the catalog is on disk next to the repos,
            # which is the case for a fleet run and for anyone with the
            # workflows clone. Silent when it is not — an unenforceable rule
            # should be visibly absent, not faked.
            schema = catalog_inputs(uses)
            if schema is not None:
                declared, required = schema
                passed = with_keys(text, job)
                for k in sorted(passed - declared):
                    bad("IN", f"'{job}' passes '{k}', which {uses.split('/')[-1].split('@')[0]} does not declare — the whole file fails at startup")
                for k in sorted(required - passed):
                    bad("IN", f"'{job}' omits required input '{k}'")

            # --- WD: workdir names a shape, not a path ---------------------
            if re.search(r"/job-(build|bundle|lint|test-unit|typecheck)-", uses) or "job-image-docker" in uses:
                m = re.search(r"^      workdir:\s*(\S+)\s*$", props.get("__with_raw__", ""), re.M)
                if m and m.group(1).strip("\"'") not in (".", "client"):
                    bad("WD", f"'{job}' passes workdir: {m.group(1)} — it must be '.' or "
                              "'client'; the input names a repo shape, not a path")

            # --- D8: needs.<id> expressions resolve ------------------------
            # A rename moves job ids and needs: lists; ${{ needs.X.outputs.Y }}
            # is easy to miss, and GitHub does not fail on it — the expression
            # just evaluates to empty, so a version tag becomes "v" and nobody
            # notices until the artifact is wrong.
            for ref in sorted(set(re.findall(r"needs\.([\w-]+)\.", blob))):
                if ref not in jobs:
                    bad("D8", f"'{job}' reads needs.{ref}.* but no job '{ref}' exists")
                elif ref not in graph[job]:
                    bad("D8", f"'{job}' reads needs.{ref}.* but does not list '{ref}' in needs:")

            # --- RN: a rename that rewrote a command ------------------------
            # Renaming job ids go-build -> server-go-build with a whole-word
            # regex also rewrites `go build` to `go server-go-build`. It is not
            # a subcommand, so the step dies instantly. This already happened
            # twice: ./tools/checks/go-mod -> ./tools/checks/server-go-mod in
            # three files, and this one, which sat red for three hours.
            for m in re.finditer(
                r"\b(go|pnpm|npm|npx|composer|make|docker|cargo|dotnet)\s+"
                r"((?:server|client|lib|shared|firmware)-(?:go|ts|js|php|cpp|py)-[\w-]+)",
                blob):
                bad("RN", f"'{job}' runs `{m.group(1)} {m.group(2)}` — a job id was "
                          f"substituted into a command by a rename")

            # --- CM: CI does not commit to the repo it is testing ----------
            # hiring-tracker stamped version-info.json after the build, then
            # committed and pushed it to main with [skip ci]. Every image
            # therefore carried the previous commit's stamp, and the stamped
            # commit was never built. It had also silently stopped running four
            # merges earlier, so production was told it was four commits older
            # than it was.
            if re.search(r"^\s*git push\b", blob, re.M):
                bad("CM", f"'{job}' runs `git push` — CI must not commit to the "
                          "repository it is testing; emit generated files into "
                          "the build output instead")

            # --- D7: an image nothing runs ---------------------------------
            # Under the three-way split the build job never starts anything, so
            # the question is not "did it assert" but "is anything downstream of
            # it". A staged digest nothing pulls is an image nobody ran.
            if "job-image-build" in uses:
                consumers = sorted(j for j, n in graph.items()
                                   if job in n and j != "ci-ok")
                if not consumers:
                    bad("D7", f"'{job}' stages an image but no job needs it — "
                              "nothing in this pipeline runs or publishes it")

            if "job-image-docker" in uses or "job-docker-image" in uses or "job-image-starts" in uses:
                raw = props.get("__with_raw__", "")
                waived = re.search(r"^      assert_starts:\s*false\s*$", raw, re.M)
                # start_blocked_by is the other way to satisfy D7, and it earns it
                # by naming the blocker rather than asserting an exemption. An
                # empty or whitespace-only reason is not a waiver — that would be
                # a boolean wearing a string's clothes.
                blocked = re.search(r"^      start_blocked_by:\s*(.+?)\s*$", raw, re.M)
                reason = ""
                if blocked:
                    reason = blocked.group(1).strip().strip("\"'")
                    if reason in ("|", ">", "|-", ">-"):
                        # block scalar: the reason is on the following lines
                        tail = raw[blocked.end():]
                        reason = " ".join(l.strip() for l in tail.split("\n")
                                          if l.startswith("        ") and l.strip())
                if blocked and not reason:
                    bad("D7", f"'{job}' sets start_blocked_by with no reason — the input "
                              "exists to name the blocker, and an empty one waives "
                              "the check while explaining nothing")
                elif waived and not blocked and "job-image-starts" not in uses:
                    consumers = sorted(j for j, n in graph.items()
                                       if job in n and j != "ci-ok")
                    if not consumers:
                        bad("D7", f"'{job}' sets assert_starts: false but no job needs it — "
                                  "nothing in this pipeline runs the image")

            for callee, needed in CALLEE_NEEDS.items():
                if f"/{callee}.yml@" not in uses:
                    continue
                # A job-level block REPLACES the workflow default rather than
                # adding to it, so naming any scope zeroes every unnamed one.
                job_perms = re.findall(r"([\w-]+):\s*(read|write|none)", props.get("permissions", ""))
                # Three cases, and only two of them are provable from the file.
                # With no block at either level the grant is the REPOSITORY
                # default, which this file cannot show — so do not claim a
                # startup failure that may not happen. Reported, but for what it
                # actually is: an implicit grant that an org-wide flip to
                # read-only would revoke from every caller at once, as a
                # startup_failure with no logs.
                declared = bool(job_perms) or bool(wf_perms)
                effective = dict(job_perms) if job_perms else wf_perms
                for scope, level in needed.items():
                    if not declared:
                        bad(
                            "PERM",
                            f"'{job}' calls {callee} which requests {scope}: {level}, "
                            f"but grants nothing at job or workflow level — it runs "
                            f"on the repository default token permissions. Declare "
                            f"{scope}: {level} on the job so the grant survives a "
                            f"change to that default",
                        )
                        continue
                    have = effective.get(scope, "none")
                    if PERM_RANK.get(have, 0) < PERM_RANK[level]:
                        bad(
                            "PERM",
                            f"'{job}' calls {callee} which requests {scope}: {level}, "
                            f"but its effective grant is {scope}: {have} — GitHub "
                            "rejects the whole file at startup, with zero jobs and "
                            "no logs",
                        )

            for marker, lang in LANGUAGE_OF_SHARED_JOB.items():
                if marker not in uses:
                    continue
                parts = job.split("-")
                if len(parts) < 2 or parts[1] != lang:
                    bad(
                        "N1",
                        f"'{job}' calls a {marker}* shared job, so its source is "
                        f"{lang}, but its language token is "
                        f"'{parts[1] if len(parts) > 1 else '(absent)'}' — ids are "
                        f"<purpose>-<language>[-<framework>]-<capability>, so this "
                        f"should read <purpose>-{lang}-...",
                    )

            # The prune matches PUBLISH_RE on the word "image" and publishes
            # nothing — it deletes. D4 (be in ci-ok) is wrong for it by design;
            # it sits downstream of the rollup. D5 (never gate the job to main)
            # is wrong for it too: D5 exists so a publish path is rehearsed on
            # pull requests instead of first attempted on main, and a prune has
            # no path worth rehearsing — running it on a pull request would
            # delete things while that pull request is still open.
            if (
                PUBLISH_RE.search(job)
                and not REPORTING_RE.search(job)
                and not NOT_A_PRODUCT_RE.search(job)
                and "job-image-prune" not in uses
            ):
                reach = ancestors(job, graph)
                if not any(
                    GATE_RE.search(a) and not BUILD_RE.search(a) and not REPORTING_RE.search(a)
                    for a in reach
                ):
                    bad("D3", f"'{job}' publishes but reaches no gate")
                if "ci-ok" in jobs and job not in rollup:
                    bad("D4", f"'{job}' publishes but is not in ci-ok's needs — it fails invisibly")
                if MAIN_GATE_RE.search(props.get("if", "")):
                    bad(
                        "D5",
                        f"'{job}' is gated to main at the JOB level, so it never runs on a pull "
                        "request and its first execution is the push that has to work; put the "
                        "condition on the publishing step instead (Principle 17)",
                    )

    # --- P4: runner line --------------------------------------------------
    # A literal runner is allowed, but the decision has to be written down: an
    # undeclared literal is drift, a declared one is a decision. Declare it per
    # job in the comment above, or once in the file header when the whole
    # pipeline is hosted for one reason (gha-runner-controller cannot build its
    # own runner on its own runner).
    lines = text.splitlines()
    header_end = next((i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:"), 0)
    declared_file_wide = "Principle 4" in "\n".join(lines[:header_end])
    for i, ln in enumerate(lines):
        m = re.match(r"\s*runs-on:\s*(.+)$", ln)
        if not m or "vars.RUNNER" in m.group(1):
            continue
        context = "\n".join(lines[max(0, i - 6) : i])
        if not declared_file_wide and "Principle 4" not in context:
            bad(
                "P4",
                f"runs-on: {m.group(1).strip()} bypasses vars.RUNNER with no "
                "'Principle 4' note above it explaining why",
            )

    # --- P3: fail closed --------------------------------------------------
    for m in re.finditer(r"continue-on-error:\s*(.+)$", text, re.M):
        v = m.group(1).strip()
        # inputs.warn_only is the sanctioned escape hatch: a shared job whose
        # caller opted a specific linter into warn-only while it is adopted.
        if "inputs.warn_only" not in v:
            bad("P3", f"continue-on-error: {v} — nothing publishes unless every gate passes")

    return out, str(ci.relative_to(repo))


def job_block(text: str, job: str) -> str:
    """The raw lines of one job, from the original file.

    parse_jobs folds continuation lines into per-key strings, which is enough
    for `needs:` and `uses:` but loses step bodies — where ${{ needs.X.* }}
    expressions actually live.
    """
    m = re.search(rf"^  {re.escape(job)}:\s*$", text, re.M)
    if not m:
        return ""
    out = []
    for ln in text[m.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("    "):
            break
        out.append(ln)
    return "\n".join(out)


def with_block(text: str, job: str) -> str:
    """The raw lines under a job's `with:`, read from the original file.

    parse_jobs folds continuation lines into a single string (comments
    included), so anything that needs to tell an input name from a word in a
    comment has to re-read the block here.
    """
    m = re.search(rf"^  {re.escape(job)}:\s*$", text, re.M)
    if not m:
        return ""
    body = []
    for ln in text[m.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("    "):
            break
        body.append(ln)
    block = "\n".join(body)
    w = re.search(r"^    with:\s*$", block, re.M)
    if not w:
        return ""
    out = []
    for ln in block[w.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("      "):
            break
        out.append(ln)
    return "\n".join(out)


def with_keys(text: str, job: str) -> set[str]:
    """Input names a job passes under `with:`."""
    return set(re.findall(r"^      ([\w-]+):", with_block(text, job), re.M))


def catalog_dir(repo_name: str):
    """The local catalog clone's workflows dir, or None if there is no clone.

    Split out from catalog_inputs so a MISSING FILE can be told apart from a
    MISSING CATALOG. Conflating them is what let job-go-gofmt.yml through: the
    file had been renamed to job-go-fmt.yml, catalog_inputs returned None, and
    rule IN went quiet exactly as it does when the catalog is simply not on
    disk. A silent rule and a satisfied rule looked identical.
    """
    here = pathlib.Path(__file__).resolve().parent.parent
    for root in (here, *[q / repo_name for q in (here.parent, pathlib.Path.cwd().parent)]):
        d = root / ".github/workflows"
        if d.is_dir() and any(d.glob("job-*.yml")):
            return d
    return None


def catalog_inputs(uses: str):
    """(declared, required) input names for a shared job, or None if unresolvable.

    Resolves `aurum-alpha/workflows/.github/workflows/X.yml@sha` against a local
    clone of the catalog, searched next to this checker and beside the repo
    being checked. The pin is a sha, so a local clone may not hold that exact
    commit — this compares against whatever the working tree has, which catches
    the misspelling and the missing-required case without pretending to verify
    the pinned revision. Parsed with regex like the rest of this file, so the
    checker keeps running on a bare Python with no yaml installed.
    """
    m = re.match(r"([\w.-]+)/([\w.-]+)/\.github/workflows/([\w.-]+\.ya?ml)@", uses.strip())
    if not m:
        return None
    _, repo_name, fname = m.groups()
    here = pathlib.Path(__file__).resolve().parent.parent
    for root in (here, *[q / repo_name for q in (here.parent, pathlib.Path.cwd().parent)]):
        f = root / ".github/workflows" / fname
        if not f.is_file():
            continue
        text = f.read_text()
        block = re.search(
            r"^  workflow_call:\n(?:.*\n)*?^    inputs:\n((?:^      \S.*\n|^        .*\n|^\s*\n)*)",
            text, re.M)
        if not block:
            return set(), set()
        body = block.group(1)
        declared, required = set(), set()
        current = None
        for line in body.splitlines():
            k = re.match(r"^      ([\w-]+):\s*$", line)
            if k:
                current = k.group(1)
                declared.add(current)
            elif current and re.match(r"^        required:\s*true\s*$", line):
                required.add(current)
        return declared, required
    return None


def main() -> int:
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--repo-root", type=pathlib.Path, help="check one repo (default: cwd)")
    g.add_argument("--fleet", type=pathlib.Path, help="check every clone under DIR")
    args = ap.parse_args()

    if args.fleet:
        repos = sorted(p for p in args.fleet.iterdir() if (p / ".github/workflows").is_dir())
    else:
        repos = [args.repo_root or pathlib.Path.cwd()]

    failures = 0
    checked = 0
    for repo in repos:
        repo = repo.resolve()
        problems, ci_path = check(repo)
        if ci_path is None:
            if args.fleet:
                continue
            print(f"no ci.yml under {repo}/.github/workflows", file=sys.stderr)
            return 2
        checked += 1
        if problems:
            failures += 1
            print(f"{repo.name}/{ci_path}: {len(problems)} violation(s)")
            for p in problems:
                print(f"  {p}")
        else:
            print(f"{repo.name}: conformant")

    if not checked:
        print("no ci workflow found to check", file=sys.stderr)
        return 2
    print(
        f"\n{'PASS' if failures == 0 else f'FAIL: {failures} of {checked} repo(s) violate CI_STANDARD'}"
    )
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
