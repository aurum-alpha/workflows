SELF_TESTS: list[tuple[str, dict[str, str], list[str]]] = [
    ("a URL without a credential is not a value",
     {ENV_EXAMPLE: "APP_BASE_URL=http://localhost:3800\nOIDC_JWKS_URL=http://keycloak:8080/realms/x/certs\n"}, []),
    ("a file kind carries a path",
     {ENV_EXAMPLE: "TLS_CLIENT_PRIVATE_KEY_FILE=/run/secrets/tls.key\nOBJECT_STORE_TOKEN_FILE=/var/run/token\n"}, []),
    ("a quoted placeholder and an empty quoted value are placeholders",
     {ENV_EXAMPLE: 'SMTP_PASSWORD="<the relay password>"\nPAYMENTS_API_KEY=""\n'}, []),
    ("a value behind an inline comment is still a value",
     {ENV_EXAMPLE: "SMTP_PASSWORD=hunter2 # dev only\n"}, ["env-example-value"]),
    ("an environment-specific env file is tracked",
     {"deploy/.env.staging": "SMTP_PASSWORD=\n"}, ["env-file-tracked"]),
    ("an example under a service directory is the exception by name",
     {"services/api/.env.example": "SMTP_PASSWORD=\n"}, []),
    ("compose interpolation and an unknown tag are not values",
     {"docker-compose.ci.yml": "services:\n  db:\n    image: mysql:9.1.0\n    environment:\n      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}\n    healthcheck:\n      test: !override [\"CMD\", \"true\"]\n"}, []),
    ("a compose credential to the developer's machine is SE9's",
     {"compose.yaml": "services:\n  server:\n    build: .\n    environment:\n      DATABASE_URL: postgres://app:dev@localhost:5432/app\n"}, []),
    ("a compose credential to a service an included file starts is SE9's",
     {"compose.yaml": "include:\n  - dev/compose/auth.compose.yaml\nservices:\n  server:\n    build: .\n    environment:\n      KEYCLOAK_ADMIN_URL: http://keycloak:8080\n      DATABASE_URL: postgres://app:dev@db:5432/app\n",
      "dev/compose/auth.compose.yaml": "services:\n  db:\n    image: postgres:17.5-alpine\n    environment:\n      POSTGRES_PASSWORD: dev\n"}, []),
    ("a compose credential to a host nobody here starts is a finding",
     {"compose.yaml": "services:\n  server:\n    build: .\n    environment:\n      - DATABASE_URL=postgres://app:dev@db.internal.example:5432/app\n"}, ["compose-credential"]),
    ("a repository-side gitleaks config is not admitted",
     {".gitleaks.toml": "[extend]\nuseDefault = true\n"}, ["allow-list-not-admitted"]),
    ("a fingerprint ignore file is not admitted",
     {".gitleaksignore": "abc:path:rule:1\n"}, ["allow-list-not-admitted"]),
    ("an inline allow marker is not admitted",
     {"src/config.ts": f"const k = 'x'; // {ALLOW_MARKER.decode()}\n"}, ["allow-list-not-admitted"]),
    ("a document that names the marker is not using it",
     {"docs/scanning.md": f"Write `{ALLOW_MARKER.decode()}` nowhere; the scan ignores it.\n"}, []),
    ("a legacy-form ENV and a continued ENV are read",
     {"Dockerfile": "FROM scratch\nENV SMTP_PASSWORD hunter2\nENV PORT=8080 \\\n    PAYMENTS_API_KEY=pa_live_x\n"}, ["dockerfile-env-secret", "dockerfile-env-secret"]),
]


def self_test() -> int:
    failures = 0
    for title, files, expect in SELF_TESTS:
        with tempfile.TemporaryDirectory(prefix="secret-locations-self-") as tmp:
            repo = pathlib.Path(tmp)
            git(repo, "init", "-q")
            for rel, text in files.items():
                write(repo, rel, text)
            git(repo, "add", "-A")
            git(repo, "commit", "-q", "-m", "self-test")
            findings, _ = judge_repository(repo)
        got = sorted(f.check for f in findings)
        if got == sorted(expect):
            print(f"  ok   {title}")
        else:
            failures += 1
            print(f"fail  {title}: expected {sorted(expect) or 'no finding'}, got {got or 'no finding'}")
            for f in findings:
                print("       " + f.render())
    if failures:
        print(f"FAIL: {failures} self-test(s) do not hold")
        return 1
    print(f"ok  {len(SELF_TESTS)} self-test(s) hold")
    return 0


# --- main --------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--repo-root", type=pathlib.Path, help="judge this repository's tracked files")
    mode.add_argument("--corpus", type=pathlib.Path, help="prove the checks against a corpus's forbidden_locations part")
    mode.add_argument("--self-test", action="store_true", help="prove the grammar decisions the corpus does not reach")
    ap.add_argument("--changed-only", metavar="BASE",
                    help="with --repo-root: judge only files changed since BASE (what a pull request introduces)")
    ap.add_argument("--gitleaks", metavar="PATH",
                    help="with --corpus: the gitleaks binary; defaults to the one on PATH")
    ap.add_argument("--gitleaks-config", metavar="FILE",
                    help="with --corpus: the gitleaks config the scan will use, so the proof covers it")
    args = ap.parse_args()

    if args.self_test:
        return self_test()

    if args.corpus:
        gitleaks = args.gitleaks or shutil.which("gitleaks")
        if args.gitleaks and not (shutil.which(args.gitleaks) or os.access(args.gitleaks, os.X_OK)):
            print(f"FAIL: --gitleaks {args.gitleaks} is not executable", file=sys.stderr)
            return 2
        try:
            return prove_corpus(args.corpus, gitleaks, args.gitleaks_config)
        except (RuntimeError, subprocess.CalledProcessError) as e:
            print(f"FAIL: could not run the proof: {e}", file=sys.stderr)
            return 2

    root = args.repo_root.resolve()
    if not root.is_dir():
        print(f"FAIL: {root} is not a directory", file=sys.stderr)
        return 2
    try:
        only = changed_files(root, args.changed_only) if args.changed_only else None
        findings, judged = judge_repository(root, only)
    except RuntimeError as e:
        print(f"FAIL: could not ask: {e}", file=sys.stderr)
        return 2
    for f in findings:
        print(f.render())
    scope = f"{judged} changed file(s)" if only is not None else f"{judged} tracked file(s)"
    if findings:
        leaked = sum(1 for f in findings if f.response == LEAKED)
        print(f"FAIL: {len(findings)} secret location finding(s) over {scope}, {leaked} leaked")
        return 1
    print(f"PASS: no secret location finding over {scope}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
