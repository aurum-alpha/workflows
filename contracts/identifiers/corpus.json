    { "id": "prefixed-rejects-uppercase-prefix", "def": "prefixedHandle", "value": "Cus_V1StGXR8Z5jd", "valid": false, "note": "prefix is lowercase [a-z][a-z0-9]{0,7} (IP2)" },
