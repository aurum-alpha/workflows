#!/usr/bin/env python3
"""Assert a repository's local development stack matches the standard.

standards/016-local-development.md says a process reads PORT and falls back to a
constant, that a container binds defaults so a development compose file sets no
port, and that host bindings come from one aligned block of twenty. This checks
the half a machine can settle from one clone.

*Measured before the standard was written. In four repositories the dev stack
did not work at all: compose published the block's +0 onto a container port that
nothing bound, because the dev image's CMD ran the same script a person runs
natively, and that script overrode PORT for one process of the two. The
container was up, its logs said it was serving, and the health probe aimed at
the published port was the thing that looked broken.*

WHY NO ROSTER. ports.json records which block belongs to which project, and no
per-repository rule reads it. dependency-versions.json states the reason this
repository keeps no list of adopters: a repository opts in by calling
job-ci-conformance, the checker is handed one clone at a time, and a handed-over
client repository keeps using the standard after nothing here can see it. So
DS2 asks only what one clone can answer, which is whether the bindings fall
inside a single aligned window. Overlap between windows is a different question,
it needs the record, and --registry is where it is asked. That mode runs in this
repository alone.

  DS1  no service in a development compose file sets PORT
  DS2  host bindings fall inside one aligned block of twenty, none privileged
  DS3  what compose leaves running builds a development image, named as one
  DS4  the dependency tree is a named volume, not an anonymous one
  DS5  a development image installs from a lockfile, with the pinned manager
  DS6  no client build config hardcodes a port

Run against local clones:  tools/check-dev-stack --root /workspace --repo NAME
Check the allocation:      tools/check-dev-stack --registry
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys

import yaml

BLOCK = 20
PRIVILEGED = 1024

# A development compose file. A file whose name says prod is a deployment, and
# 016 leaves deployments alone.
DEV_COMPOSE = ("docker-compose.yml", "docker-compose.yaml", "compose.yaml", "compose.yml")

# "2900:5173", "${FASTGEN_HOST_PORT:-4600}:8180", "127.0.0.1:8080:8080".
HOST_PORT = re.compile(
    r"^(?:\d{1,3}(?:\.\d{1,3}){3}:)?"          # an optional bind address
    r"(?:\$\{[A-Z0-9_]+:-)?(\d{2,5})\}?"       # the host port, maybe defaulted
    r":\d{2,5}"                                 # the container port
)

# `port: 2910` in a vite config, and its friends.
CLIENT_PORT = re.compile(r"^\s*port:\s*(\d{2,5})\s*,?\s*$", re.M)

# `clientPort: 2900`. The same number in the same file, reached the other way:
# it is what the browser is told to open the websocket on. A value read from
# the environment carries no digits here and does not match.
HMR_PORT = re.compile(r"^\s*clientPort:\s*(\d{2,5})\s*,?\s*$", re.M)

# A package manager version written out by hand, rather than read from the pin
# the repository already declares.
HAND_PINNED = re.compile(r"(?:npm|corepack)\s+(?:i|install)\s+-g\s+[\"']?(?:pnpm|yarn)@\d")

# An ENV instruction, anchored to the start of a line. Substring matching read
# the comment `# No ENV PORT (LD2)` as the thing it forbids, in eight files that
# each said the opposite of what it reported.
ENV_PORT = re.compile(r"^\s*ENV\s+PORT[\s=]", re.M | re.I)


def one_shot(service: dict) -> bool:
    """A service that declares it runs and exits. Compose has no `type: job`,
    so `restart: "no"` is the closest thing to a declaration, and a one-shot
    that omits it restarts forever and is a defect on its own terms."""
    return str(service.get("restart", "")).lower() in {"no", "false"}


def dev_named(dockerfile: str) -> bool:
    """`Dockerfile.dev`, or any Dockerfile under a `dev/` directory. The second
    admits a repository with two runtimes, which cannot give two files one name.
    `Dockerfile` and `client/Dockerfile` are the shipped image and fail both."""
    path = pathlib.PurePath(dockerfile)
    return path.name == "Dockerfile.dev" or "dev" in path.parent.parts


def services(doc: dict) -> dict:
    got = doc.get("services")
    return got if isinstance(got, dict) else {}


def env_names(service: dict) -> set[str]:
    """Compose takes `environment:` as a mapping or as a KEY=VALUE list."""
    env = service.get("environment")
    if isinstance(env, dict):
        return {str(k) for k in env}
    if isinstance(env, list):
        return {str(item).split("=", 1)[0].strip() for item in env}
    return set()


def host_ports(service: dict) -> list[int]:
    out = []
    for entry in service.get("ports") or []:
        if isinstance(entry, dict):
            published = entry.get("published")
            if published is not None:
                out.append(int(str(published)))
            continue
        m = HOST_PORT.match(str(entry))
        if m:
            out.append(int(m.group(1)))
    return out


def check_compose(label: str, path: pathlib.Path) -> list[str]:
    findings = []
    doc = yaml.safe_load(path.read_text()) or {}
    named_volumes = set((doc.get("volumes") or {}) or {})
    every_port: list[int] = []

    for name, service in sorted(services(doc).items()):
        if not isinstance(service, dict):
            continue

        # DS1. The container binds its own default, so nothing here names one.
        if "PORT" in env_names(service):
            findings.append(
                f"DS1 {label}: service `{name}` sets PORT in {path.name}. The container "
                "binds its own default and the publish line maps the block onto it "
                "(016-local-development.md LD2)."
            )

        every_port += host_ports(service)

        # DS3. What `docker compose up` starts and leaves running is a
        # development image, and its filename says so.
        #
        # Two shapes are not that, and both are legitimate. A one-shot declares
        # `restart: "no"`, runs a command and exits: a migration or a seed has
        # nothing for a watcher to watch, and running it as the shipped image
        # keeps `up` exercising the artifact. A profiled service is opt-in, so
        # a plain `up` never starts it: that is how a repository offers its
        # shipped image locally without making it the default.
        build = service.get("build")
        if build is not None and not one_shot(service) and not service.get("profiles"):
            dockerfile = build.get("dockerfile", "Dockerfile") if isinstance(build, dict) else "Dockerfile"
            if not dev_named(str(dockerfile)):
                findings.append(
                    f"DS3 {label}: service `{name}` builds {str(dockerfile)!r} and stays up. "
                    "A long-running service in a development compose file builds a "
                    "development image, and the path says dev so a reader can tell which "
                    "one they are running (LD5)."
                )

        # DS4. An anonymous volume over the dependency tree works and cannot be
        # addressed afterwards, so copies accumulate and nothing says what a
        # `down -v` cleared.
        for mount in service.get("volumes") or []:
            if not isinstance(mount, str) or ":" not in mount:
                if isinstance(mount, str) and mount.strip().endswith("node_modules"):
                    findings.append(
                        f"DS4 {label}: service `{name}` mounts {mount!r} as an anonymous "
                        "volume. Name it, so `docker compose down -v` clears something "
                        "addressable (LD7)."
                    )
                continue
            source = mount.split(":", 1)[0]
            target = mount.split(":")[1]
            if target.endswith("node_modules") and source.startswith((".", "/")):
                findings.append(
                    f"DS4 {label}: service `{name}` mounts the host's {source!r} over "
                    f"{target!r}. The container populates a named volume instead, because "
                    "the host's tree is built for the host's architecture (LD7)."
                )

    # DS2. One aligned window of twenty, and nothing privileged. This needs no
    # allocation record: alignment is a property of a single clone.
    privileged = sorted({p for p in every_port if p < PRIVILEGED})
    if privileged:
        findings.append(
            f"DS2 {label}: {path.name} publishes {privileged} on the host. Nothing below "
            f"{PRIVILEGED}, for any service, ever (LD3)."
        )
    ordinary = sorted({p for p in every_port if p >= PRIVILEGED})
    if ordinary:
        base = (min(ordinary) // BLOCK) * BLOCK
        outside = [p for p in ordinary if not base <= p < base + BLOCK]
        if outside:
            findings.append(
                f"DS2 {label}: {path.name} publishes {ordinary}, which does not fit one "
                f"block of {BLOCK} aligned to a multiple of {BLOCK}. {outside} falls "
                f"outside {base}-{base + BLOCK - 1} (LD3)."
            )
    return findings


def check_dev_image(label: str, path: pathlib.Path) -> list[str]:
    """DS5. A development image that resolves dependencies differently from CI
    proves nothing, and the failure it hides is the one a developer most wants
    caught before a push."""
    findings = []
    text = path.read_text()
    hand = HAND_PINNED.search(text)
    if hand:
        findings.append(
            f"DS5 {label}: {path.name} writes out {hand.group(0)!r}. Read the version from "
            "the pin the repository already declares, which is Principle 1 inside a "
            "Dockerfile (LD6)."
        )
    installs = "pnpm install" in text or "npm install" in text or "npm ci" in text
    if installs and "--frozen-lockfile" not in text and "npm ci" not in text:
        findings.append(
            f"DS5 {label}: {path.name} installs without --frozen-lockfile, so the dev "
            "container's dependency tree is one nobody else has (LD6)."
        )
    if ENV_PORT.search(text):
        findings.append(
            f"DS5 {label}: {path.name} sets ENV PORT. A development image binds the "
            "default its code declares (LD2)."
        )
    return findings


def check_client_config(label: str, path: pathlib.Path) -> list[str]:
    """DS6. A hardcoded client port is the number 016 exists to remove: the
    block belongs to the host binding, and the dev server binds its own
    default."""
    text = path.read_text()
    inside = text.split("server:", 1)[1].split("\n  },", 1)[0] if "server:" in text else ""
    findings = []
    m = CLIENT_PORT.search(inside)
    if m:
        findings.append(
            f"DS6 {label}: {path.name} hardcodes port {m.group(1)} for the dev server. It "
            "binds its ecosystem's default, and compose publishes the block onto it (LD2)."
        )
    m = HMR_PORT.search(inside)
    if m:
        findings.append(
            f"DS6 {label}: {path.name} hardcodes clientPort {m.group(1)}. The browser's "
            "port is a property of the host binding, so it reaches the config from the "
            "environment and is absent when nothing sets it (LD2)."
        )
    return findings


def check_repo(root: pathlib.Path, repo: str) -> tuple[list[str], bool]:
    base = root / repo
    findings: list[str] = []
    looked = False

    for name in DEV_COMPOSE:
        path = base / name
        if path.is_file():
            looked = True
            findings += check_compose(repo, path)
            break

    dev_image = base / "Dockerfile.dev"
    if dev_image.is_file():
        looked = True
        findings += check_dev_image(repo, dev_image)

    for candidate in ("vite.config.ts", "client/vite.config.ts"):
        path = base / candidate
        if path.is_file():
            looked = True
            findings += check_client_config(repo, path)

    return findings, looked


def check_registry(catalog: pathlib.Path) -> list[str]:
    """The one question a single clone cannot answer."""
    registry = json.loads((catalog / "ports.json").read_text())
    size = int(registry["block_size"])
    blocks = sorted(registry["blocks"].items(), key=lambda kv: kv[1])
    findings = []
    for name, base in blocks:
        if base % size:
            findings.append(f"ports.json: {name}'s base {base} is not a multiple of {size}.")
        if base < PRIVILEGED:
            findings.append(f"ports.json: {name}'s base {base} is privileged.")
    for (a_name, a), (b_name, b) in zip(blocks, blocks[1:]):
        if b < a + size:
            findings.append(
                f"ports.json: {a_name} ({a}-{a + size - 1}) overlaps {b_name} ({b})."
            )
    return findings


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    ap.add_argument(
        "--registry",
        action="store_true",
        help="check ports.json for overlap; this repository only",
    )
    ap.add_argument("--catalog", default=".", type=pathlib.Path)
    args = ap.parse_args()

    if args.registry:
        findings = check_registry(args.catalog)
        for finding in findings:
            print(finding)
        if findings:
            print(f"\nFAIL: {len(findings)} finding(s) in the allocation.")
            return 1
        print("PASS: every block is aligned and no two overlap")
        return 0

    repos = args.repo or sorted(p.name for p in args.root.iterdir() if p.is_dir())
    findings: list[str] = []
    checked = 0
    for repo in repos:
        repo_findings, looked = check_repo(args.root, repo)
        if not looked:
            continue
        checked += 1
        findings += repo_findings
        if not repo_findings:
            print(f"{repo}: dev stack conforms")

    if findings:
        for finding in findings:
            print(finding)
        print(
            f"\nFAIL: {len(findings)} finding(s). A published port that nothing binds is "
            "indistinguishable from a working stack until somebody opens it. See "
            "standards/016-local-development.md."
        )
        return 1

    print(f"\nPASS: {checked} dev stack(s) match the standard")
    return 0


if __name__ == "__main__":
    sys.exit(main())
