    { "id": "timestamp-rejects-no-millis", "def": "timestamp", "value": "2026-08-31T14:07:02Z", "valid": false, "note": "canonical form carries exactly three fractional digits (IP4)" },
    { "id": "timestamp-accepts-micros", "def": "timestamp", "value": "2026-08-31T14:07:02.417233Z", "valid": true, "note": "a repository may pin 6 (or 9) digits for finer timekeeping — never fewer than 3 (IP4)" },
    { "id": "timestamp-rejects-four-digits", "def": "timestamp", "value": "2026-08-31T14:07:02.4172Z", "valid": false, "note": "precision comes in millis/micros/nanos steps: 3, 6 or 9 digits, nothing between (IP4)" },
    { "id": "timestamp-rejects-unix", "def": "timestamp", "value": "1788185222", "valid": false, "note": "Unix integers are not admitted on the wire (IP4)" },
