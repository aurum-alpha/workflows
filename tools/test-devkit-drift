#!/usr/bin/env python3
"""Tests check-devkit-drift's one allowance: an image tag inside its interval.

check-devkit-drift runs in every product's ci-conformance, and nothing here
exercised it against a product whose render differs. Each case renders a
throwaway product from the catalog's devkit/, changes one thing, runs the
checker, and holds it to an exit status and a line of output (#818).
"""

import json
import pathlib
import re
import subprocess
import sys
import tempfile

TOOLS = pathlib.Path(__file__).resolve().parent
CATALOG = TOOLS.parent
CHECK = TOOLS / "check-devkit-drift"
RENDER = TOOLS / "render-devkit"
COMPOSE = "dev/compose/auth.compose.yaml"

failures = 0


def product(tmp: pathlib.Path) -> pathlib.Path:
    """A product rendered from the catalog as it is now."""
    repo = tmp / "product"
    repo.mkdir()
    (repo / "devkit.json").write_text(json.dumps({
        "repo": "product",
        "port_base": 9700,
        "upstreams": {"app": "server:5000"},
        "routes": [{"prefix": "/", "next": "auth", "then": "app"}],
    }))
    subprocess.run([sys.executable, RENDER, "--target", repo],
                   check=True, capture_output=True)
    return repo


def check(tmp: pathlib.Path) -> tuple[int, str]:
    p = subprocess.run([sys.executable, CHECK, "--root", tmp,
                        "--repo", "product"], capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


def case(name: str, edit, want_rc: int, want_text: str) -> None:
    global failures
    with tempfile.TemporaryDirectory() as t:
        tmp = pathlib.Path(t)
        repo = product(tmp)
        path = repo / COMPOSE
        path.write_text(edit(path.read_text()))
        rc, out = check(tmp)
    if rc != want_rc or want_text not in out:
        print(f"FAIL  {name}: exit {rc}, wanted {want_rc} and {want_text!r}")
        print("      " + out.replace("\n", "\n      "))
        failures += 1
    else:
        print(f"  ok  {name}")


record = json.loads((CATALOG / "dependency-versions.json").read_text())
mailpit = record["images"]["axllent/mailpit"]


def mailpit_tag(tag: str):
    return lambda s: re.sub(r"(axllent/mailpit:)[^\s@]+", rf"\g<1>{tag}", s)


# The record's own min is inside the interval by definition, and is a tag
# Dependabot already moved past in the catalog: the shape of #808.
case("a devkit image tag inside its recorded interval passes",
     mailpit_tag(mailpit["min"]), 0, "PASS")
case("a devkit image tag below its recorded interval fails",
     mailpit_tag("v1.0.0"), 1, "DIFFERS")
case("another image on the same line fails",
     lambda s: s.replace("axllent/mailpit:", "example/mailpit:", 1),
     1, "DIFFERS")
case("any other changed byte still fails",
     lambda s: s.replace("restart: unless-stopped", "restart: always", 1),
     1, "DIFFERS")
case("an unchanged render passes", lambda s: s, 0, "PASS")

if failures:
    print(f"\nFAIL: {failures} case(s)")
    sys.exit(1)
print("\nPASS")
