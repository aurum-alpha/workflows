#!/usr/bin/env python3
"""Verify every repo's eslint.config.mjs is byte-identical to the catalog's.

The config's own header says:

    DO NOT EDIT IN ONE REPO. Change it in every repo at once; the byte-identity
    checker fails the build otherwise.

That checker did not exist. Six repos carried the file, all six happened to
match, and the sentence enforcing it was decoration — which is worse than no
rule, because it reads as a guarantee. A rule nothing enforces is a rule
already broken; nobody has just noticed yet.

This is the checker. The canonical copy lives at config/eslint.config.mjs in
this repository, so there is one place to change and one thing to compare
against, rather than six copies agreeing by luck.

The comparison is bytes, not semantics, and deliberately so. The point is not
that the configs behave alike — it is that they are ONE config, so that
collapsing them into a published package later is a mechanical move rather
than a merge.

Run against local clones:  tools/check-eslint-config --root /workspace
Run against one repo:      tools/check-eslint-config --root DIR --repo NAME

Naming a repo with no eslint config is a pass, not an error, for the same
reason check-fleet-versions passes a repo with no Node app: a checker that
only runs when someone remembers to exclude the right repos is a checker that
stops being run.
"""

import argparse
import hashlib
import os
import pathlib
import sys

CONFIG = "eslint.config.mjs"

# Where a repo may keep its copy, in order. Repo root covers the repos whose JS
# project IS the repo; client/ covers the ones whose React app is its own pnpm
# project inside a Go or PHP tree. Those are the same two shapes job-lint-js-*
# already distinguishes with its `workdir` input, so this is not a new
# convention -- it is the checker catching up to one the catalog already has.
#
# Root-only was a silent hole rather than a strict rule: a missing file is a
# pass, so gofast and client-manager -- the two repos with a client/ -- were
# never checked at all, and the run still printed PASS. A checker that reports
# success for a repo it did not look at is worse than one that fails, because
# it answers the question it was asked without ever asking it.
SEARCH_DIRS = ("", "client")


def digest(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    args = ap.parse_args()

    # Same override as check-ci-conformance's catalog_roots: a caller's
    # conformance run takes its RULES from a pinned standard_ref, which is
    # right, but "what is the current canonical config" is a question about the
    # catalog as it is now. Pinning that answer would report a config the fleet
    # has already moved past.
    here = pathlib.Path(os.environ.get("AURUM_CATALOG_ROOT")
                        or pathlib.Path(__file__).resolve().parent.parent)
    canonical = here / "config" / CONFIG
    if not canonical.is_file():
        print(f"canonical config not found at {canonical}", file=sys.stderr)
        return 2
    want = digest(canonical)

    if args.repo:
        repos = args.repo
    else:
        repos = sorted(p.name for p in args.root.iterdir() if p.is_dir())

    failures = 0
    checked = 0
    for repo in repos:
        found = [
            args.root / repo / sub / CONFIG if sub else args.root / repo / CONFIG
            for sub in SEARCH_DIRS
        ]
        found = [c for c in found if c.is_file()]
        if not found:
            if args.repo:
                print(f"{repo}: no {CONFIG} — nothing to check")
            continue
        for path in found:
            checked += 1
            where = path.relative_to(args.root / repo)
            got = digest(path)
            if got == want:
                print(f"{repo}: identical ({where})")
            else:
                failures += 1
                print(f"{repo}: DIFFERS from config/{CONFIG} ({where})")
                print(f"  catalog {want[:12]}  repo {got[:12]}")

    if failures:
        print(
            f"\nFAIL: {failures} repo(s) have edited {CONFIG} locally. Change it "
            f"in config/{CONFIG} and roll the whole fleet, or if the change is "
            "genuinely repo-specific, say so out loud — this file is shared on "
            "the claim that no repo needs its own."
        )
        return 1

    print(f"\nPASS: {checked} repo(s) match config/{CONFIG}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
