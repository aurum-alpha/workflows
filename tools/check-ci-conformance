PERM_RANK = {"none": 0, "read": 1, "write": 2}


def workflow_permissions(text: str) -> dict[str, str]:
    """The workflow-level permissions block, which is the default every job gets."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if re.match(r"^permissions:\s*$", ln))
    except StopIteration:
        return {}
    out = {}
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith(" "):
            break
        m = re.match(r"^  ([\w-]+):\s*(\S+)", ln)
        if m:
            out[m.group(1)] = m.group(2)
    return out


CONCURRENCY_EXPECTED = "cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}"


def find_ci(repo: pathlib.Path) -> pathlib.Path | None:
    for n in CI_NAMES:
        p = repo / ".github" / "workflows" / n
        if p.is_file():
            return p
    return None


def parse_jobs(text: str) -> dict[str, dict[str, str]]:
    """job id -> {key: raw value}, folding block sequences into their key."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:")
    except StopIteration:
        return {}
    jobs: dict[str, dict[str, str]] = {}
    cur = key = None
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith("  "):
            break
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            cur, key = m.group(1), None
            jobs[cur] = {}
            continue
        m = re.match(r"^    ([\w-]+):\s*(.*)$", ln)
        if m and cur is not None:
            key = m.group(1)
            jobs[cur][key] = m.group(2).strip()
            continue
        # Continuation lines: block-sequence items, or a folded scalar's body.
        if cur is not None and key is not None and ln.startswith("      "):
            jobs[cur][key] += " " + ln.strip().lstrip("- ")
    return jobs


def needs_of(props: dict[str, str]) -> set[str]:
    return set(re.findall(r"[\w-]+", props.get("needs", "")))


def ancestors(job: str, graph: dict[str, set[str]]) -> set[str]:
    seen: set[str] = set()
    stack = list(graph.get(job, ()))
    while stack:
        n = stack.pop()
        if n in seen or n not in graph:
            continue
        seen.add(n)
        stack.extend(graph[n])
    return seen


def sourceless_image_builds(text: str) -> set[str]:
    """Callers of job-image-build that pass no artifacts: input.

    D3 exists for artifact provenance: an image that COPYs a binary or a
    dist/ this repo built must sit downstream of the gates that tested that
    code, or a green publish ships code nothing looked at. `artifacts:` is
    where that provenance enters the image job — and when a caller passes
    none, the image contains no repo-built code at all. It is a Dockerfile
    over an upstream base: it either builds or it does not, and any
    assertions worth making about it belong in the Dockerfile as RUN steps,
    where a failure already fails the build (the runner image checks
    `docker compose version` and `node --version` exactly this way). There
    is no gate a chain like that could reach, because there is nothing in
    it a gate could have tested.

    Detection reads the raw job blocks rather than parse_jobs(): that parser
    folds every 6-space line into the preceding key, comments included, so a
    caller whose comment merely mentions "artifacts:" would count as passing
    it.
    """
    blocks: list[tuple[str, list[str]]] = []
    for ln in text.splitlines():
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            blocks.append((m.group(1), []))
        elif blocks:
            blocks[-1][1].append(ln)
    out: set[str] = set()
    for job, body in blocks:
        code = [ln for ln in body if not ln.lstrip().startswith("#")]
        if not any(re.match(r"^    uses:.*\bjob-image-build\.ya?ml@", ln) for ln in code):
            continue
        if not any(re.match(r"^      artifacts:", ln) for ln in code):
            out.add(job)
    return out



def upload_steps(text: str) -> list[tuple[str, int]]:
    """Every actions/upload-artifact step, as (step text, 1-based line number).

    A step runs from its own `- ` bullet to the next line indented no deeper
    than that bullet, which is where the following step or the next block key
    begins. Slicing on the bullet rather than a fixed indent is what makes this
    work in both a caller's ci.yml (steps at six spaces, inside jobs.<id>.steps)
    and this repo's own job-*.yml, without either indent being hardcoded.

    Comments are stripped first. A step carrying `# retention-days: 1` in a note
    about what it does not set would otherwise satisfy the rule it is describing
    — the same trap sourceless_image_builds() documents for `artifacts:`.
    """
    lines = [
        "" if ln.lstrip().startswith("#") else ln
        for ln in text.splitlines()
    ]
    out: list[tuple[str, int]] = []
    for i, ln in enumerate(lines):
        if not re.search(r"uses:\s*actions/upload-artifact@", ln):
            continue
        # Walk back to the bullet that opens this step: `uses:` may sit under a
        # `- name:` line rather than being the bullet itself.
        start = i
        while start >= 0 and not lines[start].lstrip().startswith("- "):
            start -= 1
        if start < 0:
            start = i
        bullet = len(lines[start]) - len(lines[start].lstrip())
        end = start + 1
        while end < len(lines):
            cur = lines[end]
            if cur.strip() and (len(cur) - len(cur.lstrip())) <= bullet:
                break
            end += 1
        out.append(("\n".join(lines[start:end]), start + 1))
    return out


def check(repo: pathlib.Path) -> tuple[list[str], str | None]:
    ci = find_ci(repo)
    if ci is None:
        return [], None
    text = ci.read_text()
    jobs = parse_jobs(text)
    graph = {j: needs_of(p) for j, p in jobs.items()}
    rollup = graph.get("ci-ok", set())

    # "Gates hang off the build" presumes a build. A repo that compiles nothing
    # — this one checks yaml — has no such node, and its gates are the roots.
    roles = {j: role_of(p) for j, p in jobs.items()}
    has_build = any(r == "build" for r in roles.values())
    wf_perms = workflow_permissions(text)
    out: list[str] = []

    def bad(rule, msg):
        out.append(f"[{rule}] {msg}")

    # ADOPT: is each job a call into the catalog, or a body of its own?
    # Same subject, same file, one verdict.
    #
    # Every repo is asked except the one that DEFINES the shared jobs, where the
    # question is a category error: the catalog's own jobs are the definitions,
    # not calls to them, and it fails four of its own ADOPT rules by being what
    # it is. That exemption is a property of the tree, read off it here —
    # is_library() and D6 both reached the same conclusion for the same reason,
    # and the rule is now stated once in defines_catalog().
    if not defines_catalog(repo):
        for finding in adoption_findings(text):
            bad("ADOPT", finding)

    # --- P18: ci.yml is the pipeline -------------------------------------
    wf_dir = repo / ".github" / "workflows"
    if wf_dir.is_dir():
        extra = sorted(
            p.name
            for p in wf_dir.iterdir()
            if p.suffix in (".yml", ".yaml")
            and p.name not in CI_NAMES
            and p.name not in ALLOWED_OTHER_WORKFLOWS
            and not is_library(p)
        )
        for name in extra:
            bad("P18", f"{name} sits outside ci.yml — nothing gates it, nothing reviews it")

    # --- P6: concurrency --------------------------------------------------
    if "concurrency:" not in text:
        bad("P6", "no concurrency block")
    elif CONCURRENCY_EXPECTED not in text:
        found = re.search(r"cancel-in-progress:\s*(.+)", text)
        bad(
            "P6",
            f"cancel-in-progress is {found.group(1).strip() if found else 'unset'}; "
            "main runs publish, and a cancelled run is not a failed one",
        )

    # --- TRG: push fires on the default branch only -----------------------
    # hiring-tracker carried push: ["**"] and so ran two full pipelines for
    # every feature-branch commit: one for refs/heads/<branch>, one for
    # refs/pull/<n>/merge. Different refs mean different concurrency groups, so
    # they did not cancel each other and both ran to completion.
    m_on = re.search(r"^on:\s*$(.*?)^\S", text, re.M | re.S)
    if m_on:
        m_push = re.search(r"^  push:\s*$\n((?:^    .*$\n)*)", m_on.group(1), re.M)
        if m_push:
            br = re.search(r"^    branches:\s*(.+?)\s*$", m_push.group(1), re.M)
            listed = br.group(1) if br else ""
            if "**" in listed or "*" == listed.strip("[]\"' "):
                bad("TRG", f"push: branches: {listed} runs the whole DAG a second time on "
                           "every feature-branch commit — the pull_request run already "
                           "covers it, and the two never cancel each other")

    # --- PIN: third party is sha-pinned; ours tracks main -----------------
    #
    # Two rules that looked like one. Both were "pin everything to a 40-hex
    # sha", and the arguments underneath them are not the same argument.
    #
    # A THIRD PARTY's action is code we did not write, from a repository we do
    # not control. A tag there is a mutable pointer somebody else can move, so
    # pinning it is a supply-chain control: the sha is the review. That rule is
    # absolute and is unchanged.
    #
    # OUR OWN catalog is the opposite case. We control it, and a pin buys a
    # repository only the ability to sit on rules it has already been given.
    # That is not safety, it is an opt-out, and CI compliance is not optional
    # here — a standard every repository can decline at its own pace is a
    # suggestion with extra steps. The pin also cost more than it bought: the
    # portfolio spent months in a loop of change the catalog, bump eleven pins,
    # discover the bug, fix the catalog, bump eleven pins again.
    #
    # So a first-party reference must be `@main`, exactly. Not a sha, which
    # would be pinning backwards; not a tag, which would be the same thing
    # wearing a version number. Versions are still cut and still mean what they
    # meant — they are how a human names a state of the catalog — but nothing
    # consumes them as a pin any more.
    for m in re.finditer(r"uses:\s*([\w.-]+/[^@\s]+)@([^\s#]+)[ \t]*(#.*)?$", text, re.M):
        action, ref, comment = m.group(1), m.group(2), m.group(3)
        if action.startswith(f"{CATALOG_OWNER}/"):
            if ref != "main":
                bad("PIN", f"{action}@{ref} pins our own catalog — it must be "
                           "@main. A version-named or sha-named reference to the "
                           "catalog is an opt-out from the current standard, and "
                           "there is no opt-out")
        elif not re.fullmatch(r"[0-9a-f]{40}", ref):
            bad("PIN", f"{action}@{ref} is not a 40-hex sha — tags are mutable pointers")
        elif not comment or not re.match(r"#\s*v", comment.strip()):
            bad("PIN", f"{action}@{ref[:8]} has no trailing '# vX.Y.Z' comment")

    # --- LOCK: one catalog version per repo ------------------------------
    # A repo may not draw jobs from several commits of the catalog at once.
    # The point of a shared catalog is that it is the single source of truth
    # about how CI runs; a repo pinning four commits is consuming four
    # different answers and is only nominally standardised.
    #
    # This was not hypothetical when the rule was written: eight of ten repos
    # pinned between two and four commits, six of them four, which meant their
    # conformance checkers came from one commit and the jobs they gate came
    # from three others.
    #
    # Every workflow file counts, not just ci.yml. A release workflow calling
    # the catalog from an older commit is the same divergence, and P18 already
    # names those files as debt.
    #
    # PIN now requires every first-party reference to be `@main`, so there is
    # exactly one catalog state a conformant repo can be drawing from and this
    # rule cannot fire on one. It is kept because it still describes the
    # transition: a repo halfway through the move has sha pins left, and this
    # names how many and where while PIN names each one.
    if wf_dir.is_dir():
        pins: dict[str, list[str]] = {}
        for wf in sorted(wf_dir.glob("*.yml")) + sorted(wf_dir.glob("*.yaml")):
            for m in re.finditer(
                r"uses:\s*aurum-alpha/workflows/[^@\s]+@([0-9a-f]{40})", wf.read_text()
            ):
                pins.setdefault(m.group(1), []).append(wf.name)
        if len(pins) > 1:
            detail = "; ".join(
                f"{sha[:7]} in {', '.join(sorted(set(files)))}"
                for sha, files in sorted(pins.items())
            )
            bad("LOCK", f"{len(pins)} different aurum-alpha/workflows commits are "
                        f"pinned in this repo — {detail}. One catalog version at a "
                        "time: a repo taking jobs from several commits is running "
                        "several standards.")

    # --- RET: every upload states how long it keeps ----------------------
    # A repo-local upload-artifact with no retention-days silently inherits the
    # repository setting — 90 days by default — and the org's artifact storage
    # quota is a shared resource: when it fills, every repo's uploads start
    # failing at once, with a red check carrying no log and no output.
    #
    # That is not hypothetical. On 2026-08-29 the quota was exhausted and
    # reddened osv-scanner on expense-splitter#48 and image-build plus
    # coverage-upload on wardley-mapper#39, none of which had a defect. The
    # catalog's own twelve uploads all set 1 day; the one upload in the portfolio
    # that set nothing was a .deb that lives for the minutes between packaging
    # and `gh release create`, kept for ninety days.
    #
    # The rule asserts presence, never a value, because the right number is a
    # judgment the checker cannot make: 1 day is right for a hand-off between
    # jobs, and lid-firmware's 90 is right for field firmware in a repo with no
    # release pipeline, where that artifact is the only retrievable copy of what
    # ships to a device. What a checker can prove is that somebody decided.
    # Same shape as the AGENTS.md rule, which tests the act rather than length.
    if wf_dir.is_dir():
        for wf in sorted(wf_dir.glob("*.yml")) + sorted(wf_dir.glob("*.yaml")):
            for step, line_no in upload_steps(wf.read_text()):
                if not re.search(r"^\s*retention-days:", step, re.M):
                    bad(
                        "RET",
                        f"{wf.name}:{line_no} uploads an artifact without "
                        "retention-days, so it inherits the repository default "
                        "(90 days) and consumes the org's shared artifact "
                        "quota. State one: 1 for a hand-off between jobs in the "
                        "same run, or a longer value where the artifact is the "
                        "only durable copy of a deliverable.",
                    )

    # --- RU: the rollup is shared, not copied ----------------------------
    # ci-ok is the one job every repo has and the one job none of them called
    # from the catalog, because a reusable workflow would rename the check to
    # `ci-ok / ok` and break branch protection in eleven places at once. A
    # composite action runs inside the caller's job, so the name survives and
    # only the body is shared.
    if "ci-ok" in jobs:
        rollup_blob = job_block(text, "ci-ok")
        shared = re.search(
            r"uses:\s*(?:\./\.github/actions/ci-ok\b"
            r"|aurum-alpha/workflows/\.github/actions/ci-ok@)",
            rollup_blob,
        )
        if not shared:
            bad("RU", "ci-ok does not use the shared ci-ok action — its rollup is a local copy")
        elif "toJSON(needs.*.result)" in rollup_blob:
            bad("RU", "ci-ok passes toJSON(needs.*.result); the flattened form cannot name the failing job")
        elif "toJSON(needs)" not in rollup_blob:
            bad("RU", "ci-ok does not pass needs_json: ${{ toJSON(needs) }}")
        # Only for the REMOTE form. The action reads inputs.needs_json and no
        # repository file, and the runner fetches an `owner/repo/path@ref`
        # action itself, so a checkout provides nothing. What it does provide
        # is a dependency on a token: the correct grant for this job is
        # `permissions: {}`, which leaves none, and the checkout then fails
        # outright against a private repository. gha-runner-controller failed
        # exactly that way with "Repository not found", while the identical
        # line passed on gofast because gofast is public — a step that works
        # only while a repo stays public is what this checker exists to name.
        #
        # The local path form `./.github/actions/ci-ok` is the exception and
        # needs its checkout: a local action has to be in the workspace. Only
        # this repository uses it, so that the action is gated by the same run
        # that ships it. Written as a carve-out rather than a looser regex,
        # because the first version of this rule flagged that legitimate case
        # and would have had the catalog fail its own gate.
        uses_remote = re.search(r"uses:\s*[\w.-]+/[\w.-]+/\.github/actions/ci-ok@", rollup_blob)
        if shared and uses_remote and "actions/checkout@" in rollup_blob:
            bad("RU", "ci-ok checks out the repo — the shared action reads no "
                      "file, and with permissions: {} the checkout has no token, "
                      "so it fails on a private repo")

    # --- P3 / P4 / D*: per job -------------------------------------------
    for job, props in sorted(jobs.items()):
        blob = job_block(text, job)

        if job != "ci-ok":
            # Build first, fail fast. A gate running beside the build burns a
            # runner on code that does not compile, and reports its own failure
            # instead of the one that caused it.
            #
            # The conformance job is the one gate that reason does not reach:
            # it reads ci.yml and package.json, never a build output, so a
            # broken build makes its verdict no less true. Gating it on the
            # build would mean a repo whose code does not compile never learns
            # its CI is nonconformant — the check least able to wait, waiting.
            # It carries role=policy for exactly that property, so the exemption
            # is the role rather than a second test naming one workflow.
            #
            # ROOT_ROLES is what ROOT_RE was reaching for. Its regex enumerated
            # `changes`, `create-docker-*-image` and anything ending in mod,
            # build, install or composer — a list that had already gone wrong
            # once when a repo renamed `build` to `react-build` obeying the
            # naming rule and was called a violation for it.
            #
            # A job with no role is repo-specific and D1 does not reach it. A
            # repo's own change-detection job is the case that used to need a
            # name in the regex; it needs nothing now.
            if (
                has_build
                and not graph[job]
                and roles.get(job) is not None
                and roles[job] not in ROOT_ROLES
            ):
                bad("D1", f"'{job}' has no needs: — it runs beside the build it should gate")

            # Separate property: having a needs: puts a job in the right place
            # in the DAG; being NAMED IN ci-ok's needs is what makes its failure
            # block anything. A job can satisfy D1 and still stop nothing.
            #
            # DIRECT membership, not the transitive closure, and the difference
            # is the whole rule. ci-ok is `if: always()`, which opts it out of
            # needs meaning "must succeed" — it runs whatever its dependencies
            # did, and decides by counting "failure" and "cancelled" in the
            # needs object. A job it does not name has no entry in that object.
            # When a job fails, everything downstream of it is SKIPPED, and
            # skipped is neither failure nor cancelled, so a rollup naming only
            # the leaves of a chain counts zero of each and prints "All
            # dependencies succeeded" over a build that did not.
            #
            # Transitive reachability would accept exactly that shape: the
            # failing job is still reachable, and still invisible. The rollup
            # must name every job that can report a failure, which is every job
            # in the file — see rule D4, which is this same hole found once, for
            # publish alone, the hard way.
            # Housekeeping is the one shape deliberately outside the rollup:
            # it fails without saying anything about the commit, and a merge
            # blocked on a registry API hiccup is worse than a week of extra
            # blobs. The registry prune was the first; tagging a release is the
            # second, and there will be others.
            #
            # The test is structural rather than a list of job names: a job is
            # housekeeping exactly when the rollup is upstream of it. That
            # placement is the whole claim — it cannot run before the gates
            # pass, and the rollup has already reported by the time it starts.
            # A name-based exemption said the same thing for one job while
            # quietly leaving the next one to be discovered by failing.
            housekeeping = "ci-ok" in ancestors(job, graph)
            if "ci-ok" in jobs and job not in rollup and not housekeeping:
                bad("D6", f"'{job}' is not named in ci-ok's needs, and the rollup "
                          "is not upstream of it either — so the rollup cannot see "
                          "it fail. Housekeeping goes downstream of ci-ok; "
                          "everything else goes in its needs")
            if "job-image-prune" in props.get("uses", "") and not housekeeping:
                bad("D6", f"'{job}' prunes the registry but ci-ok is not upstream "
                          "of it — housekeeping must not run ahead of the gates")

            # D2 says a build never needs a gate — build first, fail fast — and
            # that is about SOURCE builds, which compile something and must come
            # before anything is spent testing it. An image build compiles
            # nothing: it packages artifacts the source builds already produced,
            # which is why it is the convergence point every gate hangs off.
            #
            # That distinction used to be `BUILD_RE and not PUBLISH_RE`, one
            # regex subtracted from another because the first could not tell
            # `image-build` from `go-build`. The catalog jobs say which they are
            # — role=build compiles, role=publish packages — so there is nothing
            # to subtract.
            if roles.get(job) == "build":
                inv = sorted(n for n in graph[job] if roles.get(n) == "gate")
                if inv:
                    bad("D2", f"'{job}' is a build but needs gate(s): {', '.join(inv)}")

            uses = props.get("uses", "")
            props["__with_raw__"] = with_block(text, job)

            # --- CAT: the shared workflow file actually exists --------------
            # A pin naming a file that is not there is a startup failure: GitHub
            # rejects the WHOLE workflow, so there are no jobs, no logs, and
            # nothing else in this file runs. Cheap to check, and the portfolio
            # re-pin proved it is not hypothetical — bumping every sha without
            # checking the filenames still resolved left one caller pointing at
            # job-go-gofmt.yml, which had been renamed to job-go-fmt.yml.
            #
            # Owner-gated, and that gate is load-bearing: catalog_roots puts
            # AURUM_CATALOG_ROOT first REGARDLESS of the repo name it was
            # asked about, so without this every third-party reusable workflow
            # resolves against our catalog and is reported missing from it.
            # google/osv-scanner-action is called directly by ten repos
            # (workflows#109) and each one was told its scanner "does not
            # exist in the catalog", which is true and irrelevant.
            #
            # Whether a third-party workflow is ALLOWED is a different
            # question, and EXTERNAL_JOBS below is the approved list. Answering
            # it here too would make two places to update and one to forget.
            m_uses = re.match(r"([\w.-]+)/([\w.-]+)/\.github/workflows/([\w.-]+\.ya?ml)@", uses.strip())
            if m_uses and m_uses.group(1) == CATALOG_OWNER:
                cat = catalog_dir(m_uses.group(2))
                if cat is not None and not (cat / m_uses.group(3)).is_file():
                    have = sorted(f.name for f in cat.glob("job-*.yml"))
                    near = difflib.get_close_matches(m_uses.group(3), have, n=1)
                    hint = f" — did you mean {near[0]}?" if near else ""
                    bad("CAT", f"'{job}' calls {m_uses.group(3)}, which does not exist in the "
                               f"catalog{hint} The whole file fails at startup: no jobs, no logs")

            # --- DECL: the catalog job says what it is ----------------------
            # Every rule that asks what a job IS answers from the declaration on
            # the workflow it calls. A catalog job carrying none leaves those
            # rules with nothing to say about this caller — and silence from a
            # rule is indistinguishable from a rule satisfied, which is the
            # failure this whole file keeps relearning.
            #
            # So it is reported here rather than absorbed. The finding names the
            # catalog file, because the fix belongs there and not in the repo
            # that tripped over it.
            decl = catalog_declaration(uses)
            if isinstance(decl, Undeclared):
                bad("DECL", f"'{job}' calls {decl}, which carries no '# aurum-job:' "
                            "declaration, so nothing here knows whether it builds, "
                            "gates or publishes — D1 through D5 go quiet for this "
                            "job rather than passing it. Declare it in the catalog")

            # --- IN: the caller's `with:` matches the callee's schema -------
            # Only checkable when the catalog is on disk next to the repos,
            # which is the case for a portfolio run and for anyone with the
            # workflows clone. Silent when it is not — an unenforceable rule
            # should be visibly absent, not faked.
            schema = catalog_inputs(uses)
            if schema is not None:
                declared, required = schema
                passed = with_keys(text, job)
                for k in sorted(passed - declared):
                    bad("IN", f"'{job}' passes '{k}', which {uses.split('/')[-1].split('@')[0]} does not declare — the whole file fails at startup")
                for k in sorted(required - passed):
                    bad("IN", f"'{job}' omits required input '{k}'")

            # --- WD: workdir is a real path in this repo -------------------
            # This used to demand '.' or 'client' and nothing else, matching an
            # allowlist the six shared jobs enforced at runtime. Both sides of
            # that pair were relaxed together in workflows#252: the catalog
            # standardises the toolchain, not the tree, and a repo whose layout
            # did not fit could not call a catalog job at all -- and so got no
            # version standardisation either.
            #
            # What replaces it is the check the allowlist was standing in for.
            # A workdir is wrong when it does not point at a pnpm project, and
            # the tree is right here, so say so HERE rather than let the job
            # discover it on a runner six steps in. Relative, inside the repo,
            # and holding a package.json.
            if re.search(r"/job-(build|bundle|lint|test-unit|typecheck)-", uses) or "job-image-docker" in uses:
                m = re.search(r"^      workdir:\s*(\S+)\s*$", props.get("__with_raw__", ""), re.M)
                if m:
                    wd = m.group(1).strip("\"'")
                    if not wd:
                        bad("WD", f"'{job}' passes an empty workdir — use '.' for the repo root")
                    elif wd.startswith("/") or ".." in pathlib.PurePosixPath(wd).parts:
                        bad("WD", f"'{job}' passes workdir: {wd} — it must be relative to "
                                  "the repo root and must not escape it")
                    elif not (repo / wd / "package.json").is_file():
                        bad("WD", f"'{job}' passes workdir: {wd}, which holds no "
                                  "package.json — the input names the directory holding "
                                  "package.json and .node-version")

            # --- D8: needs.<id> expressions resolve ------------------------
            # A rename moves job ids and needs: lists; ${{ needs.X.outputs.Y }}
            # is easy to miss, and GitHub does not fail on it — the expression
            # just evaluates to empty, so a version tag becomes "v" and nobody
            # notices until the artifact is wrong.
            for ref in sorted(set(re.findall(r"needs\.([\w-]+)\.", blob))):
                if ref not in jobs:
                    bad("D8", f"'{job}' reads needs.{ref}.* but no job '{ref}' exists")
                elif ref not in graph[job]:
                    bad("D8", f"'{job}' reads needs.{ref}.* but does not list '{ref}' in needs:")

            # --- RN: a rename that rewrote a command ------------------------
            # Renaming job ids go-build -> server-go-build with a whole-word
            # regex also rewrites `go build` to `go server-go-build`. It is not
            # a subcommand, so the step dies instantly. This already happened
            # twice: ./tools/checks/go-mod -> ./tools/checks/server-go-mod in
            # three files, and this one, which sat red for three hours.
            for m in re.finditer(
                r"\b(go|pnpm|npm|npx|composer|make|docker|cargo|dotnet)\s+"
                r"((?:server|client|lib|shared|firmware)-(?:go|ts|js|php|cpp|py)-[\w-]+)",
                blob):
                bad("RN", f"'{job}' runs `{m.group(1)} {m.group(2)}` — a job id was "
                          f"substituted into a command by a rename")

            # --- CM: CI does not commit to the repo it is testing ----------
            # hiring-tracker stamped version-info.json after the build, then
            # committed and pushed it to main with [skip ci]. Every image
            # therefore carried the previous commit's stamp, and the stamped
            # commit was never built. It had also silently stopped running four
            # merges earlier, so production was told it was four commits older
            # than it was.
            # A tag is not a commit. It changes no tree, cannot re-trigger an
            # `on: push: branches` workflow, and Principle 14 says in as many
            # words that "CI may create a tag afterwards as a human index".
            # This rule is about commits — hiring-tracker stamping a version
            # onto main and rebuilding itself — so it now matches what it says
            # rather than every use of the verb.
            for m in re.finditer(r"^\s*git push\b(?P<args>[^\n]*)", blob, re.M):
                args = m.group("args")
                if re.search(r"(^|\s)(--tags\b|(\S+\s+)?(refs/tags/|[\"']?v?\$\{?\w*[Tt]ag)"
                             r"|\S+\s+\$\{?\{?\s*(env\.)?\w*[Tt]ag)", args):
                    continue
                bad("CM", f"'{job}' runs `git push{args.rstrip()}` — CI must not commit "
                          "to the repository it is testing; emit generated files into "
                          "the build output instead. (Pushing a tag is allowed — "
                          "Principle 14.)")

            # --- D7: an image nothing runs ---------------------------------
            # Under the three-way split the build job never starts anything, so
            # the question is not "did it assert" but "is anything downstream of
            # it". A staged digest nothing pulls is an image nobody ran.
            if "job-image-build" in uses:
                consumers = sorted(j for j, n in graph.items()
                                   if job in n and j != "ci-ok")
                if not consumers:
                    bad("D7", f"'{job}' stages an image but no job needs it — "
                              "nothing in this pipeline runs or publishes it")

            if "job-image-docker" in uses or "job-docker-image" in uses or "job-image-starts" in uses:
                raw = props.get("__with_raw__", "")
                waived = re.search(r"^      assert_starts:\s*false\s*$", raw, re.M)
                # start_blocked_by is the other way to satisfy D7, and it earns it
                # by naming the blocker rather than asserting an exemption. An
                # empty or whitespace-only reason is not a waiver — that would be
                # a boolean wearing a string's clothes.
                blocked = re.search(r"^      start_blocked_by:\s*(.+?)\s*$", raw, re.M)
                reason = ""
                if blocked:
                    reason = blocked.group(1).strip().strip("\"'")
                    if reason in ("|", ">", "|-", ">-"):
                        # block scalar: the reason is on the following lines
                        tail = raw[blocked.end():]
                        reason = " ".join(l.strip() for l in tail.split("\n")
                                          if l.startswith("        ") and l.strip())
                if blocked and not reason:
                    bad("D7", f"'{job}' sets start_blocked_by with no reason — the input "
                              "exists to name the blocker, and an empty one waives "
                              "the check while explaining nothing")
                elif waived and not blocked and "job-image-starts" not in uses:
                    consumers = sorted(j for j, n in graph.items()
                                       if job in n and j != "ci-ok")
                    if not consumers:
                        bad("D7", f"'{job}' sets assert_starts: false but no job needs it — "
                                  "nothing in this pipeline runs the image")

            for callee, needed in CALLEE_NEEDS.items():
                if f"/{callee}.yml@" not in uses:
                    continue
                # A job-level block REPLACES the workflow default rather than
                # adding to it, so naming any scope zeroes every unnamed one.
                job_perms = re.findall(r"([\w-]+):\s*(read|write|none)", props.get("permissions", ""))
                # Three cases, and only two of them are provable from the file.
                # With no block at either level the grant is the REPOSITORY
                # default, which this file cannot show — so do not claim a
                # startup failure that may not happen. Reported, but for what it
                # actually is: an implicit grant that an org-wide flip to
                # read-only would revoke from every caller at once, as a
                # startup_failure with no logs.
                declared = bool(job_perms) or bool(wf_perms)
                effective = dict(job_perms) if job_perms else wf_perms
                for scope, level in needed.items():
                    if not declared:
                        bad(
                            "PERM",
                            f"'{job}' calls {callee} which requests {scope}: {level}, "
                            f"but grants nothing at job or workflow level — it runs "
                            f"on the repository default token permissions. Declare "
                            f"{scope}: {level} on the job so the grant survives a "
                            f"change to that default",
                        )
                        continue
                    have = effective.get(scope, "none")
                    if PERM_RANK.get(have, 0) < PERM_RANK[level]:
                        bad(
                            "PERM",
                            f"'{job}' calls {callee} which requests {scope}: {level}, "
                            f"but its effective grant is {scope}: {have} — GitHub "
                            "rejects the whole file at startup, with zero jobs and "
                            "no logs",
                        )

            # D3, D4 and D5 reach exactly the jobs the catalog calls a publish.
            #
            # The prune is one of them and still answers to none of the three,
            # because it sits downstream of the rollup — it deletes rather than
            # emits, so D4 is wrong for it by design, and D5 is too: D5 exists
            # so a publish path is rehearsed on pull requests instead of first
            # attempted on main, and running a prune on a pull request would
            # delete things while that pull request is still open. That is the
            # `ci-ok in ancestors` test below, which is placement rather than a
            # name.
            #
            # What used to select the set was PUBLISH_RE — `publish|release|
            # package|image` against the job id — with two regexes subtracted
            # from it for the ids it caught wrongly, and then a repo-keyed
            # waiver list for the ones neither regex could express. It read a
            # PHP repo's `package`, which lays a vendor tree and a React bundle
            # into a dist directory, as a publish and demanded gates that repo
            # had deliberately moved to image-build.
            #
            # None of that is needed once the job says what it is. A job with no
            # role calls no catalog workflow, so it is repo-specific and the
            # standard has nothing to say about it; a toolchain image is not a
            # product, so D3's premise never reaches it; and there is no list to
            # keep current, which matters because the last one had four stale
            # entries out of thirteen.
            if (
                roles.get(job) == "publish"
                and "ci-ok" not in ancestors(job, graph)
            ):
                reach = ancestors(job, graph)
                if not any(roles.get(a) == "gate" for a in reach):
                    # No gate in reach. Before failing, ask what a gate could
                    # have tested: if every image build in this chain (the job
                    # itself included) is a job-image-build caller passing no
                    # artifacts:, the image carries no repo-built code and D3's
                    # premise — artifact provenance — is absent. D4 and D5 are
                    # NOT waived with it: the chain still answers to ci-ok and
                    # still must not be gated to main at the job level.
                    image_builds = {
                        a
                        for a in (reach | {job})
                        if "job-image-build.y" in jobs.get(a, {}).get("uses", "")
                    }
                    if not (image_builds and image_builds <= sourceless_image_builds(text)):
                        bad("D3", f"'{job}' publishes but reaches no gate")
                if "ci-ok" in jobs and job not in rollup:
                    bad("D4", f"'{job}' publishes but is not in ci-ok's needs — it fails invisibly")
                if MAIN_GATE_RE.search(props.get("if", "")):
                    bad(
                        "D5",
                        f"'{job}' is gated to main at the JOB level, so it never runs on a pull "
                        "request and its first execution is the push that has to work; put the "
                        "condition on the publishing step instead (Principle 17)",
                    )

    # --- P4: runner line --------------------------------------------------
    # A literal runner is allowed, but the decision has to be written down: an
    # undeclared literal is drift, a declared one is a decision. Declare it per
    # job in the comment above, or once in the file header when the whole
    # pipeline is hosted for one reason (gha-runner-controller cannot build its
    # own runner on its own runner).
    lines = text.splitlines()
    header_end = next((i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:"), 0)
    declared_file_wide = "Principle 4" in "\n".join(lines[:header_end])
    for i, ln in enumerate(lines):
        m = re.match(r"\s*runs-on:\s*(.+)$", ln)
        if not m or "vars.RUNNER" in m.group(1):
            continue
        context = "\n".join(lines[max(0, i - 6) : i])
        if not declared_file_wide and "Principle 4" not in context:
            bad(
                "P4",
                f"runs-on: {m.group(1).strip()} bypasses vars.RUNNER with no "
                "'Principle 4' note above it explaining why",
            )

    # --- P3: fail closed --------------------------------------------------
    for m in re.finditer(r"continue-on-error:\s*(.+)$", text, re.M):
        v = m.group(1).strip()
        # inputs.warn_only is the sanctioned escape hatch: a shared job whose
        # caller opted a specific linter into warn-only while it is adopted.
        if "inputs.warn_only" not in v:
            bad("P3", f"continue-on-error: {v} — nothing publishes unless every gate passes")

    return out, str(ci.relative_to(repo))


def job_block(text: str, job: str) -> str:
    """The raw lines of one job, from the original file.

    parse_jobs folds continuation lines into per-key strings, which is enough
    for `needs:` and `uses:` but loses step bodies — where ${{ needs.X.* }}
    expressions actually live.
    """
    m = re.search(rf"^  {re.escape(job)}:\s*$", text, re.M)
    if not m:
        return ""
    out = []
    for ln in text[m.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("    "):
            break
        out.append(ln)
    return "\n".join(out)


def with_block(text: str, job: str) -> str:
    """The raw lines under a job's `with:`, read from the original file.

    parse_jobs folds continuation lines into a single string (comments
    included), so anything that needs to tell an input name from a word in a
    comment has to re-read the block here.
    """
    m = re.search(rf"^  {re.escape(job)}:\s*$", text, re.M)
    if not m:
        return ""
    body = []
    for ln in text[m.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("    "):
            break
        body.append(ln)
    block = "\n".join(body)
    w = re.search(r"^    with:\s*$", block, re.M)
    if not w:
        return ""
    out = []
    for ln in block[w.end():].splitlines()[1:]:
        if ln.strip() and not ln.startswith("      "):
            break
        out.append(ln)
    return "\n".join(out)


def with_keys(text: str, job: str) -> set[str]:
    """Input names a job passes under `with:`."""
    return set(re.findall(r"^      ([\w-]+):", with_block(text, job), re.M))


CATALOG_OWNER = "aurum-alpha"


def catalog_roots(repo_name: str):
    """Where to look for the catalog, most authoritative first.

    AURUM_CATALOG_ROOT wins when set. A caller's conformance run takes its
    CHECKERS from a pinned standard_ref, which is right — a pinned workflow
    should get pinned rules. It used to take the CATALOG LISTING from that same
    clone, which is not: "does job-go-build.yml exist" is a question about the
    catalog as it is now, and the pinned clone is by construction at least one
    commit behind. job-go-build.yml landed in #97 and gofast — the first repo
    to call it — was told it does not exist, by a checker reading a tree from
    before it was added. That default can never name the commit that sets it,
    so the lag is permanent and the listing has to come from somewhere else.
    """
    roots = []
    override = os.environ.get("AURUM_CATALOG_ROOT")
    if override:
        roots.append(pathlib.Path(override))
    here = pathlib.Path(__file__).resolve().parent.parent
    roots.append(here)
    roots.extend(q / repo_name for q in (here.parent, pathlib.Path.cwd().parent))
    return roots


def catalog_dir(repo_name: str):
    """The local catalog clone's workflows dir, or None if there is no clone.

    Split out from catalog_inputs so a MISSING FILE can be told apart from a
    MISSING CATALOG. Conflating them is what let job-go-gofmt.yml through: the
    file had been renamed to job-go-fmt.yml, catalog_inputs returned None, and
    rule IN went quiet exactly as it does when the catalog is simply not on
    disk. A silent rule and a satisfied rule looked identical.
    """
    for root in catalog_roots(repo_name):
        d = root / ".github/workflows"
        if d.is_dir() and any(d.glob("job-*.yml")):
            return d
    return None


def catalog_inputs(uses: str):
    """(declared, required) input names for a shared job, or None if unresolvable.

    Resolves `aurum-alpha/workflows/.github/workflows/X.yml@sha` against a local
    clone of the catalog, searched next to this checker and beside the repo
    being checked. The pin is a sha, so a local clone may not hold that exact
    commit — this compares against whatever the working tree has, which catches
    the misspelling and the missing-required case without pretending to verify
    the pinned revision. Parsed with regex like the rest of this file, so the
    checker keeps running on a bare Python with no yaml installed.
    """
    m = re.match(r"([\w.-]+)/([\w.-]+)/\.github/workflows/([\w.-]+\.ya?ml)@", uses.strip())
    if not m or m.group(1) != CATALOG_OWNER:
        # Not ours: there is no clone of a third party's repo to resolve the
        # schema against, and the AURUM_CATALOG_ROOT override would otherwise
        # answer with our catalog's files. Returning None keeps rule IN
        # visibly absent rather than answering from the wrong tree.
        return None
    _, repo_name, fname = m.groups()
    for root in catalog_roots(repo_name):
        f = root / ".github/workflows" / fname
        if not f.is_file():
            continue
        text = f.read_text()
        block = re.search(
            r"^  workflow_call:\n(?:.*\n)*?^    inputs:\n((?:^      \S.*\n|^        .*\n|^\s*\n)*)",
            text, re.M)
        if not block:
            return set(), set()
        body = block.group(1)
        declared, required = set(), set()
        current = None
        for line in body.splitlines():
            k = re.match(r"^      ([\w-]+):\s*$", line)
            if k:
                current = k.group(1)
                declared.add(current)
            elif current and re.match(r"^        required:\s*true\s*$", line):
                required.add(current)
        return declared, required
    return None


def main() -> int:
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--repo-root", type=pathlib.Path, help="check one repo (default: cwd)")
    # --fleet is the old spelling, kept as an alias so a sweep in someone's
    # shell history does not start failing on a vocabulary change. argparse
    # takes the dest from the first long option, so args.portfolio covers both.
    g.add_argument("--portfolio", "--fleet", type=pathlib.Path,
                   help="check every clone under DIR (--fleet: deprecated alias)")
    args = ap.parse_args()

    if args.portfolio:
        repos = sorted(p for p in args.portfolio.iterdir() if (p / ".github/workflows").is_dir())
    else:
        repos = [args.repo_root or pathlib.Path.cwd()]

    failures = 0
    checked = 0
    for repo in repos:
        repo = repo.resolve()
        problems, ci_path = check(repo)
        if ci_path is None:
            if args.portfolio:
                continue
            print(f"no ci.yml under {repo}/.github/workflows", file=sys.stderr)
            return 2
        checked += 1
        if problems:
            failures += 1
            print(f"{repo.name}/{ci_path}: {len(problems)} violation(s)")
            for p in problems:
                print(f"  {p}")
        else:
            print(f"{repo.name}: conformant")

    if not checked:
        print("no ci workflow found to check", file=sys.stderr)
        return 2
    print(
        f"\n{'PASS' if failures == 0 else f'FAIL: {failures} of {checked} repo(s) violate CI_STANDARD'}"
    )
    return 0 if failures == 0 else 1



# ---------------------------------------------------------------------------
# ADOPT — is a caller's job a call into the catalog, or a body of its own?
#
# Merged in from check-catalog-adoption, a separate 417-line tool asking a
# question this one already had the subject for: conformance asks whether a
# pipeline is the right SHAPE, adoption asks whether its CONTENT is shared or
# bespoke. Two instruments reading one ci.yml is how they came to disagree
# about the prune (G#8) — a split question gives two answers and no way to tell
# which is right.
#
# What did not survive the merge is that tool's CONVERTED/UNCONVERTED pair. It
# swept a directory of clones and needed to enumerate its subjects; here the
# subject is whichever repo invoked the job, so the same list stopped being an
# enumeration and became a filter on who was allowed to be judged. See
# defines_catalog() for the structural test that replaced it.
#
# The parser below is transplanted rather than rewritten, because reconciling
# two parsers in the same change that merges two tools is how a refactor
# becomes an outage.
# ---------------------------------------------------------------------------

# Shared jobs that report rather than gate. A caller may leave these out of
# ci-ok: putting a job that only posts a comment into the rollup would let a
# commenting failure block a merge, which inverts the point of it.
REPORTING_JOBS = {"job-release-risk.yml"}

# `permissions` is a stub key, not drift: a called workflow can never hold more
# than the job calling it, so a stub whose shared job needs a stronger scope
# than the workflow default (an image build wanting packages: write) has to say
# so here. tools/check-caller-permissions verifies the grant actually covers
# what the shared job requests.
STUB_KEYS = {"uses", "needs", "with", "secrets", "if", "permissions"}

# What a stub's `uses:` must look like. The reference half agrees with rule PIN
# — a first-party workflow is taken at `@main`, never pinned — and this pattern
# is why that agreement has to be written twice: ADOPT reads a stub's `uses:`
# through its own parser and would otherwise keep demanding the sha PIN no
# longer wants. The first repository to migrate found exactly that, five
# findings deep, which is the argument for migrating one before eleven.
USES_RE = re.compile(
    r"^aurum-alpha/workflows/\.github/workflows/job-[a-z0-9-]+\.ya?ml@main$"
)

# Approved third-party reusable workflows, by path without the pin.
#
# Principle 12 says one way per capability. It does not say the one way has to
# be ours. Where the upstream project ships and maintains the job itself, the
# catalog's contribution is the DECISION and the PIN, not a wrapper that
# forwards inputs into it — job-osv-scanner was eighty lines of Python, a JSON
# input and a Go toolchain installed in six repos that have no Go, and every
# one of those existed to reach a scan the upstream workflow already performs.
#
# What an entry here costs is that the portfolio can no longer re-pin in one place:
# bumping osv-scanner is now a sweep over the callers rather than an edit here.
# That is the trade, and it is only worth taking where the upstream is a better
# maintainer of the job than we are. Hence a named table and not a pattern —
# every entry is a judgement about one project, made once, in the open.
# Empty, and that is the point. The one entry this ever held —
# google/osv-scanner-action's osv-scanner-reusable.yml — came out when the last
# direct caller migrated to job-osv-scan.yml. Leaving it would have kept the
# door open for exactly the drift it was written to permit: nine repos ran a
# scan that found real vulnerabilities and discarded them for weeks, and this
# checker passed on every one of those runs, because the call was allow-listed
# and nothing here looks at what the job does with its results.
#
# Kept as an empty set rather than deleted, because the mechanism is still the
# right one. The next upstream project that maintains a job better than we
# would goes here, named, with the judgement written next to it — and the entry
# comes back out the day the catalog wraps it.
EXTERNAL_JOBS: set[str] = set()
EXTERNAL_RE = re.compile(
    r"^(?P<path>[\w.-]+/[\w.-]+/\.github/workflows/[\w.-]+\.ya?ml)"
    r"@[0-9a-f]{40}\s+# v\S+$"
)

CI_PATHS = [".github/workflows/ci.yml", ".github/workflows/ci.yaml"]


def load_ci(root: pathlib.Path, repo: str) -> str | None:
    for rel in CI_PATHS:
        p = root / repo / rel
        if p.is_file():
            return p.read_text()
    return None


def _adopt_parse_jobs(text: str) -> dict[str, dict[str, str]]:
    """Map job id -> {property key: raw value} for 2-space-indented jobs."""
    lines = text.splitlines()
    try:
        jobs_at = next(i for i, ln in enumerate(lines) if re.match(r"^jobs:\s*$", ln))
    except StopIteration:
        return {}
    jobs: dict[str, dict[str, str]] = {}
    current = None
    last_key = None
    for ln in lines[jobs_at + 1 :]:
        if ln.strip() and not ln.startswith("  "):
            break  # dedent out of jobs:
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            current = m.group(1)
            last_key = None
            jobs[current] = {}
            continue
        m = re.match(r"^    ([\w-]+):\s*(.*)$", ln)
        if m and current is not None:
            last_key = m.group(1)
            jobs[current][last_key] = m.group(2).strip()
            continue
        # A key written as a block sequence has its items on following lines:
        #   needs:
        #     - build
        # Fold them back into the key's value so `needs: [build]` and the
        # block form are read the same way.
        m = re.match(r"^      - (.+)$", ln)
        if m and current is not None and last_key is not None:
            existing = jobs[current][last_key]
            jobs[current][last_key] = f"{existing} {m.group(1).strip()}".strip()
            continue
        # A key written as a MULTI-LINE FLOW sequence puts a bare bracket on
        # its own line and the items, comma-separated, under it:
        #   needs:
        #     [
        #       build,
        #       lint,
        #     ]
        # Neither branch above matches any of those lines, so `needs` parsed as
        # the empty string and every stub read as uncovered. event-manager's
        # ci-ok is written this way and names sixteen jobs; this tool reported
        # six of them missing, all sixteen present in the file
        # (aurum-alpha/workflows#112).
        #
        # The failure was loud, which is the survivable direction. The same
        # blindness decides stub_ids, where it is silent: a job whose `uses:`
        # the parser could not see would simply not be required in ci-ok, and
        # nothing would say so.
        m = re.match(r"^ {6}\[?\s*(.*?)\s*\]?,?\s*$", ln)
        if m and current is not None and last_key is not None and ln.strip():
            item = m.group(1).strip().rstrip(",").strip()
            if item:
                existing = jobs[current][last_key]
                jobs[current][last_key] = f"{existing} {item}".strip()
            continue
    return jobs


def adoption_findings(text: str) -> list[str]:
    problems = []
    jobs = _adopt_parse_jobs(text)
    if not jobs:
        return [f"no jobs found in ci workflow"]
    if "ci-ok" not in jobs:
        problems.append("missing local ci-ok rollup job")

    def _needs_of(props):
        raw = props.get("needs", "")
        if not isinstance(raw, str):
            raw = " ".join(str(n) for n in raw)
        return set(re.findall(r"[\w-]+", raw))

    deps = {j: _needs_of(p) for j, p in jobs.items()}

    def rollup_is_upstream(job):
        """Is ci-ok anywhere in this job's needs closure?"""
        seen, stack = set(), list(deps.get(job, ()))
        while stack:
            cur = stack.pop()
            if cur in seen:
                continue
            seen.add(cur)
            if cur == "ci-ok":
                return True
            stack.extend(deps.get(cur, ()))
        return False

    stub_ids = []
    for job_id, props in jobs.items():
        if job_id == "ci-ok":
            if "uses" in props:
                problems.append("ci-ok must be a local job, not a stub")
            continue
        # A job with a body is repo-specific, and a repo-specific job is not
        # this checker's business. The catalog defines a set of capabilities; a
        # job outside that set is one repo's own work, and the standard has
        # nothing to say about what it contains, what it is called, or where it
        # sits. Converting one is a conversation about whether the shape
        # generalises — which is review, not a gate.
        #
        # A named exemption list (LOCAL_ALLOWLIST) used to carry this, thirteen
        # job ids across four repos, each with a paragraph arguing the catalog
        # did not cover that case. Nothing verified the argument, so an entry
        # could name a job that had since become a stub, or a job that no
        # longer existed at all: four of the thirteen had, and each of those
        # was a standing permission for a local body nobody would be told
        # about.
        #
        # What is NOT yet checked, and is the other half of this rule: a job id
        # that DOES name a catalog capability must be a stub calling it. That
        # needs each catalog job to declare its capability, so it lands with
        # those declarations rather than with a correspondence table here.
        if "uses" not in props:
            continue
        # Housekeeping is outside the rollup BY PLACEMENT, not by name. A job
        # the rollup is upstream of cannot be in ci-ok's needs — that would be
        # a cycle — and it cannot run before the gates pass either, which is
        # the whole claim the exemption rests on.
        #
        # This WAS a name list (OUTSIDE_ROLLUP), naming job-image-prune alone.
        # Rule D6 above had already written down why that is wrong, and in its
        # own words: "A name-based exemption said the same thing for one job
        # while quietly leaving the next one to be discovered by failing."
        #
        # The next one was job-version-release, and it was discovered exactly
        # that way — by the first repo trying to adopt it being told its
        # release stub must appear in ci-ok's needs, which is impossible for a
        # job ci-ok is upstream of. So the structural test D6 already uses is
        # the test here too, and there is no second list to forget.
        reporting = any(f"/{name}@" in props["uses"] for name in REPORTING_JOBS)
        if not reporting and not rollup_is_upstream(job_id):
            stub_ids.append(job_id)
        extra = set(props) - STUB_KEYS
        if extra:
            problems.append(f"job '{job_id}' carries non-stub keys: {', '.join(sorted(extra))}")
        external = False
        if not USES_RE.match(props["uses"]):
            m = EXTERNAL_RE.match(props["uses"])
            external = bool(m) and m.group("path") in EXTERNAL_JOBS
            if not external:
                problems.append(
                    f"job '{job_id}' uses '{props['uses']}' — must be a shared job "
                    "workflow at @main, or an approved third-party workflow pinned "
                    "to a 40-hex SHA with a version comment"
                )
        # `secrets: inherit` hands the caller's whole secret set to the called
        # workflow. Into the catalog that is fine and required — it is this
        # organisation's own code. Into a third party it is a standing grant of
        # every token the repo holds to whoever can land a commit upstream, for
        # a job that needs none of them, so it is refused rather than left to
        # each caller to get right.
        if external:
            if "secrets" in props:
                problems.append(
                    f"job '{job_id}' passes secrets to a third-party workflow — "
                    "an approved external job runs on the repo's contents, not "
                    "its credentials"
                )
        elif props.get("secrets", "inherit") != "inherit":
            problems.append(f"job '{job_id}' must use secrets: inherit")

    if "ci-ok" in jobs and stub_ids:
        # needs: accepts a scalar, an inline list, or a block sequence; the
        # parser hands back a str or a list depending on which was written.
        needs_raw = jobs["ci-ok"].get("needs", "")
        if not isinstance(needs_raw, str):
            needs_raw = " ".join(str(n) for n in needs_raw)
        needed = set(re.findall(r"[\w-]+", needs_raw))
        missing = [j for j in stub_ids if j not in needed]
        if missing:
            problems.append(f"ci-ok needs: does not cover: {', '.join(missing)}")
    return problems

if __name__ == "__main__":
    sys.exit(main())


