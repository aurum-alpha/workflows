#!/usr/bin/env python3
"""Byte-identity checker for canonical CI job blocks (Phase B exit gate).

Within each package-manager cohort, every canonical job id that exists in
two or more repos must have a byte-identical YAML block (normalized only
for indentation context). Prints a per-cohort, per-job verdict and a
unified diff against the cohort's template repo on mismatch.

Usage: check-job-identity [--root DIR]
  DIR contains one clone per repo (default: /workspace).
Exit: 0 if all shared job blocks are identical, 1 otherwise.
"""

import argparse
import difflib
import pathlib
import re
import sys

# Cohort -> template repo first, then the repos expected to converge on it.
COHORTS = {
    "npm": ["wardley-mapper", "credit-watch", "expense-splitter", "flight-watch"],
    "pnpm": ["hiring-tracker", "jewelry-factory"],
}

CANONICAL_IDS = ["install", "build", "lint", "typecheck", "test-unit", "image", "ci-ok"]

CI_PATHS = [".github/workflows/ci.yml", ".github/workflows/ci.yaml"]


def load_ci(root: pathlib.Path, repo: str) -> str | None:
    for rel in CI_PATHS:
        p = root / repo / rel
        if p.is_file():
            return p.read_text()
    return None


def extract_job(text: str, job_id: str) -> str | None:
    """Return the YAML block for a top-level job id (2-space indented under jobs:)."""
    lines = text.splitlines()
    try:
        start = next(
            i for i, ln in enumerate(lines) if re.match(rf"^  {re.escape(job_id)}:\s*$", ln)
        )
    except StopIteration:
        return None
    block = [lines[start]]
    for ln in lines[start + 1 :]:
        # Job ends at the next 2-space-indented key or a dedent to column 0.
        if ln.strip() and not ln.startswith("    ") and not ln.startswith("  #"):
            break
        block.append(ln)
    # Trim trailing blank/comment-only lines so cosmetic spacing can't fail the gate.
    while block and not block[-1].strip():
        block.pop()
    return "\n".join(block) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    args = ap.parse_args()

    failures = 0
    for cohort, repos in COHORTS.items():
        texts = {}
        for repo in repos:
            text = load_ci(args.root, repo)
            if text is None:
                print(f"[{cohort}] {repo}: ci workflow not found under {args.root}", file=sys.stderr)
                return 2
            texts[repo] = text

        template = repos[0]
        print(f"\n=== cohort {cohort} (template: {template}) ===")
        for job_id in CANONICAL_IDS:
            blocks = {r: extract_job(t, job_id) for r, t in texts.items()}
            present = {r: b for r, b in blocks.items() if b is not None}
            if len(present) < 2:
                holders = ", ".join(present) or "none"
                print(f"  {job_id:10s}  n/a (present in: {holders})")
                continue
            ref_repo = template if template in present else sorted(present)[0]
            ref = present[ref_repo]
            bad = [r for r, b in present.items() if b != ref]
            if not bad:
                print(f"  {job_id:10s}  IDENTICAL across {len(present)} repos")
            else:
                failures += len(bad)
                print(f"  {job_id:10s}  DIFFERS in: {', '.join(bad)} (vs {ref_repo})")
                for r in bad:
                    diff = difflib.unified_diff(
                        ref.splitlines(keepends=True),
                        present[r].splitlines(keepends=True),
                        fromfile=f"{ref_repo}:{job_id}",
                        tofile=f"{r}:{job_id}",
                    )
                    sys.stdout.writelines(diff)

    print(f"\n{'PASS: all shared canonical job blocks byte-identical' if failures == 0 else f'FAIL: {failures} non-identical job block(s)'}")
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
