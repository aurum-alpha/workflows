    { "id": "publicid-accepts-prefixed", "def": "publicId", "value": "ord_8fK2mQ7xW3pLzR", "valid": true },
    { "id": "publicid-rejects-integer-string", "def": "publicId", "value": "1048576", "valid": false, "note": "a sequential integer is not a public id (IP1)" },
    { "id": "timestamp-ok", "def": "timestamp", "value": "2026-08-31T14:07:02.417Z", "valid": true },
