    { "id": "ts-truncate-micros", "kind": "timestamp", "input": "2026-08-31T14:07:02.417933Z", "emit": "2026-08-31T14:07:02.417Z", "note": "precision below the pin is truncated, not rounded; the canonical cases test the default 3-digit profile (IP4)" },
    { "id": "ts-negative-offset", "kind": "timestamp", "input": "2026-08-31T07:07:02.417-07:00", "emit": "2026-08-31T14:07:02.417Z" },
    { "id": "ts-offset-crosses-midnight", "kind": "timestamp", "input": "2026-09-01T01:30:00.000+11:00", "emit": "2026-08-31T14:30:00.000Z", "note": "normalising to UTC moves the calendar day when the offset crosses midnight (IP4)" },
    { "id": "ts-lowercase-z", "kind": "timestamp", "input": "2026-08-31t14:07:02.417z", "emit": "2026-08-31T14:07:02.417Z", "note": "RFC 3339 permits lowercase t/z on input; the canonical emit is uppercase (IP4)" },
    { "id": "uuid-fold-to-lowercase", "kind": "uuidv7", "input": "01923E8A-7F4E-7CC3-9A2B-3F8D2C1B0A99", "emit": "01923e8a-7f4e-7cc3-9a2b-3f8d2c1b0a99", "note": "parsers may accept uppercase from foreign systems; the wire form emitted is lowercase (IP2, IP3)" }
  ]
}
