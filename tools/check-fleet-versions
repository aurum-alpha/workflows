#!/bin/sh
# Renamed to check-dependency-versions. This is a one-pull-request bridge, not
# a second checker: it forwards every argument and returns the real exit code.
#
# It exists because a caller reads TWO trees. job-ci-conformance.yml comes from
# the tag a repository pins; the checkers that file invokes come from a
# separate clone at standard_ref, which by rule is the base commit of the pull
# request that moved it. So the invocation cannot switch to a new checker path
# in the same pull request that creates that path -- the base predates it, and
# every caller gets exit 127 the moment it re-pins. That shipped twice, in
# v2.2.10 and v2.2.11, and the "Every checker job-ci-conformance invokes
# exists" step in this repository's ci.yml now proves it against both trees.
#
# So the rename lands in two steps. This step moves the implementation and
# leaves the old path answering to it. The follow-up points
# job-ci-conformance.yml at the new path, sets standard_ref to the commit that
# carries it, and deletes this file.
exec "$(dirname "$0")/check-dependency-versions" "$@"
