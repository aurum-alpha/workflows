#!/usr/bin/env python3
"""Verify every caller grants at least what the shared jobs it calls request.

A called workflow can never hold more permission than the job calling it, and
naming ANY scope in a permissions block sets every unnamed scope to none. Get
this wrong and GitHub rejects the whole workflow file before running a single
job — a `startup_failure` with zero jobs and no log to read. actionlint cannot
catch it because it does not resolve remote reusable workflows.

Worse, a repo with NO permissions block passes today only because the default
token grant happens to be permissive. Tighten that default and every such repo
breaks at once. This check treats a missing block as a finding for exactly that
reason.

Run against local clones:  tools/check-caller-permissions --root /workspace
"""

import argparse
import os
import pathlib
import re
import sys

import yaml

# Ordered weakest to strongest; a caller must hold at least what it passes down.
RANK = {"none": 0, "read": 1, "write": 2}

SHARED_RE = re.compile(
    r"^aurum-alpha/workflows/\.github/workflows/(?P<file>job-[a-z0-9-]+\.ya?ml)@"
)

# Any reusable workflow that is not ours.
REUSABLE_RE = re.compile(
    r"^(?P<path>[\w.-]+/[\w.-]+/\.github/workflows/[\w.-]+\.ya?ml)@"
)

# What each approved third-party reusable workflow requests, transcribed from
# its `permissions:` block at the pinned tag.
#
# Transcribed, not resolved: shared_job_permissions() reads the catalog off
# disk, and there is no clone of an upstream repo to read. That makes this a
# copy that can go stale — so it is checked against the upstream file when the
# pin moves, which is the same moment the callers are swept anyway.
#
# The alternative was to leave a third-party call unexamined, and that is the
# worse failure: getting a caller's permissions wrong is a `startup_failure`
# with zero jobs and no log, and the checker written to catch exactly that
# would have skipped straight past it for want of a pattern match.
#
# Empty, and that is the point. Its one entry described
# google/osv-scanner-action's osv-scanner-reusable.yml, and came out when the
# last direct caller migrated to job-osv-scan.yml. The permissions themselves
# did not go anywhere: they are declared on both jobs inside that catalog file,
# where shared_job_permissions() reads them off disk rather than from a
# transcription that can go stale.
#
# Kept as an empty dict rather than deleted, because the mechanism is still the
# right one — see the note above on why a transcription beats leaving a
# third-party call unexamined.
EXTERNAL_PERMISSIONS: dict[str, dict[str, str]] = {}


# Scopes ordered least to most privileged, so a union can keep the wider ask.
_RANK = {"none": 0, "read": 1, "write": 2}


def shared_job_permissions(repo_root: pathlib.Path) -> dict[str, dict[str, str]]:
    """What each shared job asks for, keyed by workflow filename.

    The UNION across every job in the file, at the widest scope any of them
    asks for. A caller grants permissions once for the whole `uses:`, so it
    must hold what ANY job in the called workflow might request — GitHub
    resolves that at startup, and a caller short of it fails with zero jobs
    and no log.

    This read one job at a time until job-osv-scan.yml, which has two: a
    pull-request scan and a whole-tree scan, exactly one running per event.
    Every other catalog file has a single job, so `wanted[name]` being
    overwritten per job returned the right answer by having nothing to
    overwrite. It would have gone on being right here too — both jobs ask for
    the same three — which is the problem: the next multi-job file to ask for
    different scopes would have had all but its last job silently ignored,
    and the failure that produces is a startup_failure with nothing to read.
    """
    wanted: dict[str, dict[str, str]] = {}
    for path in sorted((repo_root / ".github" / "workflows").glob("job-*.yml")):
        doc = yaml.safe_load(path.read_text())
        merged: dict[str, str] = {}
        for job in doc.get("jobs", {}).values():
            perms = job.get("permissions") or {}
            if not isinstance(perms, dict):
                continue
            for scope, level in perms.items():
                level = str(level)
                if _RANK.get(level, 0) >= _RANK.get(merged.get(scope, "none"), 0):
                    merged[scope] = level
        if doc.get("jobs"):
            wanted[path.name] = merged
    return wanted


def effective_permissions(doc: dict, job: dict) -> tuple[dict | None, str]:
    """A job's own block wins outright; otherwise the workflow-level block."""
    if isinstance(job.get("permissions"), dict):
        return {k: str(v) for k, v in job["permissions"].items()}, "job"
    top = doc.get("permissions")
    if isinstance(top, dict):
        return {k: str(v) for k, v in top.items()}, "workflow"
    return None, "default"


def check_repo(repo: str, text: str, wanted: dict[str, dict[str, str]]) -> list[str]:
    doc = yaml.safe_load(text)
    problems = []

    for job_id, job in (doc.get("jobs") or {}).items():
        uses = job.get("uses")
        if not isinstance(uses, str):
            continue
        m = SHARED_RE.match(uses)
        if m:
            name = m.group("file")
            needs = wanted.get(name)
            if needs is None:
                problems.append(f"job '{job_id}' calls unknown shared workflow {name}")
                continue
        else:
            ext = REUSABLE_RE.match(uses)
            if not ext:
                continue
            name = ext.group("path")
            needs = EXTERNAL_PERMISSIONS.get(name)
            if needs is None:
                problems.append(
                    f"job '{job_id}' calls third-party workflow {name}, whose "
                    "permissions are not recorded in EXTERNAL_PERMISSIONS — "
                    "unrecorded means unchecked, and an unchecked grant is a "
                    "startup_failure waiting for the day the default narrows"
                )
                continue

        held, source = effective_permissions(doc, job)
        if held is None:
            problems.append(
                f"job '{job_id}' calls {name} (needs "
                f"{', '.join(f'{k}: {v}' for k, v in sorted(needs.items()))}) with no "
                "permissions block anywhere — it passes only while the default token "
                "grant stays permissive"
            )
            continue

        for scope, level in sorted(needs.items()):
            have = held.get(scope, "none")
            if RANK.get(have, 0) < RANK.get(level, 0):
                problems.append(
                    f"job '{job_id}' calls {name} which requests "
                    f"{scope}: {level}, but the {source}-level block grants "
                    f"{scope}: {have} — GitHub will reject this file at startup"
                )
    return problems


def load_ci(root: pathlib.Path, repo: str) -> str | None:
    for name in ("ci.yml", "ci.yaml"):
        path = root / repo / ".github" / "workflows" / name
        if path.exists():
            return path.read_text()
    return None


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    args = ap.parse_args()

    # Same reason as check-ci-conformance's catalog_roots: the permissions map
    # is built from the catalog's own job files, so reading it out of a pinned
    # standard_ref clone reports a newly added shared job as "unknown".
    here = pathlib.Path(os.environ.get("AURUM_CATALOG_ROOT")
                        or pathlib.Path(__file__).resolve().parent.parent)
    wanted = shared_job_permissions(here)

    repos = args.repo or sorted(p.name for p in args.root.iterdir() if p.is_dir())
    failures = 0
    checked = 0
    for repo in repos:
        text = load_ci(args.root, repo)
        if text is None:
            continue
        checked += 1
        problems = check_repo(repo, text, wanted)
        if problems:
            failures += 1
            print(f"{repo}: INSUFFICIENT")
            for p in problems:
                print(f"  - {p}")
        else:
            print(f"{repo}: ok")

    print(
        f"\n{'PASS' if failures == 0 else f'FAIL: {failures}'} "
        f"({checked} repo(s) with a ci workflow checked)"
    )
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
