#!/usr/bin/env python3
"""Verify every caller grants at least what the shared jobs it calls request.

A called workflow can never hold more permission than the job calling it, and
naming ANY scope in a permissions block sets every unnamed scope to none. Get
this wrong and GitHub rejects the whole workflow file before running a single
job — a `startup_failure` with zero jobs and no log to read. actionlint cannot
catch it because it does not resolve remote reusable workflows.

Worse, a repo with NO permissions block passes today only because the default
token grant happens to be permissive. Tighten that default and every such repo
breaks at once. This check treats a missing block as a finding for exactly that
reason.

Run against local clones:  tools/check-caller-permissions --root /workspace
"""

import argparse
import pathlib
import re
import sys

import yaml

# Ordered weakest to strongest; a caller must hold at least what it passes down.
RANK = {"none": 0, "read": 1, "write": 2}

SHARED_RE = re.compile(
    r"^aurum-alpha/workflows/\.github/workflows/(?P<file>job-[a-z0-9-]+\.ya?ml)@"
)


def shared_job_permissions(repo_root: pathlib.Path) -> dict[str, dict[str, str]]:
    """What each shared job asks for, keyed by workflow filename."""
    wanted = {}
    for path in sorted((repo_root / ".github" / "workflows").glob("job-*.yml")):
        doc = yaml.safe_load(path.read_text())
        for job in doc.get("jobs", {}).values():
            perms = job.get("permissions") or {}
            if isinstance(perms, dict):
                wanted[path.name] = {k: str(v) for k, v in perms.items()}
    return wanted


def effective_permissions(doc: dict, job: dict) -> tuple[dict | None, str]:
    """A job's own block wins outright; otherwise the workflow-level block."""
    if isinstance(job.get("permissions"), dict):
        return {k: str(v) for k, v in job["permissions"].items()}, "job"
    top = doc.get("permissions")
    if isinstance(top, dict):
        return {k: str(v) for k, v in top.items()}, "workflow"
    return None, "default"


def check_repo(repo: str, text: str, wanted: dict[str, dict[str, str]]) -> list[str]:
    doc = yaml.safe_load(text)
    problems = []

    for job_id, job in (doc.get("jobs") or {}).items():
        uses = job.get("uses")
        if not isinstance(uses, str):
            continue
        m = SHARED_RE.match(uses)
        if not m:
            continue
        needs = wanted.get(m.group("file"))
        if needs is None:
            problems.append(f"job '{job_id}' calls unknown shared workflow {m.group('file')}")
            continue

        held, source = effective_permissions(doc, job)
        if held is None:
            problems.append(
                f"job '{job_id}' calls {m.group('file')} (needs "
                f"{', '.join(f'{k}: {v}' for k, v in sorted(needs.items()))}) with no "
                "permissions block anywhere — it passes only while the default token "
                "grant stays permissive"
            )
            continue

        for scope, level in sorted(needs.items()):
            have = held.get(scope, "none")
            if RANK.get(have, 0) < RANK.get(level, 0):
                problems.append(
                    f"job '{job_id}' calls {m.group('file')} which requests "
                    f"{scope}: {level}, but the {source}-level block grants "
                    f"{scope}: {have} — GitHub will reject this file at startup"
                )
    return problems


def load_ci(root: pathlib.Path, repo: str) -> str | None:
    for name in ("ci.yml", "ci.yaml"):
        path = root / repo / ".github" / "workflows" / name
        if path.exists():
            return path.read_text()
    return None


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    args = ap.parse_args()

    here = pathlib.Path(__file__).resolve().parent.parent
    wanted = shared_job_permissions(here)

    repos = args.repo or sorted(p.name for p in args.root.iterdir() if p.is_dir())
    failures = 0
    checked = 0
    for repo in repos:
        text = load_ci(args.root, repo)
        if text is None:
            continue
        checked += 1
        problems = check_repo(repo, text, wanted)
        if problems:
            failures += 1
            print(f"{repo}: INSUFFICIENT")
            for p in problems:
                print(f"  - {p}")
        else:
            print(f"{repo}: ok")

    print(
        f"\n{'PASS' if failures == 0 else f'FAIL: {failures}'} "
        f"({checked} repo(s) with a ci workflow checked)"
    )
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
