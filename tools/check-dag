#!/usr/bin/env python3
"""Standard-DAG checker.

CI_STANDARD's "standard job DAG" section says builds come first and gates hang
off them. Nothing enforced it, and four repos had drifted before anyone looked:
lid-firmware published firmware without waiting for its tests, gofast left
web-lint outside the graph entirely, client-manager hung three web gates off
`changes` rather than off the install they need, and event-manager ran
backwards with `web-build` needing `web-test-unit`.

Three mechanical rules, which is all a generic checker can honestly assert:

  1. NO ORPHANS. Every job has `needs:`, except declared roots. A job with no
     needs runs immediately, in parallel with the build it is supposed to gate.
  2. NO INVERSION. A build job never needs a gate job. This is the shape
     event-manager had: the cheapest signal in the stack sitting behind the
     most expensive one.
  3. PUBLISH IS GATED. A job that publishes (name matches publish/release/
     package/image) needs at least one gate, transitively. This is the
     lid-firmware bug — the artifact shipped the moment it linked.

What this deliberately does NOT check is which stack a gate belongs to. That
needs repo knowledge a regex does not have; the per-stack rule is enforced by
review against the doc.

Usage: check-dag [--root DIR] [--repo NAME ...]
Exit: 0 if every DAG is sound, 1 otherwise, 2 on missing clones.
"""

import argparse
import pathlib
import re
import sys

ALL_REPOS = [
    "client-manager",
    "credit-watch",
    "event-manager",
    "expense-splitter",
    "flight-watch",
    "gha-runner-controller",
    "gofast",
    "hiring-tracker",
    "jewelry-factory",
    "lid-firmware",
    "wardley-mapper",
]

# Legitimate graph roots: the first node of a stack, or the change-detection
# job every other job keys off. Anything else without needs: is an orphan.
ROOT_RE = re.compile(
    r"^(changes|build|go-mod|install|web-build|web-install|php-install(-prod)?"
    r"|create-docker-[\w-]+-image)$"
)

BUILD_RE = re.compile(r"(^|-)(build|install)$")
GATE_RE = re.compile(r"(lint|typecheck|test|vet|gofmt|prettier|analysis|scanner|check|audit)")
PUBLISH_RE = re.compile(r"(publish|release|package|image)")

# Reports rather than gates; exempt from the publish-is-gated rule and never
# counted as a gate itself.
REPORTING_RE = re.compile(r"risk$")

# Jobs whose names trip PUBLISH_RE without producing a product artifact.
# Ungated is correct for each, for a different reason:
#   *-parity        asserts pins match across files; it is a gate, not a build
#   create-*-image  the CI toolchain image every other job runs inside, so it
#                   is by construction upstream of every gate
#   runner-image    a base image plus packages, sharing no source with the
#                   repo's code — there is nothing in the codebase to gate it on
NOT_A_PRODUCT_RE = re.compile(r"parity$|^create-docker-[\w-]+-image$|^runner-image$")

CI_PATHS = [".github/workflows/ci.yml", ".github/workflows/ci.yaml"]


def load_ci(root: pathlib.Path, repo: str) -> str | None:
    for rel in CI_PATHS:
        p = root / repo / rel
        if p.is_file():
            return p.read_text()
    return None


def parse_needs(text: str) -> dict[str, set[str]]:
    """Map job id -> set of needs, across scalar, inline-list and block forms."""
    lines = text.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.rstrip() == "jobs:")
    except StopIteration:
        return {}
    jobs: dict[str, set[str]] = {}
    cur = None
    in_needs = False
    raw = ""
    for ln in lines[start + 1 :]:
        if ln.strip() and not ln.startswith("  "):
            break
        m = re.match(r"^  ([\w-]+):\s*$", ln)
        if m:
            if cur is not None:
                jobs[cur] = set(re.findall(r"[\w-]+", raw))
            cur, in_needs, raw = m.group(1), False, ""
            continue
        m = re.match(r"^    ([\w-]+):\s*(.*)$", ln)
        if m and cur is not None:
            in_needs = m.group(1) == "needs"
            if in_needs:
                raw = m.group(2)
            continue
        # Continuation of a block sequence or a wrapped flow sequence.
        if cur is not None and in_needs and ln.startswith("      "):
            raw += " " + ln.strip().lstrip("- ")
    if cur is not None:
        jobs[cur] = set(re.findall(r"[\w-]+", raw))
    return jobs


def ancestors(job: str, jobs: dict[str, set[str]]) -> set[str]:
    seen: set[str] = set()
    stack = list(jobs.get(job, ()))
    while stack:
        n = stack.pop()
        if n in seen or n not in jobs:
            continue
        seen.add(n)
        stack.extend(jobs[n])
    return seen


def check_repo(jobs: dict[str, set[str]]) -> list[str]:
    problems = []
    if not jobs:
        return ["no jobs found in ci workflow"]

    for job, needs in sorted(jobs.items()):
        if job == "ci-ok":
            continue

        if not needs and not ROOT_RE.match(job):
            problems.append(
                f"'{job}' has no needs: — it runs immediately, in parallel with "
                "the build it should gate"
            )

        if BUILD_RE.search(job):
            inverted = sorted(
                n for n in needs if GATE_RE.search(n) and not BUILD_RE.search(n)
            )
            if inverted:
                problems.append(
                    f"'{job}' is a build but needs gate(s): {', '.join(inverted)} — "
                    "build comes first, gates hang off it"
                )

        if (
            PUBLISH_RE.search(job)
            and not REPORTING_RE.search(job)
            and not NOT_A_PRODUCT_RE.search(job)
        ):
            reach = ancestors(job, jobs)
            if not any(
                GATE_RE.search(a) and not BUILD_RE.search(a) and not REPORTING_RE.search(a)
                for a in reach
            ):
                problems.append(
                    f"'{job}' publishes but reaches no gate — it ships whatever "
                    "builds, passing tests or not"
                )
    return problems


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default="/workspace", type=pathlib.Path)
    ap.add_argument("--repo", action="append", help="limit to specific repo(s)")
    args = ap.parse_args()

    failures = 0
    for repo in args.repo or ALL_REPOS:
        text = load_ci(args.root, repo)
        if text is None:
            print(f"{repo}: ci workflow not found under {args.root}", file=sys.stderr)
            return 2
        problems = check_repo(parse_needs(text))
        if problems:
            failures += 1
            print(f"{repo}: BROKEN DAG")
            for p in problems:
                print(f"  - {p}")
        else:
            print(f"{repo}: ok")

    print(
        "\n"
        + (
            "PASS: every DAG builds first and gates before it ships"
            if failures == 0
            else f"FAIL: {failures} repo(s) with a broken DAG"
        )
    )
    return 0 if failures == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
